  "html": {
    "document": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>New York to Lisbon flights</title>\n<style>\n  * { box-sizing: border-box; }\n  body { margin: 0; padding: 16px 16px 90px; font: 14px/1.45 system-ui, -apple-system, \"Segoe UI\", sans-serif; color: #0f172a; background: #f1f5f9; }\n  h1 { font-size: 18px; margin: 0; }\n  .sub { color: #64748b; font-size: 12px; margin: 0 0 12px; }\n  .filters { background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 12px; margin-bottom: 12px; }\n  .f { margin-bottom: 10px; }\n  .f:last-child { margin-bottom: 0; }\n  .f > span { display: flex; justify-content: space-between; font-size: 12px; font-weight: 600; color: #475569; margin-bottom: 4px; }\n  .f output { color: #0369a1; }\n  input[type=range] { width: 100%; accent-color: #0369a1; }\n  .chips { display: flex; flex-wrap: wrap; gap: 6px; }\n  .chip { border: 1px solid #cbd5e1; background: #fff; border-radius: 999px; padding: 4px 11px; font: inherit; font-size: 12px; cursor: pointer; color: inherit; }\n  .chip.on { background: #0369a1; border-color: #0369a1; color: #fff; }\n  .bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; font-size: 12px; color: #475569; }\n  select { font: inherit; font-size: 12px; padding: 3px 6px; border-radius: 6px; border: 1px solid #cbd5e1; background: #fff; }\n  .flight { display: grid; grid-template-columns: 1fr auto; gap: 4px 10px; align-items: center; background: #fff; border: 2px solid #e2e8f0; border-radius: 12px; padding: 10px 12px; margin-bottom: 8px; }\n  .flight.sel { border-color: #0369a1; background: #f0f9ff; }\n  .flight b { font-size: 15px; }\n  .flight .time { font-size: 20px; font-weight: 700; font-variant-numeric: tabular-nums; }\n  .flight .meta { color: #64748b; font-size: 12px; }\n  .tag { display: inline-block; font-size: 10px; font-weight: 700; border-radius: 4px; padding: 0 5px; margin-left: 4px; text-transform: uppercase; }\n  .tag.ns { background: #dcfce7; color: #166534; } .tag.st { background: #fef3c7; color: #92400e; } .tag.best { background: #0369a1; color: #fff; }\n  .price { text-align: right; font-size: 18px; font-weight: 700; }\n  .flight button { grid-column: 2; border: 0; background: #0f172a; color: #fff; border-radius: 8px; padding: 5px 12px; font: inherit; font-size: 12px; cursor: pointer; }\n  .flight.sel button { background: #0369a1; }\n  .empty { text-align: center; color: #64748b; padding: 24px 8px; background: #fff; border: 1px dashed #cbd5e1; border-radius: 12px; }\n  .empty button { border: 0; background: none; color: #0369a1; text-decoration: underline; cursor: pointer; font: inherit; }\n  .tray { position: fixed; left: 0; right: 0; bottom: 0; background: #0f172a; color: #fff; padding: 10px 16px; font-size: 13px; }\n  .tray small { display: block; color: #94a3b8; font-size: 11px; }\n</style>\n</head>\n<body>\n  <h1>New York → Lisbon</h1>\n  <p class=\"sub\">6 flights. Filters apply as you change them.</p>\n\n  <div class=\"filters\">\n    <div class=\"f\"><span>Max price <output id=\"priceOut\"></output></span><input id=\"price\" type=\"range\" min=\"450\" max=\"750\" step=\"10\" value=\"750\"></div>\n    <div class=\"f\"><span>Stops</span><div class=\"chips\" id=\"stops\"><button class=\"chip on\" data-stops=\"any\">Any</button><button class=\"chip\" data-stops=\"0\">Nonstop only</button><button class=\"chip\" data-stops=\"1\">1 stop only</button></div></div>\n    <div class=\"f\"><span>Airlines</span><div class=\"chips\" id=\"airlines\"></div></div>\n  </div>\n\n  <div class=\"bar\"><span id=\"count\"></span><label>Sort <select id=\"sort\"><option value=\"price\">Price</option><option value=\"time\">Departure</option></select></label></div>\n  <div id=\"list\"></div>\n\n  <div class=\"tray\"><span id=\"tray\">No flight selected yet.</span><small>Selections stay on this page: a sandboxed page cannot send them anywhere.</small></div>\n\n<script>\n(function () {\n  var flights = [\n    { code: 'TP202', airline: 'TAP', stops: 0, time: '18:30', price: 640 },\n    { code: 'UA64', airline: 'United', stops: 0, time: '20:15', price: 710 },\n    { code: 'DL272', airline: 'Delta', stops: 1, time: '16:05', price: 520 },\n    { code: 'IB6252', airline: 'Iberia', stops: 1, time: '21:40', price: 480 },\n    { code: 'AF11', airline: 'Air France', stops: 1, time: '19:00', price: 560 },\n    { code: 'TP210', airline: 'TAP', stops: 0, time: '22:55', price: 590 }\n  ];\n  var airlines = ['TAP', 'United', 'Delta', 'Iberia', 'Air France'];\n  var state = { stops: 'any', airlines: {}, selected: null };\n  airlines.forEach(function (a) { state.airlines[a] = true; });\n  var $ = function (id) { return document.getElementById(id); };\n\n  airlines.forEach(function (a) {\n    var b = document.createElement('button');\n    b.type = 'button';\n    b.className = 'chip on';\n    b.textContent = a;\n    b.setAttribute('data-airline', a);\n    $('airlines').appendChild(b);\n  });\n\n  function el(tag, cls, text) {\n    var n = document.createElement(tag);\n    if (cls) { n.className = cls; }\n    if (text !== undefined) { n.textContent = text; }\n    return n;\n  }\n\n  function render() {\n    var max = parseInt($('price').value, 10);\n    $('priceOut').textContent = '$' + max;\n    var sort = $('sort').value;\n\n    var list = flights.filter(function (f) {\n      if (f.price > max) { return false; }\n      if (state.stops !== 'any' && String(f.stops) !== state.stops) { return false; }\n      return state.airlines[f.airline];\n    }).sort(function (a, b) {\n      return sort === 'price' ? a.price - b.price : (a.time < b.time ? -1 : 1);\n    });\n    var cheapest = list.reduce(function (m, f) { return m === null || f.price < m.price ? f : m; }, null);\n\n    var box = $('list');\n    box.textContent = '';\n    list.forEach(function (f) {\n      var card = el('div', 'flight' + (state.selected === f.code ? ' sel' : ''));\n      var left = el('div');\n      var top = el('div');\n      top.appendChild(el('span', 'time', f.time));\n      top.appendChild(el('span', 'tag ' + (f.stops === 0 ? 'ns' : 'st'), f.stops === 0 ? 'Nonstop' : '1 stop'));\n      if (cheapest && f.code === cheapest.code) { top.appendChild(el('span', 'tag best', 'Cheapest')); }\n      left.appendChild(top);\n      left.appendChild(el('div', 'meta', f.airline + ' ' + f.code));\n      var right = el('div', 'price', '$' + f.price);\n      var pick = el('button', '', state.selected === f.code ? 'Selected ✓' : 'Select');\n      pick.type = 'button';\n      pick.setAttribute('data-code', f.code);\n      card.appendChild(left); card.appendChild(right); card.appendChild(pick);\n      box.appendChild(card);\n    });\n    if (!list.length) {\n      var empty = el('div', 'empty', 'No flights match these filters. ');\n      var reset = el('button', '', 'Reset filters');\n      reset.type = 'button';\n      reset.setAttribute('data-reset', '1');\n      empty.appendChild(reset);\n      box.appendChild(empty);\n    }\n    $('count').textContent = list.length + ' of ' + flights.length + ' flights';\n\n    var chosen = null;\n    flights.forEach(function (f) { if (f.code === state.selected) { chosen = f; } });\n    var hiddenByFilter = chosen && list.indexOf(chosen) === -1;\n    $('tray').textContent = chosen\n      ? 'Selected: ' + chosen.airline + ' ' + chosen.code + ' · ' + chosen.time + ' · ' + (chosen.stops === 0 ? 'nonstop' : '1 stop') + ' · $' + chosen.price + (hiddenByFilter ? ' (hidden by current filters)' : '')\n      : 'No flight selected yet.';\n\n    var stopChips = $('stops').children;\n    for (var i = 0; i < stopChips.length; i++) { stopChips[i].className = 'chip' + (stopChips[i].getAttribute('data-stops') === state.stops ? ' on' : ''); }\n    var airChips = $('airlines').children;\n    for (var k = 0; k < airChips.length; k++) { airChips[k].className = 'chip' + (state.airlines[airChips[k].getAttribute('data-airline')] ? ' on' : ''); }\n  }\n\n  $('price').addEventListener('input', render);\n  $('sort').addEventListener('change', render);\n  $('stops').addEventListener('click', function (e) {\n    var s = e.target.getAttribute('data-stops');\n    if (s === null) { return; }\n    state.stops = s;\n    render();\n  });\n  $('airlines').addEventListener('click', function (e) {\n    var a = e.target.getAttribute('data-airline');\n    if (a === null) { return; }\n    state.airlines[a] = !state.airlines[a];\n    render();\n  });\n  $('list').addEventListener('click', function (e) {\n    if (e.target.getAttribute('data-reset')) {\n      $('price').value = '750';\n      state.stops = 'any';\n      airlines.forEach(function (a) { state.airlines[a] = true; });\n      render();\n      return;\n    }\n    var code = e.target.getAttribute('data-code');\n    if (code === null) { return; }\n    state.selected = state.selected === code ? null : code;\n    render();\n  });\n  render();\n})();\n</script>\n</body>\n</html>\n",
