  "html": {
    "document": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Monthly spending</title>\n<style>\n  * { box-sizing: border-box; }\n  body { margin: 0; padding: 16px; font: 14px/1.5 system-ui, -apple-system, \"Segoe UI\", sans-serif; color: #1a1a2e; background: #f7f7fb; }\n  h1 { font-size: 18px; margin: 0 0 4px; }\n  .lead { margin: 0 0 12px; color: #6b6b85; }\n  .card { background: #fff; border: 1px solid #e6e6f0; border-radius: 12px; padding: 12px; margin-bottom: 12px; }\n  .donut { position: relative; width: 200px; max-width: 70%; margin: 0 auto 8px; }\n  .donut svg { width: 100%; height: auto; display: block; transform: rotate(0deg); }\n  .seg { fill: none; stroke-width: 6; cursor: pointer; transition: stroke-width .15s, opacity .15s; }\n  .seg.dim { opacity: .35; }\n  .seg.sel { stroke-width: 8; }\n  .center { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; pointer-events: none; }\n  .center small { font-size: 11px; color: #6b6b85; }\n  .center b { font-size: 20px; line-height: 1.2; }\n  .center span { font-size: 12px; color: #6b6b85; }\n  .row { display: grid; grid-template-columns: 18px 12px 1fr auto 46px; gap: 6px; align-items: center; padding: 5px 4px; border-radius: 6px; cursor: pointer; }\n  .row:hover, .row.sel { background: #f1f1f8; }\n  .row.off { opacity: .45; }\n  .row input { margin: 0; }\n  .dot { width: 10px; height: 10px; border-radius: 3px; }\n  .row .amt { font-variant-numeric: tabular-nums; }\n  .row .pct { text-align: right; font-weight: 700; font-variant-numeric: tabular-nums; }\n  .actions { display: flex; gap: 6px; margin-top: 8px; flex-wrap: wrap; }\n  button { padding: 5px 10px; border-radius: 6px; border: 1px solid #d6d6e3; background: #fff; font: inherit; font-size: 12px; cursor: pointer; }\n  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }\n  .split div { background: #f7f7fb; border-radius: 8px; padding: 8px; }\n  .split small { display: block; color: #6b6b85; font-size: 11px; }\n  .split b { font-size: 16px; }\n</style>\n</head>\n<body>\n  <h1>Monthly spending</h1>\n  <p class=\"lead\">Tap a slice or a row to focus it. Untick a category to see how the rest divides up without it.</p>\n\n  <div class=\"card\">\n    <div class=\"donut\">\n      <svg viewBox=\"0 0 42 42\" role=\"img\" aria-label=\"Donut chart of spending by category\"><g id=\"segs\"></g></svg>\n      <div class=\"center\"><small id=\"cLabel\"></small><b id=\"cValue\"></b><span id=\"cShare\"></span></div>\n    </div>\n    <div id=\"rows\"></div>\n    <div class=\"actions\"><button id=\"noRent\">Hide rent</button><button id=\"all\">Show everything</button></div>\n  </div>\n\n  <div class=\"card\">\n    <div class=\"split\">\n      <div><small>Essentials (rent, groceries, transport, utilities)</small><b id=\"needs\"></b></div>\n      <div><small>Flexible (dining out, subscriptions, other)</small><b id=\"wants\"></b></div>\n    </div>\n  </div>\n\n<script>\n(function () {\n  var cats = [\n    { name: 'Rent', amt: 1800, color: '#4f46e5', need: true },\n    { name: 'Groceries', amt: 520, color: '#0ea5e9', need: true },\n    { name: 'Dining out', amt: 340, color: '#f97316', need: false },\n    { name: 'Transport', amt: 210, color: '#10b981', need: true },\n    { name: 'Other', amt: 195, color: '#a855f7', need: false },\n    { name: 'Utilities', amt: 160, color: '#eab308', need: true },\n    { name: 'Subscriptions', amt: 75, color: '#ef4444', need: false }\n  ];\n  var on = cats.map(function () { return true; });\n  var selected = -1;\n  var SVG = 'http://www.w3.org/2000/svg';\n  var $ = function (id) { return document.getElementById(id); };\n  var usd = function (n) { return '$' + Math.round(n).toLocaleString('en-US'); };\n  var pct = function (n) { return n.toFixed(1) + '%'; };\n\n  function render() {\n    var total = 0, needs = 0, wants = 0;\n    cats.forEach(function (c, i) {\n      if (!on[i]) { return; }\n      total += c.amt;\n      if (c.need) { needs += c.amt; } else { wants += c.amt; }\n    });\n    if (selected !== -1 && !on[selected]) { selected = -1; }\n\n    var g = $('segs');\n    while (g.firstChild) { g.removeChild(g.firstChild); }\n    var ring = document.createElementNS(SVG, 'circle');\n    ring.setAttribute('cx', '21'); ring.setAttribute('cy', '21'); ring.setAttribute('r', '15.915');\n    ring.setAttribute('fill', 'none'); ring.setAttribute('stroke', '#eeeef5'); ring.setAttribute('stroke-width', '6');\n    g.appendChild(ring);\n    var offset = 0;\n    cats.forEach(function (c, i) {\n      if (!on[i] || total === 0) { return; }\n      var share = c.amt / total * 100;\n      var seg = document.createElementNS(SVG, 'circle');\n      seg.setAttribute('cx', '21'); seg.setAttribute('cy', '21'); seg.setAttribute('r', '15.915');\n      seg.setAttribute('stroke', c.color);\n      seg.setAttribute('stroke-dasharray', share.toFixed(3) + ' ' + (100 - share).toFixed(3));\n      seg.setAttribute('stroke-dashoffset', (25 - offset).toFixed(3));\n      seg.setAttribute('data-i', String(i));\n      seg.setAttribute('class', 'seg' + (selected === i ? ' sel' : (selected !== -1 ? ' dim' : '')));\n      g.appendChild(seg);\n      offset += share;\n    });\n\n    if (selected === -1) {\n      $('cLabel').textContent = 'Total';\n      $('cValue').textContent = usd(total);\n      $('cShare').textContent = 'per month';\n    } else {\n      $('cLabel').textContent = cats[selected].name;\n      $('cValue').textContent = usd(cats[selected].amt);\n      $('cShare').textContent = pct(cats[selected].amt / total * 100) + ' of ' + usd(total);\n    }\n\n    var rows = $('rows');\n    rows.textContent = '';\n    cats.forEach(function (c, i) {\n      var row = document.createElement('label');\n      row.className = 'row' + (on[i] ? '' : ' off') + (selected === i ? ' sel' : '');\n      row.setAttribute('data-i', String(i));\n      var box = document.createElement('input');\n      box.type = 'checkbox'; box.checked = on[i];\n      box.setAttribute('data-toggle', String(i));\n      box.setAttribute('aria-label', 'Include ' + c.name);\n      var dot = document.createElement('span'); dot.className = 'dot'; dot.style.background = c.color;\n      var name = document.createElement('span'); name.textContent = c.name;\n      var amt = document.createElement('span'); amt.className = 'amt'; amt.textContent = usd(c.amt);\n      var share = document.createElement('span'); share.className = 'pct';\n      share.textContent = on[i] && total > 0 ? pct(c.amt / total * 100) : '—';\n      row.appendChild(box); row.appendChild(dot); row.appendChild(name); row.appendChild(amt); row.appendChild(share);\n      rows.appendChild(row);\n    });\n\n    $('needs').textContent = total > 0 ? usd(needs) + ' · ' + pct(needs / total * 100) : '—';\n    $('wants').textContent = total > 0 ? usd(wants) + ' · ' + pct(wants / total * 100) : '—';\n  }\n\n  $('segs').addEventListener('click', function (e) {\n    var i = e.target.getAttribute('data-i');\n    if (i === null) { return; }\n    var n = parseInt(i, 10);\n    selected = selected === n ? -1 : n;\n    render();\n  });\n  $('rows').addEventListener('change', function (e) {\n    var t = e.target.getAttribute('data-toggle');\n    if (t === null) { return; }\n    on[parseInt(t, 10)] = e.target.checked;\n    render();\n  });\n  $('rows').addEventListener('click', function (e) {\n    // Clicking the row (not its checkbox) focuses the slice.\n    if (e.target.getAttribute('data-toggle') !== null) { return; }\n    var node = e.target;\n    while (node && node !== $('rows') && node.getAttribute('data-i') === null) { node = node.parentNode; }\n    if (!node || node === $('rows')) { return; }\n    e.preventDefault();\n    var n = parseInt(node.getAttribute('data-i'), 10);\n    if (!on[n]) { return; }\n    selected = selected === n ? -1 : n;\n    render();\n  });\n  $('noRent').addEventListener('click', function () { on[0] = false; render(); });\n  $('all').addEventListener('click', function () { on = cats.map(function () { return true; }); render(); });\n  render();\n})();\n</script>\n</body>\n</html>\n",
