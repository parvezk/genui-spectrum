  "html": {
    "document": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Report a bug</title>\n<style>\n  * { box-sizing: border-box; }\n  body { margin: 0; padding: 16px; font: 14px/1.45 system-ui, -apple-system, \"Segoe UI\", sans-serif; color: #24292f; background: #f6f8fa; }\n  h1 { font-size: 18px; margin: 0 0 2px; }\n  .lead { margin: 0 0 12px; color: #57606a; font-size: 13px; }\n  .steps { display: flex; gap: 4px; margin-bottom: 12px; }\n  .steps button { flex: 1; border: 0; border-bottom: 3px solid #d0d7de; background: none; padding: 6px 2px; font: inherit; font-size: 12px; font-weight: 600; color: #57606a; cursor: pointer; }\n  .steps button.on { border-color: #0969da; color: #0969da; }\n  .steps button.ok::after { content: \" ✓\"; color: #1a7f37; }\n  .card { background: #fff; border: 1px solid #d0d7de; border-radius: 10px; padding: 12px; margin-bottom: 12px; }\n  label, .lbl { display: block; font-size: 12px; font-weight: 600; margin: 10px 0 4px; }\n  .card > label:first-child, .card > .lbl:first-child { margin-top: 0; }\n  label .req { color: #cf222e; }\n  input[type=text], input[type=email], textarea { width: 100%; padding: 7px 9px; border: 1px solid #d0d7de; border-radius: 6px; font: inherit; background: #fff; color: inherit; }\n  textarea { min-height: 76px; resize: vertical; }\n  .bad { border-color: #cf222e !important; }\n  .hint { display: flex; justify-content: space-between; font-size: 11px; color: #57606a; margin-top: 2px; min-height: 15px; }\n  .hint .err { color: #cf222e; }\n  .chips { display: flex; flex-wrap: wrap; gap: 6px; }\n  .chip { border: 1px solid #d0d7de; background: #f6f8fa; border-radius: 999px; padding: 4px 10px; font: inherit; font-size: 12px; cursor: pointer; color: inherit; }\n  .chip.on { background: #0969da; border-color: #0969da; color: #fff; }\n  .sev { display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; }\n  .sev button { border: 1px solid #d0d7de; background: #fff; border-radius: 6px; padding: 6px 2px; font: inherit; font-size: 11px; cursor: pointer; color: inherit; }\n  .sev button.on { color: #fff; font-weight: 700; border-color: transparent; }\n  .sev button.on[data-v=blocker] { background: #cf222e; } .sev button.on[data-v=major] { background: #bc4c00; }\n  .sev button.on[data-v=minor] { background: #9a6700; } .sev button.on[data-v=cosmetic] { background: #57606a; }\n  .two { display: grid; grid-template-columns: 2fr 1fr; gap: 8px; }\n  .check { display: flex; gap: 8px; align-items: center; font-weight: 400; font-size: 13px; }\n  .nav { display: flex; gap: 8px; }\n  .nav button { flex: 1; padding: 9px; border-radius: 8px; border: 1px solid #d0d7de; background: #fff; font: inherit; font-weight: 600; cursor: pointer; }\n  .nav button.primary { background: #1f883d; border-color: #1f883d; color: #fff; }\n  .preview { background: #fff; border: 1px solid #d0d7de; border-radius: 10px; padding: 12px; margin-bottom: 12px; font-size: 13px; }\n  .preview h2 { font-size: 15px; margin: 0 0 6px; }\n  .preview .labels { margin-bottom: 8px; }\n  .preview .labels span { display: inline-block; font-size: 11px; border-radius: 999px; padding: 0 8px; margin-right: 4px; background: #ddf4ff; color: #0969da; font-weight: 600; }\n  .preview h3 { font-size: 12px; margin: 8px 0 2px; color: #57606a; text-transform: uppercase; letter-spacing: .04em; }\n  .preview ol { margin: 0; padding-left: 20px; }\n  .preview p { margin: 0; }\n  .muted { color: #8c959f; font-style: italic; }\n  .sent { background: #dafbe1; border: 1px solid #aceebb; border-radius: 8px; padding: 10px; font-size: 13px; margin-bottom: 12px; }\n  [hidden] { display: none !important; }\n</style>\n</head>\n<body>\n  <h1>Report a bug</h1>\n  <p class=\"lead\">Three short steps. The preview at the bottom shows what the team will see.</p>\n\n  <div class=\"steps\" id=\"tabs\"><button data-step=\"0\">1 What happened</button><button data-step=\"1\">2 Your device</button><button data-step=\"2\">3 Follow-up</button></div>\n\n  <div class=\"card\" data-panel=\"0\">\n    <label for=\"summary\">Summary <span class=\"req\">*</span></label>\n    <input type=\"text\" id=\"summary\" maxlength=\"120\" placeholder=\"The app crashes when I tap Pay\">\n    <div class=\"hint\"><span class=\"err\" id=\"summaryErr\"></span><span id=\"summaryCount\"></span></div>\n\n    <span class=\"lbl\">Where in the app?</span>\n    <div class=\"chips\" id=\"area\"></div>\n\n    <label for=\"steps\">Steps to reproduce, one per line <span class=\"req\">*</span></label>\n    <textarea id=\"steps\" placeholder=\"Open the app&#10;Add an item to the basket&#10;Tap Pay\"></textarea>\n    <div class=\"hint\"><span class=\"err\" id=\"stepsErr\"></span></div>\n\n    <label for=\"expected\">What did you expect?</label>\n    <input type=\"text\" id=\"expected\">\n    <label for=\"actual\">What happened instead?</label>\n    <input type=\"text\" id=\"actual\">\n\n    <span class=\"lbl\">How bad is it?</span>\n    <div class=\"sev\" id=\"severity\"><button data-v=\"blocker\">Blocker</button><button data-v=\"major\">Major</button><button data-v=\"minor\">Minor</button><button data-v=\"cosmetic\">Cosmetic</button></div>\n    <span class=\"lbl\">How often?</span>\n    <div class=\"chips\" id=\"frequency\"></div>\n  </div>\n\n  <div class=\"card\" data-panel=\"1\" hidden>\n    <span class=\"lbl\">Platform</span>\n    <div class=\"chips\" id=\"platform\"></div>\n    <div class=\"two\">\n      <div><label for=\"device\">Device and OS <span class=\"req\">*</span></label><input type=\"text\" id=\"device\" placeholder=\"Pixel 8, Android 14\"><div class=\"hint\"><span class=\"err\" id=\"deviceErr\"></span></div></div>\n      <div><label for=\"version\">App version</label><input type=\"text\" id=\"version\" placeholder=\"4.2.1\"><div class=\"hint\"><span class=\"err\" id=\"versionErr\"></span></div></div>\n    </div>\n  </div>\n\n  <div class=\"card\" data-panel=\"2\" hidden>\n    <label class=\"check\"><input type=\"checkbox\" id=\"contact\"> The team may contact me about this report</label>\n    <div id=\"emailWrap\" hidden>\n      <label for=\"email\">Email <span class=\"req\">*</span></label>\n      <input type=\"email\" id=\"email\" placeholder=\"you@example.com\">\n      <div class=\"hint\"><span class=\"err\" id=\"emailErr\"></span></div>\n    </div>\n  </div>\n\n  <div class=\"nav\"><button type=\"button\" id=\"back\">Back</button><button type=\"button\" id=\"next\" class=\"primary\">Next</button></div>\n\n  <div class=\"sent\" id=\"sent\" hidden>Report ready. In a real app this would now be filed; this sandboxed page cannot send it anywhere.</div>\n\n  <div class=\"preview\" style=\"margin-top:12px\">\n    <h2 id=\"pTitle\"></h2>\n    <div class=\"labels\" id=\"pLabels\"></div>\n    <h3>Steps to reproduce</h3><div id=\"pSteps\"></div>\n    <h3>Expected</h3><p id=\"pExpected\"></p>\n    <h3>Actual</h3><p id=\"pActual\"></p>\n    <h3>Environment</h3><p id=\"pEnv\"></p>\n  </div>\n\n<script>\n(function () {\n  var $ = function (id) { return document.getElementById(id); };\n  var state = { step: 0, area: 'Checkout', severity: 'major', frequency: 'Every time', platform: 'iOS', tried: [false, false, false], done: false };\n  var groups = {\n    area: ['Login', 'Checkout', 'Search', 'Notifications', 'Profile', 'Other'],\n    frequency: ['Every time', 'Sometimes', 'Once'],\n    platform: ['iOS', 'Android']\n  };\n\n  Object.keys(groups).forEach(function (key) {\n    groups[key].forEach(function (v) {\n      var b = document.createElement('button');\n      b.type = 'button'; b.className = 'chip'; b.textContent = v;\n      b.setAttribute('data-v', v);\n      $(key).appendChild(b);\n    });\n    $(key).addEventListener('click', function (e) {\n      var v = e.target.getAttribute('data-v');\n      if (v) { state[key] = v; render(); }\n    });\n  });\n  $('severity').addEventListener('click', function (e) {\n    var v = e.target.getAttribute('data-v');\n    if (v) { state.severity = v; render(); }\n  });\n\n  function stepErrors(step) {\n    var e = {};\n    if (step === 0) {\n      if (!$('summary').value.trim()) { e.summary = 'Add a one-sentence summary.'; }\n      if (!$('steps').value.trim()) { e.steps = 'List at least one step.'; }\n    } else if (step === 1) {\n      if (!$('device').value.trim()) { e.device = 'Which device and OS?'; }\n      var v = $('version').value.trim();\n      if (v && !/^[0-9]+(\\.[0-9]+){1,2}$/.test(v)) { e.version = 'Use 4.2 or 4.2.1.'; }\n    } else {\n      if ($('contact').checked && !/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test($('email').value.trim())) { e.email = 'Enter a valid email.'; }\n    }\n    return e;\n  }\n  function hasErrors(step) { return Object.keys(stepErrors(step)).length > 0; }\n\n  function setText(id, text, placeholder) {\n    var n = $(id);\n    n.textContent = text || placeholder;\n    n.className = text ? '' : 'muted';\n  }\n\n  function render() {\n    var panels = document.querySelectorAll('[data-panel]');\n    for (var i = 0; i < panels.length; i++) { panels[i].hidden = parseInt(panels[i].getAttribute('data-panel'), 10) !== state.step; }\n    var tabs = $('tabs').children;\n    for (var t = 0; t < tabs.length; t++) {\n      tabs[t].className = (t === state.step ? 'on' : '') + (state.tried[t] && !hasErrors(t) ? ' ok' : '');\n    }\n    ['area', 'frequency', 'platform', 'severity'].forEach(function (key) {\n      var kids = $(key).children;\n      for (var k = 0; k < kids.length; k++) {\n        var on = kids[k].getAttribute('data-v') === state[key];\n        kids[k].classList.toggle('on', on);\n        kids[k].setAttribute('aria-pressed', on ? 'true' : 'false');\n      }\n    });\n\n    var e = state.tried[state.step] ? stepErrors(state.step) : {};\n    [['summary', 'summary'], ['steps', 'steps'], ['device', 'device'], ['version', 'version'], ['email', 'email']].forEach(function (pair) {\n      $(pair[0] + 'Err').textContent = e[pair[1]] || '';\n      $(pair[0]).classList.toggle('bad', !!e[pair[1]]);\n    });\n    $('summaryCount').textContent = $('summary').value.length + ' / 120';\n    $('emailWrap').hidden = !$('contact').checked;\n    $('back').disabled = state.step === 0;\n    $('next').textContent = state.step === 2 ? 'Send bug report' : 'Next';\n    $('sent').hidden = !state.done;\n\n    setText('pTitle', $('summary').value.trim(), 'Summary appears here');\n    var labels = $('pLabels');\n    labels.textContent = '';\n    [state.area, state.severity, state.frequency, state.platform].forEach(function (text) {\n      var s = document.createElement('span'); s.textContent = text; labels.appendChild(s);\n    });\n    var lines = $('steps').value.split('\\n').map(function (l) { return l.trim(); }).filter(function (l) { return l; });\n    var box = $('pSteps');\n    box.textContent = '';\n    if (lines.length) {\n      var ol = document.createElement('ol');\n      lines.forEach(function (l) { var li = document.createElement('li'); li.textContent = l.replace(/^[0-9]+[.)]\\s*/, ''); ol.appendChild(li); });\n      box.appendChild(ol);\n    } else {\n      var p = document.createElement('p'); p.className = 'muted'; p.textContent = 'No steps yet'; box.appendChild(p);\n    }\n    setText('pExpected', $('expected').value.trim(), 'Not given');\n    setText('pActual', $('actual').value.trim(), 'Not given');\n    var env = [$('device').value.trim(), $('version').value.trim() ? 'app ' + $('version').value.trim() : ''].filter(function (x) { return x; }).join(' · ');\n    setText('pEnv', env, 'Not given');\n  }\n\n  $('tabs').addEventListener('click', function (e) {\n    var s = e.target.getAttribute('data-step');\n    if (s === null) { return; }\n    state.step = parseInt(s, 10);\n    render();\n  });\n  $('back').addEventListener('click', function () { if (state.step > 0) { state.step -= 1; render(); } });\n  $('next').addEventListener('click', function () {\n    state.tried[state.step] = true;\n    if (hasErrors(state.step)) { render(); return; }\n    if (state.step < 2) { state.step += 1; render(); return; }\n    // Final step: check the earlier ones too, and jump to the first that fails.\n    for (var i = 0; i < 2; i++) {\n      state.tried[i] = true;\n      if (hasErrors(i)) { state.step = i; render(); return; }\n    }\n    state.done = true;\n    render();\n  });\n  ['summary', 'steps', 'expected', 'actual', 'device', 'version', 'email'].forEach(function (id) {\n    $(id).addEventListener('input', function () { state.done = false; render(); });\n  });\n  $('contact').addEventListener('change', render);\n  render();\n})();\n</script>\n</body>\n</html>\n",
