  "html": {
    "document": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Sorting algorithms race</title>\n<style>\n  * { box-sizing: border-box; }\n  body { margin: 0; padding: 16px; font: 14px/1.5 system-ui, -apple-system, \"Segoe UI\", sans-serif; color: #e2e8f0; background: #0f172a; }\n  h1 { font-size: 18px; margin: 0 0 4px; }\n  .lead { margin: 0 0 12px; color: #94a3b8; }\n  .controls { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-bottom: 12px; }\n  button, select { padding: 6px 12px; border-radius: 6px; border: 1px solid #334155; background: #1e293b; color: inherit; font: inherit; cursor: pointer; }\n  button.primary { background: #f59e0b; border-color: #f59e0b; color: #0f172a; font-weight: 700; }\n  label { font-size: 12px; color: #94a3b8; display: flex; align-items: center; gap: 6px; }\n  input[type=range] { accent-color: #f59e0b; width: 90px; }\n  .lane { background: #1e293b; border: 1px solid #334155; border-radius: 10px; padding: 10px; margin-bottom: 10px; }\n  .lane header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 6px; }\n  .lane h2 { font-size: 14px; margin: 0; }\n  .lane .stat { font: 12px ui-monospace, Menlo, monospace; color: #94a3b8; }\n  .lane.done { border-color: #22c55e; }\n  .lane.done h2::after { content: \" ✓ \" attr(data-place); color: #22c55e; font-weight: 400; font-size: 12px; }\n  .bars { display: flex; align-items: flex-end; gap: 1px; height: 70px; }\n  .bars i { flex: 1; background: #64748b; border-radius: 1px 1px 0 0; min-width: 1px; }\n  .bars i.hot { background: #f59e0b; }\n  .lane.done .bars i { background: #22c55e; }\n  table { width: 100%; border-collapse: collapse; font-size: 12px; margin-top: 4px; }\n  th, td { padding: 5px 6px; text-align: left; border-top: 1px solid #334155; }\n  th { color: #94a3b8; font-weight: 600; }\n  .note { color: #94a3b8; font-size: 12.5px; margin: 10px 0 0; }\n</style>\n</head>\n<body>\n  <h1>Bubble vs merge vs quicksort</h1>\n  <p class=\"lead\">All three sort the same list, one comparison or write per tick. Change the input to see where each one struggles.</p>\n\n  <div class=\"controls\">\n    <button id=\"run\" class=\"primary\">Run race</button>\n    <button id=\"shuffle\">New list</button>\n    <select id=\"kind\" aria-label=\"Input order\">\n      <option value=\"random\">Random</option>\n      <option value=\"nearly\">Nearly sorted</option>\n      <option value=\"reversed\">Reversed</option>\n    </select>\n    <label>Size <input id=\"size\" type=\"range\" min=\"8\" max=\"48\" value=\"28\"><span id=\"sizeOut\"></span></label>\n  </div>\n\n  <div id=\"lanes\"></div>\n\n  <table>\n    <thead><tr><th></th><th>Average</th><th>Worst</th><th>Space</th><th>Stable</th></tr></thead>\n    <tbody>\n      <tr><td>Bubble</td><td>O(n²)</td><td>O(n²)</td><td>O(1)</td><td>Yes</td></tr>\n      <tr><td>Merge</td><td>O(n log n)</td><td>O(n log n)</td><td>O(n)</td><td>Yes</td></tr>\n      <tr><td>Quick</td><td>O(n log n)</td><td>O(n²)</td><td>O(log n)</td><td>No</td></tr>\n    </tbody>\n  </table>\n  <p class=\"note\" id=\"note\">Tip: try \"Nearly sorted\" (bubble sort's best case) and \"Reversed\" (a last-element pivot gives quicksort its O(n²) worst case).</p>\n\n<script>\n(function () {\n  var $ = function (id) { return document.getElementById(id); };\n\n  function bubbleFrames(input) {\n    var a = input.slice(), frames = [], comps = 0, writes = 0, n = a.length;\n    for (var i = 0; i < n - 1; i++) {\n      var swapped = false;\n      for (var j = 0; j < n - 1 - i; j++) {\n        comps += 1;\n        if (a[j] > a[j + 1]) {\n          var t = a[j]; a[j] = a[j + 1]; a[j + 1] = t;\n          writes += 2;\n          swapped = true;\n        }\n        frames.push({ a: a.slice(), hot: [j, j + 1], comps: comps, writes: writes });\n      }\n      if (!swapped) { break; }\n    }\n    return frames;\n  }\n\n  function mergeFrames(input) {\n    var a = input.slice(), frames = [], comps = 0, writes = 0;\n    function sort(lo, hi) {\n      if (lo >= hi) { return; }\n      var mid = Math.floor((lo + hi) / 2);\n      sort(lo, mid);\n      sort(mid + 1, hi);\n      var left = a.slice(lo, mid + 1), right = a.slice(mid + 1, hi + 1);\n      var i = 0, j = 0, k = lo;\n      while (i < left.length || j < right.length) {\n        var takeLeft;\n        if (i < left.length && j < right.length) { comps += 1; takeLeft = left[i] <= right[j]; }\n        else { takeLeft = i < left.length; }\n        a[k] = takeLeft ? left[i++] : right[j++];\n        writes += 1;\n        frames.push({ a: a.slice(), hot: [k], comps: comps, writes: writes });\n        k += 1;\n      }\n    }\n    sort(0, a.length - 1);\n    return frames;\n  }\n\n  function quickFrames(input) {\n    var a = input.slice(), frames = [], comps = 0, writes = 0;\n    function swap(x, y) {\n      if (x === y) { return; }\n      var t = a[x]; a[x] = a[y]; a[y] = t;\n      writes += 2;\n    }\n    function sort(lo, hi) {\n      if (lo >= hi) { return; }\n      var pivot = a[hi], i = lo;\n      for (var j = lo; j < hi; j++) {\n        comps += 1;\n        if (a[j] < pivot) { swap(i, j); i += 1; }\n        frames.push({ a: a.slice(), hot: [j, hi], comps: comps, writes: writes });\n      }\n      swap(i, hi);\n      frames.push({ a: a.slice(), hot: [i], comps: comps, writes: writes });\n      sort(lo, i - 1);\n      sort(i + 1, hi);\n    }\n    sort(0, a.length - 1);\n    return frames;\n  }\n\n  var algos = [\n    { name: 'Bubble sort', make: bubbleFrames },\n    { name: 'Merge sort', make: mergeFrames },\n    { name: 'Quicksort', make: quickFrames }\n  ];\n  var input = [];\n  var timer = null;\n  var tick = 0;\n  var finished = 0;\n\n  algos.forEach(function (al) {\n    var lane = document.createElement('div');\n    lane.className = 'lane';\n    var head = document.createElement('header');\n    var h = document.createElement('h2'); h.textContent = al.name;\n    var stat = document.createElement('span'); stat.className = 'stat';\n    head.appendChild(h); head.appendChild(stat);\n    var bars = document.createElement('div'); bars.className = 'bars';\n    lane.appendChild(head); lane.appendChild(bars);\n    $('lanes').appendChild(lane);\n    al.lane = lane; al.title = h; al.stat = stat; al.bars = bars;\n  });\n\n  function makeInput() {\n    var n = parseInt($('size').value, 10);\n    var kind = $('kind').value;\n    var a = [];\n    for (var i = 1; i <= n; i++) { a.push(i); }\n    if (kind === 'reversed') { a.reverse(); }\n    else if (kind === 'random') {\n      for (var k = a.length - 1; k > 0; k--) {\n        var r = Math.floor(Math.random() * (k + 1));\n        var t = a[k]; a[k] = a[r]; a[r] = t;\n      }\n    } else {\n      for (var s = 0; s < Math.max(1, Math.floor(n / 10)); s++) {\n        var p = Math.floor(Math.random() * (n - 1));\n        var u = a[p]; a[p] = a[p + 1]; a[p + 1] = u;\n      }\n    }\n    return a;\n  }\n\n  function draw(al, frame) {\n    var n = frame.a.length;\n    var nodes = al.bars.children;\n    for (var i = 0; i < n; i++) {\n      nodes[i].style.height = (frame.a[i] / n * 100) + '%';\n      nodes[i].className = frame.hot.indexOf(i) !== -1 ? 'hot' : '';\n    }\n    al.stat.textContent = frame.comps + ' comparisons · ' + frame.writes + ' writes';\n  }\n\n  function prepare() {\n    if (timer) { clearInterval(timer); timer = null; }\n    input = makeInput();\n    tick = 0;\n    finished = 0;\n    $('sizeOut').textContent = String(input.length);\n    $('run').textContent = 'Run race';\n    algos.forEach(function (al) {\n      al.frames = al.make(input);\n      al.done = false;\n      al.lane.className = 'lane';\n      al.bars.textContent = '';\n      for (var i = 0; i < input.length; i++) { al.bars.appendChild(document.createElement('i')); }\n      draw(al, { a: input, hot: [], comps: 0, writes: 0 });\n    });\n  }\n\n  function advance() {\n    var running = false;\n    algos.forEach(function (al) {\n      if (al.done) { return; }\n      if (tick < al.frames.length) {\n        draw(al, al.frames[tick]);\n        running = true;\n      }\n      if (tick >= al.frames.length - 1) {\n        al.done = true;\n        finished += 1;\n        var last = al.frames.length ? al.frames[al.frames.length - 1] : { a: input, hot: [], comps: 0, writes: 0 };\n        draw(al, { a: last.a, hot: [], comps: last.comps, writes: last.writes });\n        al.title.setAttribute('data-place', finished === 1 ? 'first' : (finished === 2 ? 'second' : 'third'));\n        al.lane.className = 'lane done';\n      }\n    });\n    tick += 1;\n    if (!running || finished === algos.length) {\n      clearInterval(timer);\n      timer = null;\n      $('run').textContent = 'Run again';\n    }\n  }\n\n  $('run').addEventListener('click', function () {\n    if (timer) { clearInterval(timer); timer = null; $('run').textContent = 'Resume'; return; }\n    if (finished === algos.length) { prepare(); }\n    $('run').textContent = 'Pause';\n    timer = setInterval(advance, 35);\n  });\n  $('shuffle').addEventListener('click', prepare);\n  $('kind').addEventListener('change', prepare);\n  $('size').addEventListener('input', prepare);\n\n  prepare();\n})();\n</script>\n</body>\n</html>\n",
