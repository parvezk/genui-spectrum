  "html": {
    "document": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Sourdough starter in 7 days</title>\n<style>\n  * { box-sizing: border-box; }\n  body { margin: 0; padding: 16px; font: 14px/1.5 Georgia, \"Times New Roman\", serif; color: #3b2f2a; background: #fbf6ee; }\n  h1 { font-size: 20px; margin: 0 0 4px; }\n  h2 { font-size: 15px; margin: 0 0 6px; }\n  .lead { margin: 0 0 12px; color: #6b5a50; }\n  .ui { font-family: system-ui, -apple-system, \"Segoe UI\", sans-serif; }\n  .progress { height: 8px; background: #eadfce; border-radius: 4px; overflow: hidden; margin: 4px 0 2px; }\n  .progress i { display: block; height: 100%; width: 0; background: #b7791f; transition: width .3s; }\n  .days { display: flex; gap: 6px; margin: 12px 0; }\n  .day { flex: 1; min-width: 0; padding: 8px 0; border: 1px solid #dccdb8; background: #fff; border-radius: 8px; text-align: center; cursor: pointer; font: 600 13px system-ui, sans-serif; color: #6b5a50; }\n  .day small { display: block; font-weight: 400; font-size: 10px; }\n  .day.sel { border-color: #b7791f; box-shadow: 0 0 0 2px #f1d9a8; color: #3b2f2a; }\n  .day.done { background: #f6ead3; }\n  .panel { display: grid; grid-template-columns: 110px 1fr; gap: 12px; background: #fff; border: 1px solid #dccdb8; border-radius: 10px; padding: 12px; }\n  .panel svg { width: 100%; height: auto; }\n  .panel p { margin: 0 0 8px; }\n  .expect { color: #6b5a50; font-style: italic; }\n  label.check { display: flex; gap: 8px; align-items: center; font: 13px system-ui, sans-serif; cursor: pointer; }\n  .box { background: #fff; border: 1px solid #dccdb8; border-radius: 10px; padding: 12px; margin-top: 12px; }\n  .calc { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; font: 13px system-ui, sans-serif; }\n  .calc input { width: 70px; padding: 4px 6px; border: 1px solid #dccdb8; border-radius: 6px; font: inherit; }\n  .calc b { color: #b7791f; }\n  details { border-top: 1px solid #efe5d6; padding: 6px 0; }\n  details:first-of-type { border-top: 0; }\n  summary { cursor: pointer; font-weight: 600; }\n  details p { margin: 4px 0 2px; color: #6b5a50; }\n</style>\n</head>\n<body>\n  <h1>Sourdough starter in 7 days</h1>\n  <p class=\"lead\">Flour, water and patience. Pick a day to see what to do and what the jar should look like.</p>\n\n  <div class=\"ui\"><span id=\"count\"></span><div class=\"progress\"><i id=\"bar\"></i></div></div>\n\n  <div class=\"days\" id=\"days\"></div>\n\n  <div class=\"panel\">\n    <svg viewBox=\"0 0 110 150\" role=\"img\" aria-label=\"Jar showing how active the starter is\">\n      <rect x=\"18\" y=\"6\" width=\"74\" height=\"10\" rx=\"3\" fill=\"#c9b79c\"/>\n      <rect x=\"14\" y=\"16\" width=\"82\" height=\"128\" rx=\"12\" fill=\"#fdfaf5\" stroke=\"#a8957a\" stroke-width=\"2\"/>\n      <rect id=\"starter\" x=\"16\" y=\"100\" width=\"78\" height=\"42\" rx=\"10\" fill=\"#e8d5b0\"/>\n      <line id=\"band\" x1=\"12\" y1=\"100\" x2=\"98\" y2=\"100\" stroke=\"#c0392b\" stroke-width=\"2\"/>\n      <g id=\"bubbles\" fill=\"#fdfaf5\" stroke=\"#cdb88f\"></g>\n    </svg>\n    <div>\n      <h2 id=\"dayTitle\"></h2>\n      <p id=\"dayAction\"></p>\n      <p class=\"expect\" id=\"dayExpect\"></p>\n      <label class=\"check\"><input type=\"checkbox\" id=\"doneBox\"> Done for this day</label>\n    </div>\n  </div>\n\n  <div class=\"box\">\n    <h2>Feeding calculator</h2>\n    <div class=\"calc\">\n      <span>Keep</span><input id=\"keep\" type=\"number\" min=\"10\" max=\"500\" step=\"5\" value=\"50\"><span>g of starter, then add</span>\n      <b id=\"flour\"></b><span>flour and</span><b id=\"water\"></b><span>water (1:1:1).</span>\n    </div>\n  </div>\n\n  <div class=\"box\">\n    <h2>It is ready when…</h2>\n    <details open><summary>It doubles in 4–8 hours</summary><p>Mark the level with a rubber band after feeding (the red line in the jar) and check back.</p></details>\n    <details><summary>It smells like yoghurt</summary><p>Tangy and slightly sweet. Nail-polish or sock smells mean it is still settling down.</p></details>\n    <details><summary>A spoonful floats</summary><p>Drop a little into a glass of water. If it floats, it holds enough gas to raise bread.</p></details>\n    <details><summary>Something looks wrong?</summary><p>Grey liquid on top means it is hungry: pour it off and feed. No activity after day 4: move it somewhere warmer. Pink, orange or fuzzy patches are mould: start again.</p></details>\n  </div>\n\n<script>\n(function () {\n  var days = [\n    { name: 'Mix', action: 'Mix 50 g whole-wheat flour with 50 g lukewarm water in a clean jar. Cover loosely and keep it warm (24–26 °C).', expect: 'A thick paste. Nothing else yet.', activity: 0 },\n    { name: 'Rest', action: 'Leave it alone. Give it one stir.', expect: 'A few small bubbles, maybe none.', activity: 10 },\n    { name: 'Feed', action: 'Discard all but 50 g. Add 50 g white bread flour and 50 g water.', expect: 'Bubbles and a sharp, funky smell.', activity: 35 },\n    { name: 'Feed', action: 'Discard to 50 g and feed 50 g flour + 50 g water again.', expect: 'Often goes quiet. This lull is normal, keep going.', activity: 20 },\n    { name: 'Feed ×2', action: 'Start feeding twice a day, 12 hours apart, same amounts.', expect: 'Rises a little after each feed.', activity: 55 },\n    { name: 'Feed ×2', action: 'Feed twice again.', expect: 'Rises predictably and smells pleasantly tangy.', activity: 80 },\n    { name: 'Test', action: 'Feed, mark the level, and watch.', expect: 'Doubles within 4–8 hours and is bubbly throughout. Ready to bake!', activity: 100 }\n  ];\n  var done = [false, false, false, false, false, false, false];\n  var selected = 0;\n  var $ = function (id) { return document.getElementById(id); };\n  var SVG = 'http://www.w3.org/2000/svg';\n\n  var strip = $('days');\n  days.forEach(function (d, i) {\n    var b = document.createElement('button');\n    b.className = 'day';\n    b.type = 'button';\n    b.setAttribute('data-i', String(i));\n    b.appendChild(document.createTextNode(String(i + 1)));\n    var s = document.createElement('small');\n    s.textContent = d.name;\n    b.appendChild(s);\n    strip.appendChild(b);\n  });\n\n  function render() {\n    var d = days[selected];\n    var buttons = strip.querySelectorAll('.day');\n    for (var i = 0; i < buttons.length; i++) {\n      buttons[i].classList.toggle('sel', i === selected);\n      buttons[i].classList.toggle('done', done[i]);\n    }\n    $('dayTitle').textContent = 'Day ' + (selected + 1) + ': ' + d.name;\n    $('dayAction').textContent = d.action;\n    $('dayExpect').textContent = d.expect;\n    $('doneBox').checked = done[selected];\n\n    var n = done.filter(function (x) { return x; }).length;\n    $('count').textContent = n + ' of 7 days done';\n    $('bar').style.width = (n / 7 * 100) + '%';\n\n    // Jar: the starter sits at the band (y = 100) and rises with activity, up to double.\n    var rise = 42 * d.activity / 100;\n    var top = 100 - rise;\n    $('starter').setAttribute('y', String(top));\n    $('starter').setAttribute('height', String(42 + rise));\n    var g = $('bubbles');\n    while (g.firstChild) { g.removeChild(g.firstChild); }\n    var count = Math.round(d.activity / 7);\n    for (var k = 0; k < count; k++) {\n      var c = document.createElementNS(SVG, 'circle');\n      var x = 26 + ((k * 37) % 58);\n      var y = top + 8 + ((k * 23) % Math.max(10, 30 + rise));\n      c.setAttribute('cx', String(x));\n      c.setAttribute('cy', String(Math.min(y, 136)));\n      c.setAttribute('r', String(2 + (k % 3)));\n      g.appendChild(c);\n    }\n  }\n\n  function calc() {\n    var keep = parseFloat($('keep').value);\n    if (isNaN(keep) || keep < 0) { keep = 0; }\n    $('flour').textContent = keep + ' g';\n    $('water').textContent = keep + ' g';\n  }\n\n  strip.addEventListener('click', function (e) {\n    var t = e.target;\n    while (t && t !== strip && !t.classList.contains('day')) { t = t.parentNode; }\n    if (t && t !== strip) { selected = parseInt(t.getAttribute('data-i'), 10); render(); }\n  });\n  $('doneBox').addEventListener('change', function () { done[selected] = $('doneBox').checked; render(); });\n  $('keep').addEventListener('input', calc);\n  render();\n  calc();\n})();\n</script>\n</body>\n</html>\n",
    "validation": {
