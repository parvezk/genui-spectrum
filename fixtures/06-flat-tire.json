  "html": {
    "document": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Changing a flat tire</title>\n<style>\n  * { box-sizing: border-box; }\n  body { margin: 0; padding: 16px; font: 15px/1.45 system-ui, -apple-system, \"Segoe UI\", sans-serif; color: #111; background: #fffbea; }\n  h1 { font-size: 19px; margin: 0 0 8px; }\n  h2 { font-size: 15px; margin: 0; }\n  .warn { background: #111; color: #ffd400; border-radius: 10px; padding: 10px 12px; font-weight: 600; margin-bottom: 12px; }\n  .warn span { color: #fff; font-weight: 400; }\n  .top { position: sticky; top: 0; background: #fffbea; padding: 6px 0 8px; z-index: 2; }\n  .bar { height: 10px; background: #eadf9f; border-radius: 5px; overflow: hidden; }\n  .bar i { display: block; height: 100%; width: 0; background: #1a7f37; transition: width .25s; }\n  .top small { display: flex; justify-content: space-between; margin-top: 3px; color: #555; }\n  .next { background: #fff; border: 2px solid #111; border-radius: 10px; padding: 10px 12px; margin: 8px 0 12px; }\n  .next small { display: block; text-transform: uppercase; letter-spacing: .06em; font-size: 10px; color: #555; }\n  .next b { display: block; margin: 2px 0 8px; font-size: 16px; }\n  button { font: inherit; cursor: pointer; border-radius: 8px; border: 2px solid #111; background: #ffd400; padding: 8px 14px; font-weight: 700; }\n  button.ghost { background: #fff; font-weight: 500; border-width: 1px; }\n  section { background: #fff; border: 1px solid #e0d48a; border-radius: 10px; margin-bottom: 10px; overflow: hidden; }\n  section header { display: flex; justify-content: space-between; align-items: center; padding: 8px 12px; background: #fff3b0; }\n  section header span { font-size: 12px; color: #555; }\n  label.item { display: flex; gap: 10px; align-items: flex-start; padding: 10px 12px; border-top: 1px solid #f1eac0; cursor: pointer; }\n  label.item input { width: 20px; height: 20px; margin: 1px 0 0; flex: none; accent-color: #1a7f37; }\n  label.item.done span { color: #777; text-decoration: line-through; }\n  label.item.current { background: #fff9d6; }\n  .star { display: grid; grid-template-columns: 120px 1fr; gap: 12px; align-items: center; padding: 12px; }\n  .star svg { width: 120px; height: 120px; }\n  .nut { fill: #fff; stroke: #111; stroke-width: 2; transition: fill .2s; }\n  .nut.on { fill: #ffd400; }\n  .nut.past { fill: #1a7f37; }\n  .nutLabel { font: 700 11px system-ui, sans-serif; text-anchor: middle; pointer-events: none; }\n  #path { fill: none; stroke: #1a7f37; stroke-width: 2; stroke-dasharray: 4 3; }\n</style>\n</head>\n<body>\n  <h1>Changing a flat tire</h1>\n  <div class=\"warn\">Stay safe first. <span>On a motorway or narrow shoulder, do not change the wheel: get behind the barrier and call for help.</span></div>\n\n  <div class=\"top\">\n    <div class=\"bar\"><i id=\"bar\"></i></div>\n    <small><span id=\"count\"></span><span id=\"phase\"></span></small>\n  </div>\n\n  <div class=\"next\">\n    <small id=\"nextLabel\">Next step</small>\n    <b id=\"nextText\"></b>\n    <button id=\"doneBtn\">Done, next</button>\n    <button id=\"resetBtn\" class=\"ghost\">Start over</button>\n  </div>\n\n  <div id=\"sections\"></div>\n\n  <section>\n    <header><h2>Star pattern for the nuts</h2></header>\n    <div class=\"star\">\n      <svg viewBox=\"0 0 120 120\" role=\"img\" aria-label=\"Five wheel nuts tightened in the order 1, 3, 5, 2, 4\">\n        <circle cx=\"60\" cy=\"60\" r=\"54\" fill=\"#333\"/>\n        <circle cx=\"60\" cy=\"60\" r=\"40\" fill=\"#bbb\"/>\n        <circle cx=\"60\" cy=\"60\" r=\"10\" fill=\"#333\"/>\n        <polyline id=\"path\" points=\"\"/>\n        <g id=\"nuts\"></g>\n      </svg>\n      <div>\n        <p style=\"margin:0 0 8px\">Jump to the nut <b>opposite</b>, never the neighbour, so the wheel seats evenly.</p>\n        <button id=\"starBtn\" class=\"ghost\">Show the order</button>\n        <p id=\"starText\" style=\"margin:8px 0 0; font-weight:600\"></p>\n      </div>\n    </div>\n  </section>\n\n<script>\n(function () {\n  var sections = [\n    { title: '1. Make the scene safe', steps: [\n      'Pull over on flat, firm ground, well away from traffic',\n      'Hazard lights on; hi-vis vest if you have one',\n      'Parking brake on; car in Park or first gear',\n      'Passengers out and clear of the road',\n      'Warning triangle about 45 m (50 yards) behind the car',\n      'Chock the wheel diagonally opposite the flat'\n    ] },\n    { title: '2. Change the wheel', steps: [\n      'Get out the spare, jack and wrench; check the spare has air',\n      'Loosen each nut half a turn while the tire is still on the ground',\n      'Jack at the jacking point until the tire is 5 cm off the ground',\n      'Never put any part of your body under the car',\n      'Remove the nuts, keep them together, pull the wheel straight off',\n      'Fit the spare and hand-tighten the nuts in a star pattern',\n      'Lower until the tire touches, then tighten fully in a star pattern',\n      'Lower completely, remove the jack, check each nut again'\n    ] },\n    { title: '3. Before you drive off', steps: [\n      'Stow the flat, jack, wrench, triangle and chock',\n      'Check the spare\\'s pressure at the next fuel station',\n      'Space-saver spare: stay under 80 km/h (50 mph)',\n      'Have the nuts re-torqued after about 50 km'\n    ] }\n  ];\n  var $ = function (id) { return document.getElementById(id); };\n  var boxes = [];   // { input, label, section, text }\n  var root = $('sections');\n\n  sections.forEach(function (sec, s) {\n    var el = document.createElement('section');\n    var head = document.createElement('header');\n    var h = document.createElement('h2');\n    h.textContent = sec.title;\n    var tally = document.createElement('span');\n    head.appendChild(h);\n    head.appendChild(tally);\n    el.appendChild(head);\n    sec.tally = tally;\n    sec.steps.forEach(function (text) {\n      var label = document.createElement('label');\n      label.className = 'item';\n      var input = document.createElement('input');\n      input.type = 'checkbox';\n      var span = document.createElement('span');\n      span.textContent = text;\n      label.appendChild(input);\n      label.appendChild(span);\n      el.appendChild(label);\n      boxes.push({ input: input, label: label, section: s, text: text });\n      input.addEventListener('change', render);\n    });\n    root.appendChild(el);\n  });\n\n  function render() {\n    var total = boxes.length;\n    var doneCount = 0;\n    var firstOpen = -1;\n    var perSection = sections.map(function () { return { done: 0, total: 0 }; });\n    boxes.forEach(function (b, i) {\n      perSection[b.section].total += 1;\n      if (b.input.checked) { doneCount += 1; perSection[b.section].done += 1; }\n      else if (firstOpen === -1) { firstOpen = i; }\n      b.label.classList.toggle('done', b.input.checked);\n    });\n    boxes.forEach(function (b, i) { b.label.classList.toggle('current', i === firstOpen); });\n    sections.forEach(function (sec, s) { sec.tally.textContent = perSection[s].done + ' / ' + perSection[s].total; });\n\n    $('bar').style.width = (doneCount / total * 100) + '%';\n    $('count').textContent = doneCount + ' of ' + total + ' steps done';\n    if (firstOpen === -1) {\n      $('phase').textContent = 'All done';\n      $('nextLabel').textContent = 'Finished';\n      $('nextText').textContent = 'You are ready to drive. Take it slowly and get the flat repaired.';\n      $('doneBtn').disabled = true;\n    } else {\n      $('phase').textContent = sections[boxes[firstOpen].section].title;\n      $('nextLabel').textContent = 'Next step';\n      $('nextText').textContent = boxes[firstOpen].text;\n      $('doneBtn').disabled = false;\n    }\n  }\n\n  $('doneBtn').addEventListener('click', function () {\n    for (var i = 0; i < boxes.length; i++) {\n      if (!boxes[i].input.checked) { boxes[i].input.checked = true; break; }\n    }\n    render();\n  });\n  $('resetBtn').addEventListener('click', function () {\n    boxes.forEach(function (b) { b.input.checked = false; });\n    render();\n  });\n\n  // Star pattern: five nuts, tightened 1, 3, 5, 2, 4.\n  var SVG = 'http://www.w3.org/2000/svg';\n  var order = [0, 2, 4, 1, 3];\n  var points = [];\n  var nutNodes = [];\n  for (var n = 0; n < 5; n++) {\n    var angle = (-90 + n * 72) * Math.PI / 180;\n    var x = 60 + 28 * Math.cos(angle);\n    var y = 60 + 28 * Math.sin(angle);\n    points.push([x, y]);\n    var c = document.createElementNS(SVG, 'circle');\n    c.setAttribute('cx', x.toFixed(1));\n    c.setAttribute('cy', y.toFixed(1));\n    c.setAttribute('r', '9');\n    c.setAttribute('class', 'nut');\n    var t = document.createElementNS(SVG, 'text');\n    t.setAttribute('x', x.toFixed(1));\n    t.setAttribute('y', (y + 4).toFixed(1));\n    t.setAttribute('class', 'nutLabel');\n    t.textContent = String(n + 1);\n    $('nuts').appendChild(c);\n    $('nuts').appendChild(t);\n    nutNodes.push(c);\n  }\n  var timer = null;\n  function showStar() {\n    if (timer) { clearInterval(timer); }\n    var k = 0;\n    nutNodes.forEach(function (node) { node.setAttribute('class', 'nut'); });\n    $('path').setAttribute('points', '');\n    $('starText').textContent = '';\n    timer = setInterval(function () {\n      if (k > 0) { nutNodes[order[k - 1]].setAttribute('class', 'nut past'); }\n      if (k === order.length) {\n        clearInterval(timer);\n        timer = null;\n        $('starText').textContent = 'Order: 1 → 3 → 5 → 2 → 4';\n        return;\n      }\n      nutNodes[order[k]].setAttribute('class', 'nut on');\n      var pts = order.slice(0, k + 1).map(function (i) { return points[i][0].toFixed(1) + ',' + points[i][1].toFixed(1); }).join(' ');\n      $('path').setAttribute('points', pts);\n      $('starText').textContent = 'Tighten nut ' + (order[k] + 1);\n      k += 1;\n    }, 700);\n  }\n  $('starBtn').addEventListener('click', showStar);\n\n  render();\n})();\n</script>\n</body>\n</html>\n",
