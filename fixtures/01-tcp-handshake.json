  "html": {
    "document": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>TCP three-way handshake</title>\n<style>\n  * { box-sizing: border-box; }\n  body { margin: 0; padding: 16px; font: 14px/1.5 system-ui, -apple-system, \"Segoe UI\", sans-serif; color: #1f2933; background: #f7f9fb; }\n  h1 { font-size: 18px; margin: 0 0 4px; }\n  p.lead { margin: 0 0 12px; color: #52606d; }\n  .controls { display: flex; flex-wrap: wrap; gap: 8px; align-items: end; margin-bottom: 12px; }\n  label { display: flex; flex-direction: column; font-size: 12px; color: #52606d; gap: 2px; }\n  input[type=number] { width: 96px; padding: 5px 6px; border: 1px solid #cbd2d9; border-radius: 6px; font: inherit; }\n  button { padding: 6px 12px; border-radius: 6px; border: 1px solid #cbd2d9; background: #fff; font: inherit; cursor: pointer; }\n  button.primary { background: #0b69a3; border-color: #0b69a3; color: #fff; }\n  button:disabled { opacity: .45; cursor: default; }\n  .stage { background: #fff; border: 1px solid #e4e7eb; border-radius: 10px; padding: 8px; }\n  svg { width: 100%; height: auto; display: block; }\n  .life { stroke: #9aa5b1; stroke-width: 2; stroke-dasharray: 4 4; }\n  .host { font-weight: 600; font-size: 13px; fill: #1f2933; }\n  .state { font-size: 11px; fill: #0b69a3; font-weight: 600; }\n  .msg { opacity: 0; transition: opacity .35s ease; }\n  .msg.on { opacity: 1; }\n  .msg line { stroke-width: 2.5; }\n  .msg text { font-size: 11.5px; }\n  .msg .flag { font-weight: 700; }\n  .explain { margin-top: 12px; background: #fff; border: 1px solid #e4e7eb; border-left: 4px solid #0b69a3; border-radius: 8px; padding: 10px 12px; min-height: 76px; }\n  .explain h2 { font-size: 14px; margin: 0 0 4px; }\n  .explain p { margin: 0; color: #3e4c59; }\n  .dots { display: flex; gap: 6px; margin-top: 10px; }\n  .dot { width: 26px; height: 5px; border-radius: 3px; background: #cbd2d9; }\n  .dot.on { background: #0b69a3; }\n  details { margin-top: 12px; background: #fff; border: 1px solid #e4e7eb; border-radius: 8px; padding: 8px 12px; }\n  summary { cursor: pointer; font-weight: 600; }\n  details ul { margin: 8px 0 2px; padding-left: 18px; color: #3e4c59; }\n</style>\n</head>\n<body>\n  <h1>The TCP three-way handshake</h1>\n  <p class=\"lead\">Step through the three segments that open a connection. Change the starting sequence numbers to see how the acknowledgements follow.</p>\n\n  <div class=\"controls\">\n    <label>Client ISN (x)<input id=\"isnClient\" type=\"number\" value=\"1000\" min=\"0\" max=\"99999\"></label>\n    <label>Server ISN (y)<input id=\"isnServer\" type=\"number\" value=\"5000\" min=\"0\" max=\"99999\"></label>\n    <button id=\"prev\">Back</button>\n    <button id=\"next\" class=\"primary\">Next step</button>\n    <button id=\"reset\">Reset</button>\n  </div>\n\n  <div class=\"stage\">\n    <svg viewBox=\"0 0 360 250\" role=\"img\" aria-label=\"Sequence diagram of the TCP handshake\">\n      <defs>\n        <marker id=\"arrowBlue\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"6\" markerHeight=\"6\" orient=\"auto-start-reverse\"><path d=\"M0 0 L10 5 L0 10 z\" fill=\"#0b69a3\"/></marker>\n        <marker id=\"arrowGreen\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"6\" markerHeight=\"6\" orient=\"auto-start-reverse\"><path d=\"M0 0 L10 5 L0 10 z\" fill=\"#18794e\"/></marker>\n      </defs>\n      <text class=\"host\" x=\"50\" y=\"18\" text-anchor=\"middle\">Client</text>\n      <text class=\"host\" x=\"310\" y=\"18\" text-anchor=\"middle\">Server</text>\n      <text class=\"state\" id=\"stateClient\" x=\"50\" y=\"34\" text-anchor=\"middle\">CLOSED</text>\n      <text class=\"state\" id=\"stateServer\" x=\"310\" y=\"34\" text-anchor=\"middle\">LISTEN</text>\n      <line class=\"life\" x1=\"50\" y1=\"42\" x2=\"50\" y2=\"240\"/>\n      <line class=\"life\" x1=\"310\" y1=\"42\" x2=\"310\" y2=\"240\"/>\n\n      <g class=\"msg\" id=\"msg1\">\n        <line x1=\"54\" y1=\"70\" x2=\"306\" y2=\"100\" stroke=\"#0b69a3\" marker-end=\"url(#arrowBlue)\"/>\n        <text x=\"180\" y=\"72\" text-anchor=\"middle\" fill=\"#0b69a3\"><tspan class=\"flag\">SYN</tspan> <tspan id=\"m1nums\"></tspan></text>\n      </g>\n      <g class=\"msg\" id=\"msg2\">\n        <line x1=\"306\" y1=\"125\" x2=\"54\" y2=\"155\" stroke=\"#18794e\" marker-end=\"url(#arrowGreen)\"/>\n        <text x=\"180\" y=\"127\" text-anchor=\"middle\" fill=\"#18794e\"><tspan class=\"flag\">SYN-ACK</tspan> <tspan id=\"m2nums\"></tspan></text>\n      </g>\n      <g class=\"msg\" id=\"msg3\">\n        <line x1=\"54\" y1=\"180\" x2=\"306\" y2=\"210\" stroke=\"#0b69a3\" marker-end=\"url(#arrowBlue)\"/>\n        <text x=\"180\" y=\"182\" text-anchor=\"middle\" fill=\"#0b69a3\"><tspan class=\"flag\">ACK</tspan> <tspan id=\"m3nums\"></tspan></text>\n      </g>\n    </svg>\n  </div>\n\n  <div class=\"explain\" aria-live=\"polite\">\n    <h2 id=\"stepTitle\"></h2>\n    <p id=\"stepText\"></p>\n    <div class=\"dots\"><span class=\"dot\" id=\"dot1\"></span><span class=\"dot\" id=\"dot2\"></span><span class=\"dot\" id=\"dot3\"></span></div>\n  </div>\n\n  <details>\n    <summary>Why three steps and not two?</summary>\n    <ul>\n      <li><b>Both directions are confirmed.</b> Each side must learn the other received its sequence number.</li>\n      <li><b>Stale requests are rejected.</b> A delayed old SYN gets a SYN-ACK that nobody answers, so nothing opens.</li>\n      <li><b>Numbers are synchronised.</b> All later bytes are counted from x and y, which enables ordering and retransmission.</li>\n    </ul>\n  </details>\n\n<script>\n(function () {\n  var step = 0;\n  var el = function (id) { return document.getElementById(id); };\n\n  function isn(id, fallback) {\n    var n = parseInt(el(id).value, 10);\n    return isNaN(n) || n < 0 ? fallback : n;\n  }\n\n  function render() {\n    var x = isn('isnClient', 1000);\n    var y = isn('isnServer', 5000);\n\n    el('m1nums').textContent = 'seq=' + x;\n    el('m2nums').textContent = 'seq=' + y + ' ack=' + (x + 1);\n    el('m3nums').textContent = 'seq=' + (x + 1) + ' ack=' + (y + 1);\n\n    for (var i = 1; i <= 3; i++) {\n      el('msg' + i).classList.toggle('on', step >= i);\n      el('dot' + i).classList.toggle('on', step >= i);\n    }\n\n    var clientStates = ['CLOSED', 'SYN-SENT', 'SYN-SENT', 'ESTABLISHED'];\n    var serverStates = ['LISTEN', 'LISTEN', 'SYN-RECEIVED', 'ESTABLISHED'];\n    el('stateClient').textContent = clientStates[step];\n    el('stateServer').textContent = serverStates[step];\n\n    var titles = [\n      'Ready',\n      'Step 1: SYN',\n      'Step 2: SYN-ACK',\n      'Step 3: ACK, connection established'\n    ];\n    var texts = [\n      'The server is listening. Press \"Next step\" to send the first segment.',\n      'The client picks its initial sequence number x = ' + x + ' and sends a segment with the SYN flag. It now waits in SYN-SENT.',\n      'The server answers with its own number y = ' + y + ' and acknowledges the client: ack = x + 1 = ' + (x + 1) + '. A SYN uses up one sequence number, hence the +1.',\n      'The client acknowledges the server: ack = y + 1 = ' + (y + 1) + '. Both sides know the other can send and receive, so data can flow.'\n    ];\n    el('stepTitle').textContent = titles[step];\n    el('stepText').textContent = texts[step];\n\n    el('prev').disabled = step === 0;\n    el('next').disabled = step === 3;\n  }\n\n  el('next').addEventListener('click', function () { if (step < 3) { step += 1; render(); } });\n  el('prev').addEventListener('click', function () { if (step > 0) { step -= 1; render(); } });\n  el('reset').addEventListener('click', function () { step = 0; render(); });\n  el('isnClient').addEventListener('input', render);\n  el('isnServer').addEventListener('input', render);\n  render();\n})();\n</script>\n</body>\n</html>\n",
