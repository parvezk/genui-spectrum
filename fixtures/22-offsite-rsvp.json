  "html": {
    "document": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Offsite RSVP</title>\n<style>\n  * { box-sizing: border-box; }\n  body { margin: 0; font: 14px/1.5 system-ui, -apple-system, \"Segoe UI\", sans-serif; color: #1b2a41; background: #fff7ed; }\n  .hero { background: linear-gradient(135deg, #0c4a6e, #0e7490 60%, #f59e0b); color: #fff; padding: 20px 16px 26px; }\n  .hero small { text-transform: uppercase; letter-spacing: .1em; font-size: 10px; opacity: .85; }\n  .hero h1 { margin: 2px 0; font-size: 22px; }\n  .hero p { margin: 0; opacity: .95; }\n  main { padding: 0 16px 16px; margin-top: -12px; }\n  .card { background: #fff; border-radius: 14px; padding: 14px; box-shadow: 0 2px 10px rgba(12,74,110,.08); margin-bottom: 12px; }\n  h2 { font-size: 14px; margin: 0 0 8px; }\n  .yn { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }\n  .yn button { border: 2px solid #e2e8f0; background: #fff; border-radius: 12px; padding: 12px 6px; font: inherit; font-weight: 700; cursor: pointer; color: inherit; }\n  .yn button span { display: block; font-size: 22px; }\n  .yn button.on[data-v=yes] { border-color: #0e7490; background: #ecfeff; }\n  .yn button.on[data-v=no] { border-color: #94a3b8; background: #f1f5f9; }\n  .more { overflow: hidden; max-height: 0; opacity: 0; transition: max-height .35s ease, opacity .25s ease; }\n  .more.open { max-height: 900px; opacity: 1; }\n  .chips { display: flex; flex-wrap: wrap; gap: 6px; }\n  .chip { border: 1px solid #cbd5e1; background: #fff; border-radius: 999px; padding: 5px 12px; font: inherit; font-size: 13px; cursor: pointer; color: inherit; }\n  .chip.on { background: #0e7490; border-color: #0e7490; color: #fff; }\n  input[type=text] { width: 100%; padding: 8px 10px; border: 1px solid #cbd5e1; border-radius: 8px; font: inherit; margin-top: 8px; }\n  .switch { display: flex; align-items: center; justify-content: space-between; cursor: pointer; }\n  .switch input { position: absolute; opacity: 0; }\n  .switch i { width: 42px; height: 24px; border-radius: 12px; background: #cbd5e1; position: relative; transition: background .2s; flex: none; }\n  .switch i::after { content: \"\"; position: absolute; top: 3px; left: 3px; width: 18px; height: 18px; border-radius: 50%; background: #fff; transition: left .2s; }\n  .switch input:checked + i { background: #0e7490; }\n  .switch input:checked + i::after { left: 21px; }\n  .switch input:focus-visible + i { outline: 2px solid #f59e0b; }\n  .nights { display: none; margin-top: 10px; }\n  .nights.open { display: block; }\n  .night { display: flex; gap: 8px; align-items: center; padding: 4px 0; cursor: pointer; }\n  .summary { background: #0c4a6e; color: #fff; border-radius: 14px; padding: 14px; }\n  .summary small { text-transform: uppercase; letter-spacing: .08em; font-size: 10px; opacity: .8; }\n  .summary p { margin: 2px 0 10px; font-size: 15px; }\n  .summary button { width: 100%; border: 0; border-radius: 10px; padding: 11px; font: inherit; font-weight: 700; background: #f59e0b; color: #1b2a41; cursor: pointer; }\n  .summary button:disabled { opacity: .5; cursor: default; }\n  .summary .after { font-size: 12px; opacity: .85; margin: 8px 0 0; }\n  .err { color: #fde68a; font-size: 12px; margin: 0 0 8px; }\n</style>\n</head>\n<body>\n  <div class=\"hero\">\n    <small>Team offsite</small>\n    <h1>Porto</h1>\n    <p>12–13 September</p>\n  </div>\n  <main>\n    <div class=\"card\">\n      <h2>Are you coming?</h2>\n      <div class=\"yn\" id=\"yn\">\n        <button type=\"button\" data-v=\"yes\"><span>🎉</span>Yes, I'll be there</button>\n        <button type=\"button\" data-v=\"no\"><span>😔</span>No, I can't make it</button>\n      </div>\n    </div>\n\n    <div class=\"more\" id=\"more\">\n      <div class=\"card\">\n        <h2>Dietary needs</h2>\n        <div class=\"chips\" id=\"diet\"></div>\n        <input type=\"text\" id=\"allergies\" placeholder=\"Allergies or anything else (optional)\" aria-label=\"Allergies or anything else\">\n      </div>\n      <div class=\"card\">\n        <label class=\"switch\"><h2 style=\"margin:0\">I need a hotel room</h2><input type=\"checkbox\" id=\"hotel\"><i></i></label>\n        <div class=\"nights\" id=\"nights\">\n          <label class=\"night\"><input type=\"checkbox\" data-night=\"11 Sep\"> 11 Sep <span style=\"color:#64748b\">(arriving the night before)</span></label>\n          <label class=\"night\"><input type=\"checkbox\" data-night=\"12 Sep\" checked> 12 Sep</label>\n          <label class=\"night\"><input type=\"checkbox\" data-night=\"13 Sep\"> 13 Sep <span style=\"color:#64748b\">(leaving the day after)</span></label>\n        </div>\n      </div>\n      <div class=\"card\">\n        <h2>T-shirt size</h2>\n        <div class=\"chips\" id=\"shirt\"></div>\n      </div>\n    </div>\n\n    <div class=\"summary\">\n      <small>Your RSVP</small>\n      <p id=\"sentence\"></p>\n      <p class=\"err\" id=\"err\"></p>\n      <button type=\"button\" id=\"send\">Send RSVP</button>\n      <p class=\"after\" id=\"after\"></p>\n    </div>\n  </main>\n\n<script>\n(function () {\n  var $ = function (id) { return document.getElementById(id); };\n  var state = { attending: null, diet: {}, shirt: null, sent: false };\n  var diets = ['Vegetarian', 'Vegan', 'Gluten-free', 'Halal', 'Kosher'];\n  var sizes = ['XS', 'S', 'M', 'L', 'XL', 'XXL'];\n\n  function chips(box, values) {\n    values.forEach(function (v) {\n      var b = document.createElement('button');\n      b.type = 'button'; b.className = 'chip'; b.textContent = v;\n      b.setAttribute('data-v', v);\n      box.appendChild(b);\n    });\n  }\n  chips($('diet'), diets);\n  chips($('shirt'), sizes);\n\n  function nights() {\n    var out = [];\n    var boxes = $('nights').querySelectorAll('input');\n    for (var i = 0; i < boxes.length; i++) { if (boxes[i].checked) { out.push(boxes[i].getAttribute('data-night')); } }\n    return out;\n  }\n\n  function problem() {\n    if (state.attending === null) { return 'Choose yes or no.'; }\n    if (state.attending === 'yes') {\n      if (!state.shirt) { return 'Pick a T-shirt size.'; }\n      if ($('hotel').checked && nights().length === 0) { return 'Pick at least one hotel night, or switch the hotel off.'; }\n    }\n    return '';\n  }\n\n  function sentence() {\n    if (state.attending === null) { return 'Not answered yet.'; }\n    if (state.attending === 'no') { return 'Not coming. Thanks for letting us know.'; }\n    var picked = diets.filter(function (d) { return state.diet[d]; });\n    var parts = ['Coming'];\n    parts.push(picked.length ? picked.join(', ').toLowerCase() : 'no dietary needs');\n    var allergy = $('allergies').value.trim();\n    if (allergy) { parts.push('note: ' + allergy); }\n    if ($('hotel').checked) {\n      var n = nights();\n      parts.push(n.length ? 'hotel for ' + n.length + (n.length === 1 ? ' night (' : ' nights (') + n.join(', ') + ')' : 'hotel (no nights picked)');\n    } else { parts.push('no hotel'); }\n    parts.push(state.shirt ? 'T-shirt ' + state.shirt : 'no T-shirt size yet');\n    return parts.join(' · ') + '.';\n  }\n\n  function render(showError) {\n    var yn = $('yn').children;\n    for (var i = 0; i < yn.length; i++) {\n      var on = yn[i].getAttribute('data-v') === state.attending;\n      yn[i].className = on ? 'on' : '';\n      yn[i].setAttribute('aria-pressed', on ? 'true' : 'false');\n    }\n    $('more').className = 'more' + (state.attending === 'yes' ? ' open' : '');\n    var d = $('diet').children;\n    for (var k = 0; k < d.length; k++) { d[k].className = 'chip' + (state.diet[d[k].getAttribute('data-v')] ? ' on' : ''); }\n    var s = $('shirt').children;\n    for (var m = 0; m < s.length; m++) { s[m].className = 'chip' + (s[m].getAttribute('data-v') === state.shirt ? ' on' : ''); }\n    $('nights').className = 'nights' + ($('hotel').checked ? ' open' : '');\n    $('sentence').textContent = sentence();\n    $('err').textContent = showError ? problem() : '';\n    $('send').textContent = state.sent ? 'Update RSVP' : 'Send RSVP';\n    $('after').textContent = state.sent ? 'Recorded on this page only: a sandboxed page cannot send it to the organisers.' : '';\n  }\n\n  $('yn').addEventListener('click', function (e) {\n    var t = e.target;\n    while (t && t !== $('yn') && !t.getAttribute('data-v')) { t = t.parentNode; }\n    if (!t || t === $('yn')) { return; }\n    state.attending = t.getAttribute('data-v');\n    state.sent = false;\n    render(false);\n  });\n  $('diet').addEventListener('click', function (e) {\n    var v = e.target.getAttribute('data-v');\n    if (!v) { return; }\n    state.diet[v] = !state.diet[v];\n    state.sent = false;\n    render(false);\n  });\n  $('shirt').addEventListener('click', function (e) {\n    var v = e.target.getAttribute('data-v');\n    if (!v) { return; }\n    state.shirt = v;\n    state.sent = false;\n    render(false);\n  });\n  $('hotel').addEventListener('change', function () { state.sent = false; render(false); });\n  $('nights').addEventListener('change', function () { state.sent = false; render(false); });\n  $('allergies').addEventListener('input', function () { state.sent = false; render(false); });\n  $('send').addEventListener('click', function () {\n    if (problem()) { render(true); return; }\n    state.sent = true;\n    render(false);\n  });\n  render(false);\n})();\n</script>\n</body>\n</html>\n",
