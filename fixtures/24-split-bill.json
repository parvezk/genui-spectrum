  "html": {
    "document": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Split the bill</title>\n<style>\n  * { box-sizing: border-box; }\n  body { margin: 0; padding: 16px; font: 14px/1.45 system-ui, -apple-system, \"Segoe UI\", sans-serif; color: #f8fafc; background: #111827; }\n  h1 { font-size: 18px; margin: 0 0 12px; }\n  .result { background: linear-gradient(135deg, #10b981, #059669); border-radius: 16px; padding: 16px; text-align: center; margin-bottom: 14px; }\n  .result small { display: block; opacity: .9; font-size: 12px; }\n  .result b { display: block; font-size: 40px; line-height: 1.15; font-variant-numeric: tabular-nums; }\n  .result span { font-size: 12px; opacity: .95; }\n  .card { background: #1f2937; border-radius: 14px; padding: 12px 14px; margin-bottom: 12px; }\n  .card h2 { font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: #9ca3af; margin: 0 0 8px; font-weight: 600; }\n  .bill { display: flex; align-items: center; gap: 6px; font-size: 26px; font-weight: 700; }\n  .bill input { flex: 1; min-width: 0; background: none; border: 0; border-bottom: 2px solid #374151; color: inherit; font: inherit; padding: 2px 0; font-variant-numeric: tabular-nums; }\n  .bill input:focus { outline: none; border-color: #10b981; }\n  .tips { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; }\n  .tips button { border: 1px solid #374151; background: #111827; color: inherit; border-radius: 10px; padding: 8px 0; font: inherit; font-weight: 600; cursor: pointer; }\n  .tips button.on { background: #10b981; border-color: #10b981; color: #052e1f; }\n  .custom { display: grid; grid-template-columns: 1fr auto; gap: 8px; align-items: center; margin-top: 10px; font-size: 12px; color: #9ca3af; }\n  .custom input { width: 100%; accent-color: #10b981; }\n  .people { display: flex; align-items: center; justify-content: space-between; }\n  .people .n { font-size: 26px; font-weight: 700; min-width: 40px; text-align: center; }\n  .people button { width: 40px; height: 40px; border-radius: 50%; border: 1px solid #374151; background: #111827; color: inherit; font-size: 20px; cursor: pointer; }\n  .people button:disabled { opacity: .3; cursor: default; }\n  .dots { flex: 1; text-align: center; font-size: 18px; letter-spacing: 2px; overflow: hidden; white-space: nowrap; }\n  .toggle { display: flex; justify-content: space-between; align-items: center; cursor: pointer; }\n  .toggle input { width: 18px; height: 18px; accent-color: #10b981; }\n  dl { display: grid; grid-template-columns: 1fr auto; gap: 5px 10px; margin: 0; font-variant-numeric: tabular-nums; }\n  dt { color: #9ca3af; }\n  dd { margin: 0; text-align: right; font-weight: 600; }\n  dd.total, dt.total { border-top: 1px solid #374151; padding-top: 6px; color: #f8fafc; }\n  .warn { color: #fbbf24; font-size: 12px; margin: 6px 0 0; min-height: 16px; }\n</style>\n</head>\n<body>\n  <h1>Split the bill</h1>\n\n  <div class=\"result\">\n    <small>Each person pays</small>\n    <b id=\"each\"></b>\n    <span id=\"eachNote\"></span>\n  </div>\n\n  <div class=\"card\">\n    <h2>Bill</h2>\n    <div class=\"bill\"><span>$</span><input id=\"bill\" type=\"text\" inputmode=\"decimal\" value=\"186.40\" aria-label=\"Bill total in dollars\"></div>\n    <p class=\"warn\" id=\"warn\"></p>\n  </div>\n\n  <div class=\"card\">\n    <h2>Tip</h2>\n    <div class=\"tips\" id=\"tips\"><button data-tip=\"0\">0%</button><button data-tip=\"15\">15%</button><button data-tip=\"18\">18%</button><button data-tip=\"20\">20%</button><button data-tip=\"25\">25%</button></div>\n    <div class=\"custom\"><input id=\"tip\" type=\"range\" min=\"0\" max=\"35\" step=\"1\" value=\"18\" aria-label=\"Tip percentage\"><span id=\"tipOut\"></span></div>\n  </div>\n\n  <div class=\"card\">\n    <h2>People</h2>\n    <div class=\"people\"><button id=\"minus\" aria-label=\"One fewer\">−</button><span class=\"dots\" id=\"dots\"></span><span class=\"n\" id=\"n\"></span><button id=\"plus\" aria-label=\"One more\">+</button></div>\n  </div>\n\n  <div class=\"card\">\n    <label class=\"toggle\"><span>Round each share up to the next dollar</span><input type=\"checkbox\" id=\"round\"></label>\n  </div>\n\n  <div class=\"card\">\n    <h2>Breakdown</h2>\n    <dl>\n      <dt>Bill</dt><dd id=\"dBill\"></dd>\n      <dt id=\"tipLabel\">Tip</dt><dd id=\"dTip\"></dd>\n      <dt class=\"total\">Total</dt><dd class=\"total\" id=\"dTotal\"></dd>\n      <dt>Collected</dt><dd id=\"dCollected\"></dd>\n      <dt>Left over</dt><dd id=\"dExtra\"></dd>\n    </dl>\n  </div>\n\n<script>\n(function () {\n  var $ = function (id) { return document.getElementById(id); };\n  var people = 4;\n  var lastGoodCents = 18640;\n\n  // All arithmetic is in whole cents to avoid floating-point drift.\n  function money(cents) {\n    var sign = cents < 0 ? '-' : '';\n    cents = Math.abs(cents);\n    var dollars = Math.floor(cents / 100);\n    var rest = cents % 100;\n    return sign + '$' + dollars.toLocaleString('en-US') + '.' + (rest < 10 ? '0' : '') + rest;\n  }\n  function parseBill(text) {\n    var clean = text.replace(/[$,\\s]/g, '');\n    if (!/^[0-9]+(\\.[0-9]{0,2})?$/.test(clean)) { return null; }\n    return Math.round(parseFloat(clean) * 100);\n  }\n\n  function render() {\n    var parsed = parseBill($('bill').value);\n    if (parsed === null) { $('warn').textContent = 'Enter an amount such as 186.40. Showing the last valid bill.'; }\n    else { $('warn').textContent = ''; lastGoodCents = parsed; }\n    var bill = lastGoodCents;\n    var tipPct = parseInt($('tip').value, 10);\n    var roundUp = $('round').checked;\n\n    var tip = Math.round(bill * tipPct / 100);\n    var total = bill + tip;\n    var each = Math.ceil(total / people);\n    if (roundUp) { each = Math.ceil(each / 100) * 100; }\n    var collected = each * people;\n    var extra = collected - total;\n    var effective = bill > 0 ? (collected - bill) / bill * 100 : 0;\n\n    $('each').textContent = money(each);\n    $('eachNote').textContent = people + ' people · ' + tipPct + '% tip' + (roundUp ? ' · rounded up' : '');\n    $('tipOut').textContent = tipPct + '%';\n    $('n').textContent = String(people);\n    var dots = '';\n    for (var i = 0; i < people; i++) { dots += '🧑'; }\n    $('dots').textContent = dots;\n    $('minus').disabled = people <= 2;\n    $('plus').disabled = people >= 12;\n\n    var chips = $('tips').children;\n    for (var c = 0; c < chips.length; c++) { chips[c].className = parseInt(chips[c].getAttribute('data-tip'), 10) === tipPct ? 'on' : ''; }\n\n    $('dBill').textContent = money(bill);\n    $('tipLabel').textContent = 'Tip (' + tipPct + '%)';\n    $('dTip').textContent = money(tip);\n    $('dTotal').textContent = money(total);\n    $('dCollected').textContent = money(collected) + ' (' + people + ' × ' + money(each) + ')';\n    $('dExtra').textContent = extra === 0 ? 'Nothing' : money(extra) + (roundUp ? ' extra tip, ' + effective.toFixed(1) + '% in all' : ' from rounding to the cent');\n  }\n\n  $('bill').addEventListener('input', render);\n  $('tip').addEventListener('input', render);\n  $('round').addEventListener('change', render);\n  $('tips').addEventListener('click', function (e) {\n    var t = e.target.getAttribute('data-tip');\n    if (t === null) { return; }\n    $('tip').value = t;\n    render();\n  });\n  $('minus').addEventListener('click', function () { if (people > 2) { people -= 1; render(); } });\n  $('plus').addEventListener('click', function () { if (people < 12) { people += 1; render(); } });\n  render();\n})();\n</script>\n</body>\n</html>\n",
    "validation": {
      "valid": true,
      "checks": [
        "is one complete HTML document",
