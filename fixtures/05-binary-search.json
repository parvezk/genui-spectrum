  "html": {
    "document": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Binary search</title>\n<style>\n  * { box-sizing: border-box; }\n  body { margin: 0; padding: 16px; font: 14px/1.5 system-ui, -apple-system, \"Segoe UI\", sans-serif; color: #1e1b4b; background: #f5f3ff; }\n  h1 { font-size: 18px; margin: 0 0 4px; }\n  h2 { font-size: 14px; margin: 0 0 6px; }\n  .lead { margin: 0 0 12px; color: #4c4a6b; }\n  .card { background: #fff; border: 1px solid #ddd6fe; border-radius: 10px; padding: 12px; margin-bottom: 12px; }\n  .row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }\n  button { padding: 6px 12px; border-radius: 6px; border: 1px solid #c4b5fd; background: #fff; font: inherit; cursor: pointer; color: inherit; }\n  button.primary { background: #6d28d9; border-color: #6d28d9; color: #fff; }\n  button:disabled { opacity: .45; cursor: default; }\n  input[type=number] { width: 70px; padding: 5px 6px; border: 1px solid #c4b5fd; border-radius: 6px; font: inherit; }\n  .cells { display: grid; grid-template-columns: repeat(11, 1fr); gap: 3px; margin: 12px 0 2px; }\n  .cell { border: 1px solid #c4b5fd; border-radius: 6px; text-align: center; padding: 6px 0 2px; background: #fff; cursor: pointer; transition: all .25s; font: inherit; color: inherit; }\n  .cell b { display: block; font-size: 13px; }\n  .cell small { font-size: 9px; color: #8b88a8; }\n  .cell.out { opacity: .28; background: #eee; text-decoration: line-through; }\n  .cell.mid { background: #fde68a; border-color: #d97706; transform: translateY(-3px); }\n  .cell.found { background: #86efac; border-color: #16a34a; transform: translateY(-3px); }\n  .marks { display: grid; grid-template-columns: repeat(11, 1fr); gap: 3px; font-size: 10px; text-align: center; color: #6d28d9; font-weight: 700; min-height: 16px; }\n  ol { margin: 0; padding-left: 20px; }\n  ol li { margin-bottom: 4px; }\n  .muted { color: #8b88a8; }\n  .counts { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }\n  .count { background: #f5f3ff; border-radius: 8px; padding: 8px; }\n  .count b { font-size: 20px; display: block; }\n  .count small { color: #4c4a6b; }\n  input[type=range] { width: 100%; accent-color: #6d28d9; }\n  .growth b { color: #6d28d9; }\n</style>\n</head>\n<body>\n  <h1>Binary search</h1>\n  <p class=\"lead\">Check the middle of a sorted list, discard the half that cannot hold the target, repeat. Step through it, or click any value to search for that instead.</p>\n\n  <div class=\"card\">\n    <div class=\"row\">\n      <label for=\"target\">Target</label>\n      <input id=\"target\" type=\"number\" value=\"34\">\n      <button id=\"step\" class=\"primary\">Step</button>\n      <button id=\"reset\">Reset</button>\n    </div>\n    <div class=\"cells\" id=\"cells\"></div>\n    <div class=\"marks\" id=\"marks\"></div>\n  </div>\n\n  <div class=\"card\">\n    <div class=\"counts\">\n      <div class=\"count\"><b id=\"binCount\">0</b><small>comparisons so far (binary)</small></div>\n      <div class=\"count\"><b id=\"linCount\">8</b><small>comparisons a left-to-right scan needs</small></div>\n    </div>\n  </div>\n\n  <div class=\"card\">\n    <h2>What happened</h2>\n    <ol id=\"log\"></ol>\n    <p class=\"muted\" id=\"hint\">Press Step to make the first comparison.</p>\n  </div>\n\n  <div class=\"card growth\">\n    <h2>Why it is O(log n)</h2>\n    <p style=\"margin:0 0 8px\">Each comparison halves what is left, so the worst case is floor(log₂ n) + 1 comparisons. Drag to grow the list:</p>\n    <input id=\"size\" type=\"range\" min=\"1\" max=\"30\" value=\"10\" aria-label=\"List size as a power of two\">\n    <p style=\"margin:6px 0 0\">A sorted list of <b id=\"n\"></b> items needs at most <b id=\"maxSteps\"></b> comparisons. A linear scan could need all <b id=\"n2\"></b>.</p>\n  </div>\n\n<script>\n(function () {\n  var list = [3, 8, 12, 17, 21, 26, 30, 34, 41, 47, 52];\n  var $ = function (id) { return document.getElementById(id); };\n  var target, low, high, mid, comparisons, done, found, log;\n\n  var cells = $('cells');\n  var marks = $('marks');\n  list.forEach(function (v, i) {\n    var c = document.createElement('button');\n    c.type = 'button';\n    c.className = 'cell';\n    c.setAttribute('data-i', String(i));\n    var b = document.createElement('b');\n    b.textContent = String(v);\n    var s = document.createElement('small');\n    s.textContent = String(i);\n    c.appendChild(b);\n    c.appendChild(s);\n    cells.appendChild(c);\n    marks.appendChild(document.createElement('span'));\n  });\n\n  function reset() {\n    var t = parseInt($('target').value, 10);\n    target = isNaN(t) ? 34 : t;\n    low = 0;\n    high = list.length - 1;\n    mid = -1;\n    comparisons = 0;\n    done = false;\n    found = false;\n    log = [];\n    render();\n  }\n\n  function step() {\n    if (done) { return; }\n    mid = Math.floor((low + high) / 2);\n    comparisons += 1;\n    var v = list[mid];\n    if (v === target) {\n      found = true;\n      done = true;\n      log.push('low ' + low + ', high ' + high + ' → mid ' + mid + ' holds ' + v + '. Match! Found at index ' + mid + '.');\n    } else if (v < target) {\n      log.push('low ' + low + ', high ' + high + ' → mid ' + mid + ' holds ' + v + '. ' + v + ' < ' + target + ', so discard the left half.');\n      low = mid + 1;\n    } else {\n      log.push('low ' + low + ', high ' + high + ' → mid ' + mid + ' holds ' + v + '. ' + v + ' > ' + target + ', so discard the right half.');\n      high = mid - 1;\n    }\n    if (!done && low > high) {\n      done = true;\n      log.push('Nothing is left to check: ' + target + ' is not in the list.');\n    }\n    render();\n  }\n\n  function render() {\n    var cellNodes = cells.children;\n    var markNodes = marks.children;\n    for (var i = 0; i < list.length; i++) {\n      var out = i < low || i > high;\n      var isMid = i === mid;\n      cellNodes[i].className = 'cell' + (found && isMid ? ' found' : (isMid && comparisons > 0 ? ' mid' : (out ? ' out' : '')));\n      var label = '';\n      if (!done) {\n        if (i === low && i === high) { label = 'low=high'; }\n        else if (i === low) { label = 'low'; }\n        else if (i === high) { label = 'high'; }\n      }\n      markNodes[i].textContent = label;\n    }\n    $('binCount').textContent = String(comparisons);\n    var at = list.indexOf(target);\n    $('linCount').textContent = String(at === -1 ? list.length : at + 1);\n\n    var ol = $('log');\n    ol.textContent = '';\n    log.forEach(function (line) {\n      var li = document.createElement('li');\n      li.textContent = line;\n      ol.appendChild(li);\n    });\n    $('hint').textContent = done\n      ? (found ? 'Done in ' + comparisons + ' comparison' + (comparisons === 1 ? '' : 's') + '.' : 'Done: not found after ' + comparisons + ' comparisons.')\n      : (comparisons === 0 ? 'Press Step to make the first comparison.' : 'Press Step to continue.');\n    $('step').disabled = done;\n  }\n\n  function growth() {\n    var k = parseInt($('size').value, 10);\n    var n = Math.pow(2, k);\n    $('n').textContent = n.toLocaleString('en-US');\n    $('n2').textContent = n.toLocaleString('en-US');\n    $('maxSteps').textContent = String(k + 1);\n  }\n\n  $('step').addEventListener('click', step);\n  $('reset').addEventListener('click', reset);\n  $('target').addEventListener('input', reset);\n  cells.addEventListener('click', function (e) {\n    var t = e.target;\n    while (t && t !== cells && !t.classList.contains('cell')) { t = t.parentNode; }\n    if (!t || t === cells) { return; }\n    $('target').value = String(list[parseInt(t.getAttribute('data-i'), 10)]);\n    reset();\n  });\n  $('size').addEventListener('input', growth);\n  reset();\n  growth();\n})();\n</script>\n</body>\n</html>\n",
    "validation": {
