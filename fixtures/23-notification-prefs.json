  "html": {
    "document": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Notification preferences</title>\n<style>\n  * { box-sizing: border-box; }\n  body { margin: 0; padding: 16px 16px 84px; font: 14px/1.45 system-ui, -apple-system, \"Segoe UI\", sans-serif; color: #1d1d1f; background: #f5f5f7; }\n  h1 { font-size: 20px; margin: 0 0 2px; }\n  .lead { margin: 0 0 14px; color: #6e6e73; font-size: 13px; }\n  .card { background: #fff; border-radius: 14px; padding: 4px 14px; margin-bottom: 14px; }\n  table { width: 100%; border-collapse: collapse; }\n  th { font-size: 11px; font-weight: 600; color: #6e6e73; text-transform: uppercase; letter-spacing: .04em; padding: 10px 0 6px; text-align: center; width: 56px; }\n  th:first-child { text-align: left; width: auto; }\n  th button { border: 0; background: none; font: inherit; color: inherit; cursor: pointer; text-transform: inherit; letter-spacing: inherit; padding: 0; text-decoration: underline dotted; }\n  td { padding: 10px 0; border-top: 1px solid #f0f0f2; text-align: center; vertical-align: middle; }\n  td:first-child { text-align: left; }\n  td b { display: block; font-weight: 600; }\n  td small { color: #6e6e73; font-size: 12px; }\n  .sw { position: relative; display: inline-block; width: 40px; height: 24px; cursor: pointer; }\n  .sw input { position: absolute; opacity: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }\n  .sw i { position: absolute; inset: 0; border-radius: 12px; background: #d2d2d7; transition: background .2s; pointer-events: none; }\n  .sw i::after { content: \"\"; position: absolute; top: 2px; left: 2px; width: 20px; height: 20px; border-radius: 50%; background: #fff; box-shadow: 0 1px 2px rgba(0,0,0,.25); transition: left .2s; }\n  .sw input:checked + i { background: #34c759; }\n  .sw input:checked + i::after { left: 18px; }\n  .sw input:focus-visible + i { outline: 2px solid #0071e3; outline-offset: 2px; }\n  .row { display: flex; justify-content: space-between; align-items: center; padding: 12px 0; }\n  .row + .row, .times, .dayline { border-top: 1px solid #f0f0f2; }\n  .times { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; padding: 12px 0; }\n  .times label { font-size: 12px; color: #6e6e73; display: block; }\n  .times input { width: 100%; padding: 7px 8px; border: 1px solid #d2d2d7; border-radius: 8px; font: inherit; margin-top: 3px; }\n  .times.off { opacity: .4; }\n  .dayline { padding: 12px 0; }\n  .track { position: relative; height: 14px; border-radius: 7px; background: #e8f8ec; overflow: hidden; }\n  .track i { position: absolute; top: 0; height: 100%; background: #1d1d1f; opacity: .8; }\n  .ticks { display: flex; justify-content: space-between; font-size: 10px; color: #6e6e73; margin-top: 3px; }\n  .dayline p { margin: 6px 0 0; font-size: 12px; color: #6e6e73; }\n  .footer { position: fixed; left: 0; right: 0; bottom: 0; background: rgba(255,255,255,.95); border-top: 1px solid #d2d2d7; padding: 10px 16px; display: flex; gap: 10px; align-items: center; }\n  .footer span { flex: 1; font-size: 12px; color: #6e6e73; }\n  .footer button { border: 0; border-radius: 10px; padding: 9px 16px; font: inherit; font-weight: 600; cursor: pointer; background: #0071e3; color: #fff; }\n  .footer button:disabled { background: #d2d2d7; cursor: default; }\n  .footer button.ghost { background: none; color: #0071e3; padding: 9px 4px; }\n</style>\n</head>\n<body>\n  <h1>Notifications</h1>\n  <p class=\"lead\">Choose how you hear about each kind of activity. Tap a column heading to switch that whole channel on or off.</p>\n\n  <div class=\"card\">\n    <table>\n      <thead><tr><th>Activity</th><th><button type=\"button\" data-col=\"email\">Email</button></th><th><button type=\"button\" data-col=\"push\">Push</button></th><th><button type=\"button\" data-col=\"sms\">SMS</button></th></tr></thead>\n      <tbody id=\"rows\"></tbody>\n    </table>\n  </div>\n\n  <div class=\"card\">\n    <div class=\"row\"><div><b>Quiet hours</b><br><small style=\"color:#6e6e73\">Hold push and SMS; email is not affected</small></div><label class=\"sw\"><input type=\"checkbox\" id=\"quiet\" aria-label=\"Quiet hours\"><i></i></label></div>\n    <div class=\"times\" id=\"times\">\n      <label>From<input type=\"time\" id=\"from\"></label>\n      <label>To<input type=\"time\" id=\"to\"></label>\n    </div>\n    <div class=\"dayline\">\n      <div class=\"track\" id=\"track\"></div>\n      <div class=\"ticks\"><span>00</span><span>06</span><span>12</span><span>18</span><span>24</span></div>\n      <p id=\"quietText\"></p>\n    </div>\n  </div>\n\n  <div class=\"footer\"><span id=\"status\"></span><button type=\"button\" class=\"ghost\" id=\"reset\">Reset</button><button type=\"button\" id=\"save\">Save</button></div>\n\n<script>\n(function () {\n  var $ = function (id) { return document.getElementById(id); };\n  var types = [\n    { id: 'mentions', label: 'Mentions', hint: 'Someone @mentions you' },\n    { id: 'dms', label: 'Direct messages', hint: 'A new private message' },\n    { id: 'digest', label: 'Weekly digest', hint: 'A summary once a week' },\n    { id: 'updates', label: 'Product updates', hint: 'New features and news' }\n  ];\n  var channels = ['email', 'push', 'sms'];\n  function defaults() {\n    return {\n      mentions: { email: true, push: true, sms: false },\n      dms: { email: false, push: true, sms: false },\n      digest: { email: true, push: false, sms: false },\n      updates: { email: true, push: false, sms: false },\n      quiet: true, from: '22:00', to: '07:00'\n    };\n  }\n  var prefs = defaults();\n  var saved = JSON.stringify(prefs);\n  var justSaved = false;\n\n  types.forEach(function (t) {\n    var tr = document.createElement('tr');\n    var name = document.createElement('td');\n    var b = document.createElement('b'); b.textContent = t.label;\n    var s = document.createElement('small'); s.textContent = t.hint;\n    name.appendChild(b); name.appendChild(s);\n    tr.appendChild(name);\n    channels.forEach(function (c) {\n      var td = document.createElement('td');\n      var label = document.createElement('label'); label.className = 'sw';\n      var input = document.createElement('input'); input.type = 'checkbox';\n      input.setAttribute('data-type', t.id); input.setAttribute('data-channel', c);\n      input.setAttribute('aria-label', t.label + ' by ' + c);\n      var knob = document.createElement('i');\n      label.appendChild(input); label.appendChild(knob);\n      td.appendChild(label);\n      tr.appendChild(td);\n    });\n    $('rows').appendChild(tr);\n  });\n\n  function minutes(hhmm) {\n    var p = hhmm.split(':');\n    return parseInt(p[0], 10) * 60 + parseInt(p[1], 10);\n  }\n\n  function render() {\n    var inputs = $('rows').querySelectorAll('input');\n    for (var i = 0; i < inputs.length; i++) {\n      inputs[i].checked = prefs[inputs[i].getAttribute('data-type')][inputs[i].getAttribute('data-channel')];\n    }\n    $('quiet').checked = prefs.quiet;\n    $('from').value = prefs.from;\n    $('to').value = prefs.to;\n    $('from').disabled = !prefs.quiet;\n    $('to').disabled = !prefs.quiet;\n    $('times').className = 'times' + (prefs.quiet ? '' : ' off');\n\n    var track = $('track');\n    track.textContent = '';\n    var text = 'Quiet hours are off. Push and SMS arrive at any time.';\n    if (prefs.quiet && prefs.from && prefs.to) {\n      var a = minutes(prefs.from), z = minutes(prefs.to), day = 1440;\n      var spans = a === z ? [] : (a < z ? [[a, z]] : [[a, day], [0, z]]);\n      spans.forEach(function (sp) {\n        var seg = document.createElement('i');\n        seg.style.left = (sp[0] / day * 100) + '%';\n        seg.style.width = ((sp[1] - sp[0]) / day * 100) + '%';\n        track.appendChild(seg);\n      });\n      var length = a === z ? 0 : (a < z ? z - a : day - a + z);\n      var hours = Math.floor(length / 60), mins = length % 60;\n      text = 'Quiet from ' + prefs.from + ' to ' + prefs.to + (a > z ? ' the next day' : '') + ': ' + hours + ' h' + (mins ? ' ' + mins + ' min' : '') + ' without push or SMS.';\n    }\n    $('quietText').textContent = text;\n\n    var dirty = JSON.stringify(prefs) !== saved;\n    $('save').disabled = !dirty;\n    var on = 0;\n    types.forEach(function (t) { channels.forEach(function (c) { if (prefs[t.id][c]) { on += 1; } }); });\n    $('status').textContent = dirty ? 'Unsaved changes · ' + on + ' of 12 switches on'\n      : (justSaved ? 'Saved on this page. A sandboxed page cannot store or send it.' : on + ' of 12 switches on');\n  }\n\n  $('rows').addEventListener('change', function (e) {\n    var t = e.target.getAttribute('data-type');\n    if (!t) { return; }\n    prefs[t][e.target.getAttribute('data-channel')] = e.target.checked;\n    justSaved = false;\n    render();\n  });\n  document.querySelector('thead').addEventListener('click', function (e) {\n    var c = e.target.getAttribute('data-col');\n    if (!c) { return; }\n    var allOn = types.every(function (t) { return prefs[t.id][c]; });\n    types.forEach(function (t) { prefs[t.id][c] = !allOn; });\n    justSaved = false;\n    render();\n  });\n  $('quiet').addEventListener('change', function () { prefs.quiet = $('quiet').checked; justSaved = false; render(); });\n  $('from').addEventListener('input', function () { prefs.from = $('from').value; justSaved = false; render(); });\n  $('to').addEventListener('input', function () { prefs.to = $('to').value; justSaved = false; render(); });\n  $('save').addEventListener('click', function () { saved = JSON.stringify(prefs); justSaved = true; render(); });\n  $('reset').addEventListener('click', function () { prefs = defaults(); justSaved = false; render(); });\n  render();\n})();\n</script>\n</body>\n</html>\n",
