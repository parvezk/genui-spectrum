    "document": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Service health</title>\n<style>\n  * { box-sizing: border-box; }\n  body { margin: 0; padding: 14px; font: 13px/1.45 ui-monospace, \"SF Mono\", Menlo, Consolas, monospace; color: #c9d1d9; background: #0b0f14; }\n  h1 { font: 700 17px system-ui, sans-serif; margin: 0 0 10px; color: #f0f6fc; }\n  .tiles { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 10px; }\n  .tile { background: #11161d; border: 1px solid #222a35; border-radius: 8px; padding: 8px 10px; }\n  .tile small { display: block; color: #7d8590; font-size: 10px; text-transform: uppercase; letter-spacing: .06em; }\n  .tile b { font-size: 20px; color: #f0f6fc; }\n  .tile.bad b { color: #ff7b72; } .tile.good b { color: #3fb950; }\n  .panel { background: #11161d; border: 1px solid #222a35; border-radius: 8px; padding: 10px; margin-bottom: 10px; }\n  .panel h2 { font: 600 12px system-ui, sans-serif; margin: 0 0 8px; color: #7d8590; text-transform: uppercase; letter-spacing: .06em; }\n  .slo { display: grid; grid-template-columns: 1fr auto; gap: 0 8px; margin-bottom: 6px; }\n  .slo input { grid-column: 1 / -1; width: 100%; accent-color: #58a6ff; }\n  .slo output { color: #58a6ff; font-weight: 700; }\n  table { width: 100%; border-collapse: collapse; }\n  th { text-align: right; font-weight: 500; color: #7d8590; font-size: 11px; padding: 4px; cursor: pointer; white-space: nowrap; user-select: none; }\n  th:first-child, td:first-child { text-align: left; }\n  th.sorted { color: #f0f6fc; }\n  td { padding: 7px 4px; border-top: 1px solid #222a35; text-align: right; vertical-align: middle; }\n  td .name { color: #f0f6fc; font-weight: 600; display: block; }\n  .pill { display: inline-block; font-size: 10px; padding: 0 6px; border-radius: 999px; font-weight: 700; }\n  .pill.ok { background: #12261e; color: #3fb950; } .pill.warn { background: #2e2a12; color: #d29922; } .pill.bad { background: #3a1616; color: #ff7b72; }\n  .over { color: #ff7b72; font-weight: 700; }\n  .near { color: #d29922; }\n  .gauge { position: relative; height: 4px; background: #222a35; border-radius: 2px; margin-top: 3px; min-width: 50px; }\n  .gauge i { position: absolute; left: 0; top: 0; height: 100%; border-radius: 2px; background: #3fb950; }\n  .gauge i.near { background: #d29922; } .gauge i.over { background: #ff7b72; }\n  .gauge u { position: absolute; top: -3px; width: 1px; height: 10px; background: #f0f6fc; }\n  .note { color: #7d8590; font: 12px system-ui, sans-serif; margin: 0; }\n</style>\n</head>\n<body>\n  <h1>Service health</h1>\n\n  <div class=\"tiles\">\n    <div class=\"tile bad\" id=\"tBad\"><small>Breaching SLO</small><b id=\"breaching\"></b></div>\n    <div class=\"tile good\"><small>Within SLO</small><b id=\"healthy\"></b></div>\n    <div class=\"tile\"><small>Slowest p95</small><b id=\"slowest\"></b></div>\n    <div class=\"tile\"><small>Highest error rate</small><b id=\"worstErr\"></b></div>\n  </div>\n\n  <div class=\"panel\">\n    <h2>SLO thresholds</h2>\n    <div class=\"slo\"><label for=\"p95\">p95 latency under</label><output id=\"p95Out\"></output><input id=\"p95\" type=\"range\" min=\"100\" max=\"500\" step=\"10\" value=\"300\"></div>\n    <div class=\"slo\"><label for=\"err\">Error rate under</label><output id=\"errOut\"></output><input id=\"err\" type=\"range\" min=\"0.2\" max=\"3\" step=\"0.1\" value=\"1\"></div>\n  </div>\n\n  <div class=\"panel\">\n    <h2>Services (click a column to sort)</h2>\n    <table>\n      <thead><tr>\n        <th data-key=\"name\">service</th><th data-key=\"p95\">p95 ms</th><th data-key=\"err\">err %</th><th data-key=\"up\">uptime %</th>\n      </tr></thead>\n      <tbody id=\"rows\"></tbody>\n    </table>\n  </div>\n  <p class=\"note\" id=\"note\"></p>\n\n<script>\n(function () {\n  var services = [\n    { name: 'api-gateway', p95: 120, err: 0.2, up: 99.98 },\n    { name: 'auth', p95: 85, err: 0.1, up: 99.99 },\n    { name: 'payments', p95: 340, err: 1.8, up: 99.71 },\n    { name: 'search', p95: 210, err: 0.6, up: 99.90 },\n    { name: 'notifications', p95: 95, err: 0.3, up: 99.95 }\n  ];\n  var sortKey = 'p95';\n  var sortDir = -1;\n  var $ = function (id) { return document.getElementById(id); };\n\n  function el(tag, cls, text) {\n    var n = document.createElement(tag);\n    if (cls) { n.className = cls; }\n    if (text !== undefined) { n.textContent = text; }\n    return n;\n  }\n  function level(value, limit) {\n    if (value >= limit) { return 'over'; }\n    if (value >= limit * 0.6) { return 'near'; }\n    return '';\n  }\n  function gauge(value, limit, scaleMax) {\n    var g = el('div', 'gauge');\n    var fill = el('i', level(value, limit));\n    fill.style.width = Math.min(100, value / scaleMax * 100) + '%';\n    var mark = el('u');\n    mark.style.left = Math.min(100, limit / scaleMax * 100) + '%';\n    g.appendChild(fill); g.appendChild(mark);\n    return g;\n  }\n\n  function render() {\n    var p95Limit = parseInt($('p95').value, 10);\n    var errLimit = parseFloat($('err').value);\n    $('p95Out').textContent = p95Limit + ' ms';\n    $('errOut').textContent = errLimit.toFixed(1) + '%';\n\n    var list = services.slice().sort(function (a, b) {\n      if (sortKey === 'name') { return a.name < b.name ? -sortDir : (a.name > b.name ? sortDir : 0); }\n      return (a[sortKey] - b[sortKey]) * sortDir;\n    });\n    var bad = [];\n    var body = $('rows');\n    body.textContent = '';\n    var p95Scale = Math.max(500, p95Limit);\n    var errScale = Math.max(3, errLimit);\n\n    list.forEach(function (s) {\n      var p95Level = level(s.p95, p95Limit);\n      var errLevel = level(s.err, errLimit);\n      var breach = p95Level === 'over' || errLevel === 'over';\n      var near = !breach && (p95Level === 'near' || errLevel === 'near');\n      if (breach) { bad.push(s.name); }\n\n      var tr = el('tr');\n      var c1 = el('td');\n      c1.appendChild(el('span', 'name', s.name));\n      c1.appendChild(el('span', 'pill ' + (breach ? 'bad' : (near ? 'warn' : 'ok')), breach ? 'BREACH' : (near ? 'WATCH' : 'OK')));\n      var c2 = el('td', p95Level, String(s.p95));\n      c2.appendChild(gauge(s.p95, p95Limit, p95Scale));\n      var c3 = el('td', errLevel, s.err.toFixed(1));\n      c3.appendChild(gauge(s.err, errLimit, errScale));\n      var c4 = el('td', '', s.up.toFixed(2));\n      [c1, c2, c3, c4].forEach(function (c) { tr.appendChild(c); });\n      body.appendChild(tr);\n    });\n\n    $('breaching').textContent = String(bad.length);\n    $('healthy').textContent = String(services.length - bad.length);\n    $('tBad').className = 'tile ' + (bad.length ? 'bad' : 'good');\n    var slow = services.reduce(function (a, b) { return b.p95 > a.p95 ? b : a; });\n    var errs = services.reduce(function (a, b) { return b.err > a.err ? b : a; });\n    $('slowest').textContent = slow.p95 + ' ms';\n    $('worstErr').textContent = errs.err.toFixed(1) + '%';\n    $('note').textContent = bad.length\n      ? 'Breaching: ' + bad.join(', ') + '. The white tick on each bar is the SLO limit.'\n      : 'Everything is within the SLO at these thresholds. The white tick on each bar is the limit.';\n\n    var heads = document.querySelectorAll('th');\n    for (var i = 0; i < heads.length; i++) {\n      var key = heads[i].getAttribute('data-key');\n      var base = heads[i].textContent.replace(/ [▲▼]$/, '');\n      heads[i].textContent = base + (key === sortKey ? (sortDir === 1 ? ' ▲' : ' ▼') : '');\n      heads[i].className = key === sortKey ? 'sorted' : '';\n    }\n  }\n\n  document.querySelector('thead').addEventListener('click', function (e) {\n    var key = e.target.getAttribute('data-key');\n    if (!key) { return; }\n    if (key === sortKey) { sortDir = -sortDir; }\n    else { sortKey = key; sortDir = key === 'name' || key === 'up' ? 1 : -1; }\n    render();\n  });\n  $('p95').addEventListener('input', render);\n  $('err').addEventListener('input', render);\n  render();\n})();\n</script>\n</body>\n</html>\n",
