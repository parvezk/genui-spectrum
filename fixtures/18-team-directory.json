  "html": {
    "document": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Team directory</title>\n<style>\n  * { box-sizing: border-box; }\n  body { margin: 0; padding: 16px; font: 14px/1.45 system-ui, -apple-system, \"Segoe UI\", sans-serif; color: #1f2328; background: #fff; }\n  h1 { font-size: 18px; margin: 0 0 10px; }\n  input[type=search] { width: 100%; padding: 8px 10px; border: 1px solid #d0d7de; border-radius: 8px; font: inherit; }\n  input[type=search]:focus { outline: 2px solid #0969da; border-color: transparent; }\n  .chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 10px 0; }\n  .chip { border: 1px solid #d0d7de; background: #f6f8fa; border-radius: 999px; padding: 3px 10px; font: inherit; font-size: 12px; cursor: pointer; color: inherit; }\n  .chip.on { background: #0969da; border-color: #0969da; color: #fff; }\n  .chip span { opacity: .7; margin-left: 3px; }\n  .meta { display: flex; justify-content: space-between; align-items: center; font-size: 12px; color: #656d76; margin-bottom: 6px; }\n  .meta button { border: 0; background: none; color: #0969da; font: inherit; cursor: pointer; padding: 0; }\n  table { width: 100%; border-collapse: collapse; }\n  th { text-align: left; font-size: 11px; text-transform: uppercase; letter-spacing: .04em; color: #656d76; padding: 6px 4px; border-bottom: 2px solid #d0d7de; cursor: pointer; user-select: none; white-space: nowrap; }\n  th.sorted { color: #1f2328; }\n  td { padding: 8px 4px; border-bottom: 1px solid #eaeef2; vertical-align: middle; }\n  .who { display: flex; align-items: center; gap: 8px; font-weight: 600; }\n  .avatar { width: 28px; height: 28px; border-radius: 50%; color: #fff; font-size: 11px; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; flex: none; }\n  .dept { display: inline-block; font-size: 11px; padding: 1px 8px; border-radius: 999px; color: #fff; }\n  mark { background: #fff8c5; padding: 0; }\n  .empty { text-align: center; color: #656d76; padding: 24px 0; }\n</style>\n</head>\n<body>\n  <h1>Team directory</h1>\n  <input id=\"q\" type=\"search\" placeholder=\"Search name, department or city\" aria-label=\"Search the directory\">\n  <div class=\"chips\" id=\"chips\"></div>\n  <div class=\"meta\"><span id=\"count\"></span><button id=\"clear\" type=\"button\">Clear filters</button></div>\n  <table>\n    <thead><tr><th data-key=\"name\">Name</th><th data-key=\"dept\">Department</th><th data-key=\"city\">City</th></tr></thead>\n    <tbody id=\"rows\"></tbody>\n  </table>\n  <div class=\"empty\" id=\"empty\" hidden>Nobody matches. Try a shorter search or clear the filters.</div>\n\n<script>\n(function () {\n  var people = [\n    { name: 'Ana Ruiz', dept: 'Engineering', city: 'Lisbon' },\n    { name: 'Ben Okafor', dept: 'Design', city: 'London' },\n    { name: 'Chloe Tan', dept: 'Engineering', city: 'Singapore' },\n    { name: 'Dev Patel', dept: 'Product', city: 'London' },\n    { name: 'Elena Rossi', dept: 'Marketing', city: 'Milan' },\n    { name: 'Farid Haddad', dept: 'Engineering', city: 'Berlin' },\n    { name: 'Grace Kim', dept: 'Design', city: 'Seoul' },\n    { name: 'Hugo Martin', dept: 'Sales', city: 'Paris' }\n  ];\n  var colors = { Engineering: '#0969da', Design: '#8250df', Product: '#1a7f37', Marketing: '#bf3989', Sales: '#bc4c00' };\n  var depts = ['Engineering', 'Design', 'Product', 'Marketing', 'Sales'];\n  var activeDept = null;\n  var sortKey = 'name';\n  var sortDir = 1;\n  var $ = function (id) { return document.getElementById(id); };\n\n  depts.forEach(function (d) {\n    var chip = document.createElement('button');\n    chip.type = 'button';\n    chip.className = 'chip';\n    chip.setAttribute('data-dept', d);\n    chip.appendChild(document.createTextNode(d));\n    var n = document.createElement('span');\n    n.textContent = String(people.filter(function (p) { return p.dept === d; }).length);\n    chip.appendChild(n);\n    $('chips').appendChild(chip);\n  });\n\n  // Append text to a node, wrapping the part that matches the search term in <mark>.\n  function highlight(node, text, term) {\n    var at = term ? text.toLowerCase().indexOf(term) : -1;\n    if (at === -1) { node.appendChild(document.createTextNode(text)); return; }\n    node.appendChild(document.createTextNode(text.slice(0, at)));\n    var m = document.createElement('mark');\n    m.textContent = text.slice(at, at + term.length);\n    node.appendChild(m);\n    node.appendChild(document.createTextNode(text.slice(at + term.length)));\n  }\n\n  function render() {\n    var term = $('q').value.trim().toLowerCase();\n    var list = people.filter(function (p) {\n      if (activeDept && p.dept !== activeDept) { return false; }\n      if (!term) { return true; }\n      return (p.name + ' ' + p.dept + ' ' + p.city).toLowerCase().indexOf(term) !== -1;\n    }).sort(function (a, b) {\n      var x = a[sortKey].toLowerCase(), y = b[sortKey].toLowerCase();\n      if (x === y) { return a.name < b.name ? -1 : 1; }\n      return (x < y ? -1 : 1) * sortDir;\n    });\n\n    var body = $('rows');\n    body.textContent = '';\n    list.forEach(function (p) {\n      var tr = document.createElement('tr');\n      var c1 = document.createElement('td');\n      var who = document.createElement('div'); who.className = 'who';\n      var av = document.createElement('span'); av.className = 'avatar';\n      av.style.background = colors[p.dept];\n      av.textContent = p.name.split(' ').map(function (w) { return w.charAt(0); }).join('');\n      var nm = document.createElement('span');\n      highlight(nm, p.name, term);\n      who.appendChild(av); who.appendChild(nm);\n      c1.appendChild(who);\n      var c2 = document.createElement('td');\n      var badge = document.createElement('span'); badge.className = 'dept';\n      badge.style.background = colors[p.dept];\n      badge.textContent = p.dept;\n      c2.appendChild(badge);\n      var c3 = document.createElement('td');\n      highlight(c3, p.city, term);\n      tr.appendChild(c1); tr.appendChild(c2); tr.appendChild(c3);\n      body.appendChild(tr);\n    });\n\n    $('empty').hidden = list.length > 0;\n    $('count').textContent = list.length + ' of ' + people.length + ' people' + (activeDept ? ' in ' + activeDept : '') + (term ? ' matching \"' + term + '\"' : '');\n    $('clear').hidden = !activeDept && !term;\n\n    var chips = $('chips').children;\n    for (var i = 0; i < chips.length; i++) {\n      var on = chips[i].getAttribute('data-dept') === activeDept;\n      chips[i].className = 'chip' + (on ? ' on' : '');\n      chips[i].setAttribute('aria-pressed', on ? 'true' : 'false');\n    }\n    var heads = document.querySelectorAll('th');\n    var labels = { name: 'Name', dept: 'Department', city: 'City' };\n    for (var h = 0; h < heads.length; h++) {\n      var key = heads[h].getAttribute('data-key');\n      heads[h].textContent = labels[key] + (key === sortKey ? (sortDir === 1 ? ' ▲' : ' ▼') : '');\n      heads[h].className = key === sortKey ? 'sorted' : '';\n    }\n  }\n\n  $('q').addEventListener('input', render);\n  $('chips').addEventListener('click', function (e) {\n    var t = e.target;\n    while (t && t !== $('chips') && !(t.getAttribute && t.getAttribute('data-dept'))) { t = t.parentNode; }\n    if (!t || t === $('chips')) { return; }\n    var d = t.getAttribute('data-dept');\n    activeDept = activeDept === d ? null : d;\n    render();\n  });\n  document.querySelector('thead').addEventListener('click', function (e) {\n    var key = e.target.getAttribute('data-key');\n    if (!key) { return; }\n    if (key === sortKey) { sortDir = -sortDir; } else { sortKey = key; sortDir = 1; }\n    render();\n  });\n  $('clear').addEventListener('click', function () {\n    activeDept = null;\n    $('q').value = '';\n    render();\n  });\n  render();\n})();\n</script>\n</body>\n</html>\n",
