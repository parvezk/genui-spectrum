  "html": {
    "document": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Compound interest</title>\n<style>\n  * { box-sizing: border-box; }\n  body { margin: 0; padding: 16px; font: 14px/1.5 system-ui, -apple-system, \"Segoe UI\", sans-serif; color: #1f2933; background: #f6f8f7; }\n  h1 { font-size: 18px; margin: 0 0 4px; }\n  .lead { margin: 0 0 12px; color: #52606d; }\n  .card { background: #fff; border: 1px solid #e1e7e4; border-radius: 10px; padding: 12px; margin-bottom: 12px; }\n  .inputs { display: grid; gap: 10px; }\n  .field { display: grid; grid-template-columns: 1fr auto; gap: 2px 8px; align-items: center; font-size: 13px; }\n  .field input[type=range] { grid-column: 1 / -1; width: 100%; accent-color: #0f766e; }\n  .field input[type=number] { width: 110px; padding: 4px 6px; border: 1px solid #cbd5d1; border-radius: 6px; font: inherit; text-align: right; }\n  .field output { font-weight: 600; color: #0f766e; }\n  .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 12px; }\n  .stat { background: #fff; border: 1px solid #e1e7e4; border-radius: 10px; padding: 10px; }\n  .stat.big { grid-column: 1 / -1; background: #0f766e; border-color: #0f766e; color: #fff; }\n  .stat small { display: block; font-size: 11px; opacity: .8; }\n  .stat b { font-size: 16px; }\n  .stat.big b { font-size: 24px; }\n  svg { width: 100%; height: auto; display: block; }\n  .axis { font-size: 9px; fill: #7b8794; }\n  .legend { display: flex; gap: 14px; font-size: 12px; color: #52606d; margin-top: 6px; }\n  .legend i { display: inline-block; width: 14px; height: 3px; vertical-align: middle; margin-right: 4px; border-radius: 2px; }\n  table { width: 100%; border-collapse: collapse; font-size: 13px; }\n  th, td { text-align: right; padding: 5px 6px; border-bottom: 1px solid #edf1ef; }\n  th:first-child, td:first-child { text-align: left; }\n  th { font-size: 11px; color: #7b8794; font-weight: 600; }\n  tr.last td { font-weight: 700; color: #0f766e; }\n</style>\n</head>\n<body>\n  <h1>Compound interest</h1>\n  <p class=\"lead\">Interest is added to the balance each year, so the next year's interest is earned on a bigger amount. Move the sliders to see it happen.</p>\n\n  <div class=\"card inputs\">\n    <div class=\"field\">\n      <label for=\"principal\">Starting amount ($)</label>\n      <input id=\"principal\" type=\"number\" min=\"0\" step=\"100\" value=\"5000\">\n    </div>\n    <div class=\"field\">\n      <label for=\"rate\">Yearly rate</label><output id=\"rateOut\"></output>\n      <input id=\"rate\" type=\"range\" min=\"0.5\" max=\"12\" step=\"0.5\" value=\"6\">\n    </div>\n    <div class=\"field\">\n      <label for=\"years\">Time</label><output id=\"yearsOut\"></output>\n      <input id=\"years\" type=\"range\" min=\"1\" max=\"40\" step=\"1\" value=\"20\">\n    </div>\n  </div>\n\n  <div class=\"stats\">\n    <div class=\"stat big\"><small>Final balance</small><b id=\"final\"></b></div>\n    <div class=\"stat\"><small>Interest earned</small><b id=\"interest\"></b></div>\n    <div class=\"stat\"><small>Extra vs simple interest</small><b id=\"extra\"></b></div>\n    <div class=\"stat\"><small>Money doubles every</small><b id=\"double\"></b></div>\n    <div class=\"stat\"><small>Interest in the final year</small><b id=\"lastYear\"></b></div>\n  </div>\n\n  <div class=\"card\">\n    <svg viewBox=\"0 0 340 180\" role=\"img\" aria-label=\"Balance over time, compound versus simple interest\">\n      <line x1=\"44\" y1=\"8\" x2=\"44\" y2=\"158\" stroke=\"#d5dcd9\"/>\n      <line x1=\"44\" y1=\"158\" x2=\"332\" y2=\"158\" stroke=\"#d5dcd9\"/>\n      <line x1=\"44\" y1=\"83\" x2=\"332\" y2=\"83\" stroke=\"#edf1ef\"/>\n      <text class=\"axis\" id=\"yMax\" x=\"40\" y=\"12\" text-anchor=\"end\"></text>\n      <text class=\"axis\" id=\"yMid\" x=\"40\" y=\"86\" text-anchor=\"end\"></text>\n      <text class=\"axis\" x=\"40\" y=\"161\" text-anchor=\"end\">$0</text>\n      <text class=\"axis\" x=\"44\" y=\"172\">Year 0</text>\n      <text class=\"axis\" id=\"xEnd\" x=\"332\" y=\"172\" text-anchor=\"end\"></text>\n      <path id=\"area\" fill=\"#0f766e\" opacity=\".12\"/>\n      <path id=\"lineSimple\" fill=\"none\" stroke=\"#9aa5b1\" stroke-width=\"2\" stroke-dasharray=\"4 3\"/>\n      <path id=\"lineCompound\" fill=\"none\" stroke=\"#0f766e\" stroke-width=\"2.5\"/>\n    </svg>\n    <div class=\"legend\"><span><i style=\"background:#0f766e\"></i>Compound</span><span><i style=\"background:#9aa5b1\"></i>Simple</span></div>\n  </div>\n\n  <div class=\"card\">\n    <table>\n      <thead><tr><th>Year</th><th>Balance</th><th>Interest that year</th></tr></thead>\n      <tbody id=\"rows\"></tbody>\n    </table>\n  </div>\n\n<script>\n(function () {\n  var $ = function (id) { return document.getElementById(id); };\n  var money = function (n) { return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); };\n  var money0 = function (n) { return '$' + Math.round(n).toLocaleString('en-US'); };\n\n  function render() {\n    var P = parseFloat($('principal').value);\n    if (isNaN(P) || P < 0) { P = 0; }\n    var r = parseFloat($('rate').value) / 100;\n    var years = parseInt($('years').value, 10);\n\n    $('rateOut').textContent = (r * 100).toFixed(1) + '%';\n    $('yearsOut').textContent = years + (years === 1 ? ' year' : ' years');\n\n    var compound = [];\n    var simple = [];\n    for (var y = 0; y <= years; y++) {\n      compound.push(P * Math.pow(1 + r, y));\n      simple.push(P * (1 + r * y));\n    }\n    var finalBalance = compound[years];\n\n    $('final').textContent = money(finalBalance);\n    $('interest').textContent = money(finalBalance - P);\n    $('extra').textContent = money(finalBalance - simple[years]);\n    $('double').textContent = (Math.log(2) / Math.log(1 + r)).toFixed(1) + ' years';\n    $('lastYear').textContent = money(compound[years] - compound[years - 1]);\n\n    var left = 44, right = 332, top = 8, bottom = 158;\n    var max = Math.max(finalBalance, 1);\n    var px = function (i) { return left + (right - left) * (i / years); };\n    var py = function (v) { return bottom - (bottom - top) * (v / max); };\n    var line = function (values) {\n      return values.map(function (v, i) { return (i === 0 ? 'M' : 'L') + px(i).toFixed(1) + ' ' + py(v).toFixed(1); }).join(' ');\n    };\n    $('lineCompound').setAttribute('d', line(compound));\n    $('lineSimple').setAttribute('d', line(simple));\n    $('area').setAttribute('d', line(compound) + ' L' + right + ' ' + bottom + ' L' + left + ' ' + bottom + ' Z');\n    $('yMax').textContent = money0(max);\n    $('yMid').textContent = money0(max / 2);\n    $('xEnd').textContent = 'Year ' + years;\n\n    var stepSize = years <= 10 ? 1 : (years <= 25 ? 5 : 10);\n    var body = $('rows');\n    body.textContent = '';\n    for (var n = 1; n <= years; n++) {\n      if (n !== 1 && n !== years && n % stepSize !== 0) { continue; }\n      var tr = document.createElement('tr');\n      if (n === years) { tr.className = 'last'; }\n      var cells = [String(n), money(compound[n]), money(compound[n] - compound[n - 1])];\n      for (var c = 0; c < cells.length; c++) {\n        var td = document.createElement('td');\n        td.textContent = cells[c];\n        tr.appendChild(td);\n      }\n      body.appendChild(tr);\n    }\n  }\n\n  $('principal').addEventListener('input', render);\n  $('rate').addEventListener('input', render);\n  $('years').addEventListener('input', render);\n  render();\n})();\n</script>\n</body>\n</html>\n",
