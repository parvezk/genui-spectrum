  "html": {
    "document": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>HTTP status codes</title>\n<style>\n  * { box-sizing: border-box; }\n  body { margin: 0; padding: 16px; font: 14px/1.5 system-ui, -apple-system, \"Segoe UI\", sans-serif; color: #e6edf3; background: #0d1117; }\n  h1 { font-size: 18px; margin: 0 0 4px; }\n  .lead { margin: 0 0 12px; color: #9da7b3; }\n  input[type=search] { width: 100%; padding: 8px 10px; border-radius: 8px; border: 1px solid #30363d; background: #161b22; color: inherit; font: inherit; }\n  input[type=search]:focus { outline: 2px solid #388bfd; border-color: transparent; }\n  .chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 10px 0 12px; }\n  .chip { border: 1px solid #30363d; background: #161b22; color: #9da7b3; border-radius: 999px; padding: 4px 10px; font: 600 12px ui-monospace, Menlo, monospace; cursor: pointer; }\n  .chip.on { color: #0d1117; border-color: transparent; }\n  .c1 { --c: #8b949e; } .c2 { --c: #3fb950; } .c3 { --c: #58a6ff; } .c4 { --c: #d29922; } .c5 { --c: #f85149; }\n  .chip.on { background: var(--c); }\n  .group h2 { font-size: 13px; margin: 14px 0 2px; color: var(--c); font-family: ui-monospace, Menlo, monospace; }\n  .group p.meaning { margin: 0 0 6px; color: #9da7b3; font-size: 12.5px; }\n  .code { display: block; width: 100%; text-align: left; background: #161b22; border: 1px solid #30363d; border-left: 3px solid var(--c); border-radius: 8px; padding: 8px 10px; margin-bottom: 6px; color: inherit; font: inherit; cursor: pointer; }\n  .code:hover { border-color: #484f58; border-left-color: var(--c); }\n  .code b { font-family: ui-monospace, Menlo, monospace; color: var(--c); margin-right: 8px; }\n  .code .more { display: none; margin-top: 6px; color: #9da7b3; font-size: 12.5px; }\n  .code.open .more { display: block; }\n  .code .fix { color: #e6edf3; }\n  .empty { color: #9da7b3; padding: 20px 0; text-align: center; }\n  .foot { margin-top: 14px; padding: 10px; border: 1px dashed #30363d; border-radius: 8px; color: #9da7b3; font-size: 12.5px; }\n</style>\n</head>\n<body>\n  <h1>HTTP status codes</h1>\n  <p class=\"lead\">The first digit is the class. Search by number or name, filter by class, and tap a code for what to do about it.</p>\n\n  <input id=\"q\" type=\"search\" placeholder=\"Try 404, gateway, redirect…\" aria-label=\"Search status codes\">\n  <div class=\"chips\" id=\"chips\"></div>\n  <div id=\"list\"></div>\n  <div class=\"foot\"><b>Rule of thumb:</b> a 4xx fails again until you change the request; a 5xx may succeed if you retry later.</div>\n\n<script>\n(function () {\n  var classes = {\n    1: { name: 'Informational', meaning: 'Request received, keep going. Interim responses.' },\n    2: { name: 'Success', meaning: 'The request was received, understood and accepted.' },\n    3: { name: 'Redirection', meaning: 'The client must look somewhere else to finish.' },\n    4: { name: 'Client error', meaning: 'The request itself is wrong. Fix it before retrying.' },\n    5: { name: 'Server error', meaning: 'The server failed to fulfil a valid request.' }\n  };\n  var codes = [\n    { code: 100, name: 'Continue', desc: 'Headers received; the client may send the body.', fix: 'Nothing to do. Clients that sent \"Expect: 100-continue\" now upload the body.' },\n    { code: 101, name: 'Switching Protocols', desc: 'The connection is being upgraded, for example to WebSocket.', fix: 'Nothing to do. Speak the new protocol on the same connection.' },\n    { code: 200, name: 'OK', desc: 'The standard success response, with a body.', fix: 'Use the response body.' },\n    { code: 201, name: 'Created', desc: 'A new resource was created, typically after POST.', fix: 'Read the Location header for the new resource URL.' },\n    { code: 204, name: 'No Content', desc: 'Success with nothing to return, common for DELETE.', fix: 'Do not try to parse a body; there is none.' },\n    { code: 301, name: 'Moved Permanently', desc: 'The resource has a new permanent URL.', fix: 'Follow the Location header and update stored links.' },\n    { code: 302, name: 'Found', desc: 'Temporary redirect.', fix: 'Follow the Location header but keep using the original URL next time.' },\n    { code: 304, name: 'Not Modified', desc: 'The cached copy is still valid; no body is sent.', fix: 'Serve the response from your cache.' },\n    { code: 400, name: 'Bad Request', desc: 'Malformed syntax or invalid parameters.', fix: 'Check the JSON, query string and required fields.' },\n    { code: 401, name: 'Unauthorized', desc: 'Not authenticated.', fix: 'Log in or send a valid token, then retry.' },\n    { code: 403, name: 'Forbidden', desc: 'Authenticated, but not allowed.', fix: 'Retrying will not help; you need different permissions.' },\n    { code: 404, name: 'Not Found', desc: 'Nothing exists at this URL.', fix: 'Check the path and the ID. The resource may have been deleted.' },\n    { code: 429, name: 'Too Many Requests', desc: 'Rate limited.', fix: 'Wait for the time in the Retry-After header, then back off.' },\n    { code: 500, name: 'Internal Server Error', desc: 'An unhandled failure on the server.', fix: 'Not your fault. Retry later and report it with the request ID.' },\n    { code: 502, name: 'Bad Gateway', desc: 'A proxy got an invalid response from upstream.', fix: 'Usually a deploy or crash upstream. Retry shortly.' },\n    { code: 503, name: 'Service Unavailable', desc: 'Overloaded or down for maintenance.', fix: 'Retry with backoff; honour Retry-After if present.' },\n    { code: 504, name: 'Gateway Timeout', desc: 'A proxy gave up waiting for upstream.', fix: 'Retry; if it persists the upstream service is too slow.' }\n  ];\n\n  var active = { 1: true, 2: true, 3: true, 4: true, 5: true };\n  var open = {};\n  var chips = document.getElementById('chips');\n  var list = document.getElementById('list');\n  var q = document.getElementById('q');\n\n  function el(tag, cls, text) {\n    var n = document.createElement(tag);\n    if (cls) { n.className = cls; }\n    if (text !== undefined) { n.textContent = text; }\n    return n;\n  }\n\n  [1, 2, 3, 4, 5].forEach(function (c) {\n    var chip = el('button', 'chip on c' + c, c + 'xx ' + classes[c].name);\n    chip.type = 'button';\n    chip.setAttribute('data-class', String(c));\n    chip.setAttribute('aria-pressed', 'true');\n    chips.appendChild(chip);\n  });\n\n  function render() {\n    var term = q.value.trim().toLowerCase();\n    list.textContent = '';\n    var shown = 0;\n    [1, 2, 3, 4, 5].forEach(function (c) {\n      if (!active[c]) { return; }\n      var matches = codes.filter(function (x) {\n        if (Math.floor(x.code / 100) !== c) { return false; }\n        if (!term) { return true; }\n        return String(x.code).indexOf(term) === 0 || (x.name + ' ' + x.desc).toLowerCase().indexOf(term) !== -1;\n      });\n      if (!matches.length) { return; }\n      var group = el('section', 'group c' + c);\n      group.appendChild(el('h2', '', c + 'xx · ' + classes[c].name));\n      group.appendChild(el('p', 'meaning', classes[c].meaning));\n      matches.forEach(function (x) {\n        var b = el('button', 'code' + (open[x.code] ? ' open' : ''));\n        b.type = 'button';\n        b.setAttribute('data-code', String(x.code));\n        b.setAttribute('aria-expanded', open[x.code] ? 'true' : 'false');\n        b.appendChild(el('b', '', String(x.code)));\n        b.appendChild(el('span', '', x.name));\n        var more = el('div', 'more');\n        more.appendChild(el('div', '', x.desc));\n        more.appendChild(el('div', 'fix', 'What to do: ' + x.fix));\n        b.appendChild(more);\n        group.appendChild(b);\n        shown += 1;\n      });\n      list.appendChild(group);\n    });\n    if (!shown) { list.appendChild(el('p', 'empty', 'No codes match. Try a number like 404 or a word like \"timeout\".')); }\n  }\n\n  chips.addEventListener('click', function (e) {\n    var t = e.target;\n    if (!t.getAttribute || !t.getAttribute('data-class')) { return; }\n    var c = parseInt(t.getAttribute('data-class'), 10);\n    active[c] = !active[c];\n    t.classList.toggle('on', active[c]);\n    t.setAttribute('aria-pressed', active[c] ? 'true' : 'false');\n    render();\n  });\n  list.addEventListener('click', function (e) {\n    var t = e.target;\n    while (t && t !== list && !(t.getAttribute && t.getAttribute('data-code'))) { t = t.parentNode; }\n    if (!t || t === list) { return; }\n    var code = t.getAttribute('data-code');\n    open[code] = !open[code];\n    render();\n  });\n  q.addEventListener('input', render);\n  render();\n})();\n</script>\n</body>\n</html>\n",
