  "html": {
    "document": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Sprint board</title>\n<style>\n  * { box-sizing: border-box; }\n  body { margin: 0; padding: 14px; font: 13px/1.4 system-ui, -apple-system, \"Segoe UI\", sans-serif; color: #172b4d; background: #0079bf; }\n  h1 { font-size: 18px; margin: 0; color: #fff; }\n  .top { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: space-between; margin-bottom: 8px; }\n  .top small { color: #dbeeff; }\n  .progress { height: 8px; background: rgba(255,255,255,.3); border-radius: 4px; overflow: hidden; margin-bottom: 10px; }\n  .progress i { display: block; height: 100%; width: 0; background: #61bd4f; transition: width .25s; }\n  .chips { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 10px; }\n  .chip { border: 0; border-radius: 999px; padding: 3px 10px; font: inherit; font-weight: 600; background: rgba(255,255,255,.25); color: #fff; cursor: pointer; }\n  .chip.on { background: #fff; color: #0079bf; }\n  .board { display: grid; grid-template-columns: repeat(4, minmax(132px, 1fr)); gap: 8px; overflow-x: auto; padding-bottom: 6px; }\n  .col { background: #ebecf0; border-radius: 8px; padding: 6px; min-height: 150px; }\n  .col.over { outline: 3px solid #fff; background: #dfe1e6; }\n  .col header { display: flex; justify-content: space-between; padding: 2px 4px 6px; font-weight: 700; }\n  .col header span { font-weight: 500; color: #5e6c84; font-size: 11px; }\n  .card { background: #fff; border-radius: 6px; padding: 7px 8px; margin-bottom: 6px; box-shadow: 0 1px 0 rgba(9,30,66,.25); cursor: grab; }\n  .card.dragging { opacity: .4; }\n  .card.hide { display: none; }\n  .card b { display: block; font-weight: 600; }\n  .meta { display: flex; justify-content: space-between; align-items: center; margin-top: 6px; color: #5e6c84; font-size: 11px; }\n  .who { display: inline-flex; align-items: center; gap: 4px; }\n  .who i { width: 16px; height: 16px; border-radius: 50%; display: inline-block; color: #fff; font-style: normal; font-size: 9px; font-weight: 700; text-align: center; line-height: 16px; }\n  .pts { background: #dfe1e6; border-radius: 999px; padding: 0 6px; font-weight: 700; color: #172b4d; }\n  .moves { display: flex; gap: 4px; margin-top: 6px; }\n  .moves button { flex: 1; border: 1px solid #dfe1e6; background: #f4f5f7; border-radius: 4px; font: inherit; font-size: 11px; cursor: pointer; padding: 1px 0; color: #172b4d; }\n  .moves button:disabled { opacity: .3; cursor: default; }\n  .hint { color: #dbeeff; font-size: 11px; margin: 4px 0 0; }\n</style>\n</head>\n<body>\n  <div class=\"top\"><h1>Sprint board</h1><small id=\"summary\"></small></div>\n  <div class=\"progress\"><i id=\"bar\"></i></div>\n  <div class=\"chips\" id=\"chips\"></div>\n  <div class=\"board\" id=\"board\"></div>\n  <p class=\"hint\">Drag a card to another column, or use the arrows. Points update as you go.</p>\n\n<script>\n(function () {\n  var columns = [\n    { id: 'todo', name: 'To do' },\n    { id: 'doing', name: 'In progress' },\n    { id: 'review', name: 'Review' },\n    { id: 'done', name: 'Done' }\n  ];\n  var tasks = [\n    { id: 't1', title: 'Add password reset', who: 'Maya', pts: 3, col: 0 },\n    { id: 't2', title: 'Write API docs', who: 'Tom', pts: 2, col: 0 },\n    { id: 't3', title: 'Checkout redesign', who: 'Priya', pts: 8, col: 1 },\n    { id: 't4', title: 'Fix login timeout', who: 'Maya', pts: 3, col: 1 },\n    { id: 't5', title: 'Upgrade Postgres', who: 'Tom', pts: 5, col: 1 },\n    { id: 't6', title: 'Search filters', who: 'Leo', pts: 5, col: 2 },\n    { id: 't7', title: 'Dark mode', who: 'Priya', pts: 5, col: 3 },\n    { id: 't8', title: 'Rate limiting', who: 'Leo', pts: 3, col: 3 }\n  ];\n  var colors = { Maya: '#eb5a46', Tom: '#0079bf', Priya: '#c377e0', Leo: '#ff9f1a' };\n  var filter = 'All';\n  var dragId = null;\n  var $ = function (id) { return document.getElementById(id); };\n\n  function el(tag, cls, text) {\n    var n = document.createElement(tag);\n    if (cls) { n.className = cls; }\n    if (text !== undefined) { n.textContent = text; }\n    return n;\n  }\n  function find(id) {\n    for (var i = 0; i < tasks.length; i++) { if (tasks[i].id === id) { return tasks[i]; } }\n    return null;\n  }\n\n  ['All', 'Maya', 'Tom', 'Priya', 'Leo'].forEach(function (name) {\n    var c = el('button', 'chip' + (name === 'All' ? ' on' : ''), name);\n    c.type = 'button';\n    c.setAttribute('data-who', name);\n    $('chips').appendChild(c);\n  });\n\n  function render() {\n    var board = $('board');\n    board.textContent = '';\n    var total = 0, done = 0;\n    columns.forEach(function (col, ci) {\n      var mine = tasks.filter(function (t) { return t.col === ci; });\n      var pts = mine.reduce(function (s, t) { return s + t.pts; }, 0);\n      total += pts;\n      if (ci === columns.length - 1) { done = pts; }\n      var box = el('div', 'col');\n      box.setAttribute('data-col', String(ci));\n      var head = el('header', '', col.name);\n      head.appendChild(el('span', '', mine.length + ' · ' + pts + ' pts'));\n      box.appendChild(head);\n      mine.forEach(function (t) {\n        var card = el('div', 'card' + (filter !== 'All' && t.who !== filter ? ' hide' : ''));\n        card.draggable = true;\n        card.setAttribute('data-id', t.id);\n        card.appendChild(el('b', '', t.title));\n        var meta = el('div', 'meta');\n        var who = el('span', 'who');\n        var dot = el('i', '', t.who.charAt(0));\n        dot.style.background = colors[t.who];\n        who.appendChild(dot);\n        who.appendChild(document.createTextNode(t.who));\n        meta.appendChild(who);\n        meta.appendChild(el('span', 'pts', String(t.pts)));\n        card.appendChild(meta);\n        var moves = el('div', 'moves');\n        var back = el('button', '', '←');\n        back.type = 'button'; back.disabled = ci === 0;\n        back.setAttribute('data-move', '-1'); back.setAttribute('aria-label', 'Move ' + t.title + ' back');\n        var fwd = el('button', '', '→');\n        fwd.type = 'button'; fwd.disabled = ci === columns.length - 1;\n        fwd.setAttribute('data-move', '1'); fwd.setAttribute('aria-label', 'Move ' + t.title + ' forward');\n        moves.appendChild(back); moves.appendChild(fwd);\n        card.appendChild(moves);\n        box.appendChild(card);\n      });\n      board.appendChild(box);\n    });\n    $('summary').textContent = tasks.length + ' tasks · ' + total + ' pts · ' + done + ' done (' + Math.round(done / total * 100) + '%)';\n    $('bar').style.width = (done / total * 100) + '%';\n  }\n\n  function closest(node, attr, stop) {\n    while (node && node !== stop) {\n      if (node.getAttribute && node.getAttribute(attr) !== null) { return node; }\n      node = node.parentNode;\n    }\n    return null;\n  }\n\n  var board = $('board');\n  board.addEventListener('click', function (e) {\n    var move = e.target.getAttribute && e.target.getAttribute('data-move');\n    if (!move) { return; }\n    var card = closest(e.target, 'data-id', board);\n    var t = card ? find(card.getAttribute('data-id')) : null;\n    if (!t) { return; }\n    t.col = Math.max(0, Math.min(columns.length - 1, t.col + parseInt(move, 10)));\n    render();\n  });\n  board.addEventListener('dragstart', function (e) {\n    var card = closest(e.target, 'data-id', board);\n    if (!card) { return; }\n    dragId = card.getAttribute('data-id');\n    card.classList.add('dragging');\n    if (e.dataTransfer) { e.dataTransfer.effectAllowed = 'move'; e.dataTransfer.setData('text/plain', dragId); }\n  });\n  board.addEventListener('dragover', function (e) {\n    var col = closest(e.target, 'data-col', board);\n    if (!col || !dragId) { return; }\n    e.preventDefault();\n    var cols = board.children;\n    for (var i = 0; i < cols.length; i++) { cols[i].classList.toggle('over', cols[i] === col); }\n  });\n  board.addEventListener('drop', function (e) {\n    var col = closest(e.target, 'data-col', board);\n    if (!col || !dragId) { return; }\n    e.preventDefault();\n    var t = find(dragId);\n    if (t) { t.col = parseInt(col.getAttribute('data-col'), 10); }\n    dragId = null;\n    render();\n  });\n  board.addEventListener('dragend', function () { dragId = null; render(); });\n\n  $('chips').addEventListener('click', function (e) {\n    var who = e.target.getAttribute('data-who');\n    if (!who) { return; }\n    filter = who;\n    var chips = $('chips').children;\n    for (var i = 0; i < chips.length; i++) { chips[i].className = 'chip' + (chips[i].getAttribute('data-who') === who ? ' on' : ''); }\n    render();\n  });\n\n  render();\n})();\n</script>\n</body>\n</html>\n",
    "validation": {
