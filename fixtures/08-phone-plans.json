  "html": {
    "document": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Phone plans compared</title>\n<style>\n  * { box-sizing: border-box; }\n  body { margin: 0; padding: 16px; font: 14px/1.5 system-ui, -apple-system, \"Segoe UI\", sans-serif; color: #172b4d; background: #f4f5f7; }\n  h1 { font-size: 18px; margin: 0 0 4px; }\n  .lead { margin: 0 0 12px; color: #5e6c84; }\n  .card { background: #fff; border: 1px solid #dfe1e6; border-radius: 10px; padding: 12px; margin-bottom: 12px; }\n  .slider { display: grid; grid-template-columns: 1fr auto; gap: 0 8px; margin-bottom: 8px; }\n  .slider input { grid-column: 1 / -1; width: 100%; accent-color: #0052cc; }\n  .slider output { font-weight: 700; color: #0052cc; }\n  .plan { position: relative; background: #fff; border: 2px solid #dfe1e6; border-radius: 10px; padding: 12px; margin-bottom: 10px; transition: border-color .2s; }\n  .plan.best { border-color: #00875a; }\n  .plan.out { opacity: .6; }\n  .plan header { display: flex; justify-content: space-between; align-items: baseline; }\n  .plan h2 { font-size: 16px; margin: 0; }\n  .plan .price { color: #5e6c84; font-size: 12px; }\n  .plan .feat { font-size: 12px; color: #5e6c84; margin: 2px 0 8px; }\n  .badge { display: none; position: absolute; top: -9px; right: 10px; background: #00875a; color: #fff; font-size: 10px; font-weight: 700; padding: 2px 8px; border-radius: 999px; text-transform: uppercase; letter-spacing: .05em; }\n  .plan.best .badge { display: block; }\n  .line { display: flex; justify-content: space-between; font-size: 13px; }\n  .line.total { font-weight: 700; font-size: 15px; margin-top: 4px; padding-top: 6px; border-top: 1px solid #ebecf0; }\n  .barwrap { height: 8px; background: #ebecf0; border-radius: 4px; overflow: hidden; margin-top: 8px; }\n  .barwrap i { display: block; height: 100%; background: #0052cc; width: 0; transition: width .25s; }\n  .plan.best .barwrap i { background: #00875a; }\n  .problem { color: #bf2600; font-size: 12px; font-weight: 600; margin-top: 6px; min-height: 0; }\n  .verdict { background: #e3fcef; border-color: #abf5d1; font-weight: 600; }\n</style>\n</head>\n<body>\n  <h1>Phone plans compared</h1>\n  <p class=\"lead\">Set to your usage: about 12 GB a month and two one-week trips abroad. Drag to see when the best plan changes.</p>\n\n  <div class=\"card\">\n    <div class=\"slider\"><label for=\"gb\">Data per month</label><output id=\"gbOut\"></output><input id=\"gb\" type=\"range\" min=\"1\" max=\"40\" value=\"12\"></div>\n    <div class=\"slider\"><label for=\"days\">Days abroad per year</label><output id=\"daysOut\"></output><input id=\"days\" type=\"range\" min=\"0\" max=\"90\" value=\"14\"></div>\n  </div>\n\n  <div class=\"card verdict\" id=\"verdict\"></div>\n  <div id=\"plans\"></div>\n\n<script>\n(function () {\n  var plans = [\n    { id: 'basic', name: 'Basic', price: 25, feat: '5 GB · extra data $10 per GB · no roaming' },\n    { id: 'plus', name: 'Plus', price: 40, feat: '20 GB · roaming $5 per day' },\n    { id: 'max', name: 'Max', price: 60, feat: 'Unlimited data · roaming included' }\n  ];\n  var $ = function (id) { return document.getElementById(id); };\n  var usd = function (n) { return '$' + Math.round(n).toLocaleString('en-US'); };\n\n  function cost(id, gb, days) {\n    if (id === 'basic') {\n      var over = Math.max(0, gb - 5);\n      return { monthly: 25 + over * 10, roaming: 0, roamText: days > 0 ? 'Not available' : 'None needed',\n               problem: days > 0 ? 'No service abroad on your ' + days + ' travel days' : '', detail: over > 0 ? over + ' GB over × $10' : 'Within 5 GB' };\n    }\n    if (id === 'plus') {\n      return { monthly: 40, roaming: days * 5, roamText: usd(days * 5), problem: gb > 20 ? 'You would run out: only 20 GB included' : '', detail: 'Within 20 GB' };\n    }\n    return { monthly: 60, roaming: 0, roamText: 'Included', problem: '', detail: 'Unlimited' };\n  }\n\n  var nodes = {};\n  plans.forEach(function (p) {\n    var el = document.createElement('div');\n    el.className = 'plan';\n    var badge = document.createElement('span'); badge.className = 'badge'; badge.textContent = 'Best for you';\n    var head = document.createElement('header');\n    var h = document.createElement('h2'); h.textContent = p.name;\n    var price = document.createElement('span'); price.className = 'price'; price.textContent = '$' + p.price + '/month';\n    head.appendChild(h); head.appendChild(price);\n    var feat = document.createElement('div'); feat.className = 'feat'; feat.textContent = p.feat;\n    var mk = function (label, cls) {\n      var line = document.createElement('div'); line.className = 'line' + (cls ? ' ' + cls : '');\n      var a = document.createElement('span'); a.textContent = label;\n      var b = document.createElement('span');\n      line.appendChild(a); line.appendChild(b);\n      return { line: line, label: a, value: b };\n    };\n    var monthly = mk('Monthly cost');\n    var roaming = mk('Roaming per year');\n    var total = mk('Per year', 'total');\n    var wrap = document.createElement('div'); wrap.className = 'barwrap';\n    var bar = document.createElement('i'); wrap.appendChild(bar);\n    var problem = document.createElement('div'); problem.className = 'problem';\n    [badge, head, feat, monthly.line, roaming.line, total.line, wrap, problem].forEach(function (n) { el.appendChild(n); });\n    $('plans').appendChild(el);\n    nodes[p.id] = { el: el, monthly: monthly, roaming: roaming, total: total, bar: bar, problem: problem };\n  });\n\n  function render() {\n    var gb = parseInt($('gb').value, 10);\n    var days = parseInt($('days').value, 10);\n    $('gbOut').textContent = gb + ' GB';\n    $('daysOut').textContent = days + (days === 1 ? ' day' : ' days');\n\n    var results = plans.map(function (p) {\n      var c = cost(p.id, gb, days);\n      c.id = p.id; c.name = p.name;\n      c.yearly = c.monthly * 12 + c.roaming;\n      return c;\n    });\n    var usable = results.filter(function (r) { return !r.problem; });\n    var best = usable.reduce(function (a, b) { return b.yearly < a.yearly ? b : a; });\n    var maxYearly = Math.max.apply(null, results.map(function (r) { return r.yearly; }));\n\n    results.forEach(function (r) {\n      var n = nodes[r.id];\n      n.monthly.label.textContent = 'Monthly cost (' + r.detail + ')';\n      n.monthly.value.textContent = usd(r.monthly);\n      n.roaming.value.textContent = r.roamText;\n      n.total.value.textContent = usd(r.yearly);\n      n.bar.style.width = (r.yearly / maxYearly * 100) + '%';\n      n.problem.textContent = r.problem;\n      n.el.classList.toggle('best', r.id === best.id);\n      n.el.classList.toggle('out', !!r.problem);\n    });\n\n    var others = usable.filter(function (r) { return r.id !== best.id; }).sort(function (a, b) { return a.yearly - b.yearly; });\n    var text = 'Best for you: ' + best.name + ' at ' + usd(best.yearly) + ' a year.';\n    if (others.length) { text += ' That is ' + usd(others[0].yearly - best.yearly) + ' less than ' + others[0].name + '.'; }\n    $('verdict').textContent = text;\n  }\n\n  $('gb').addEventListener('input', render);\n  $('days').addEventListener('input', render);\n  render();\n})();\n</script>\n</body>\n</html>\n",
    "validation": {
      "valid": true,
      "checks": [
