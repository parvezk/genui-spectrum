  "html": {
    "document": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>REST vs GraphQL</title>\n<style>\n  * { box-sizing: border-box; }\n  :root { --rest: #0e7490; --gql: #be185d; }\n  body { margin: 0; padding: 16px; font: 14px/1.5 system-ui, -apple-system, \"Segoe UI\", sans-serif; color: #1f2937; background: #f8fafc; }\n  h1 { font-size: 18px; margin: 0 0 4px; }\n  h2 { font-size: 14px; margin: 0 0 8px; }\n  .lead { margin: 0 0 12px; color: #64748b; }\n  .card { background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 12px; margin-bottom: 12px; }\n  .rest { color: var(--rest); } .gql { color: var(--gql); }\n  .lane { display: grid; grid-template-columns: 64px 1fr; gap: 8px; align-items: center; margin-bottom: 8px; font-size: 12px; }\n  .lane b { font-size: 13px; }\n  .track { position: relative; height: 54px; background: #f1f5f9; border-radius: 6px; overflow: hidden; }\n  .req { position: absolute; height: 14px; border-radius: 3px; width: 0; color: #fff; font-size: 10px; line-height: 14px; padding-left: 4px; white-space: nowrap; overflow: hidden; transition: width .5s linear; }\n  .track.rest .req { background: var(--rest); }\n  .track.gql .req { background: var(--gql); height: 22px; line-height: 22px; top: 16px; left: 0; }\n  .r1 { top: 3px; left: 0; } .r2 { top: 20px; left: 33.3%; transition-delay: .5s !important; } .r3 { top: 37px; left: 66.6%; transition-delay: 1s !important; }\n  .play .track.rest .req { width: 33.3%; }\n  .play .track.gql .req { width: 40%; }\n  .cap { font-size: 12px; color: #64748b; margin: 4px 0 0; }\n  button { padding: 6px 12px; border-radius: 6px; border: 1px solid #cbd5e1; background: #fff; font: inherit; cursor: pointer; }\n  .q { display: flex; gap: 10px; align-items: flex-start; padding: 7px 0; border-top: 1px solid #f1f5f9; cursor: pointer; }\n  .q:first-of-type { border-top: 0; }\n  .q input { margin-top: 3px; width: 16px; height: 16px; flex: none; }\n  .score { display: grid; grid-template-columns: 64px 1fr 24px; gap: 8px; align-items: center; margin-top: 6px; font-weight: 600; }\n  .meter { height: 10px; background: #f1f5f9; border-radius: 5px; overflow: hidden; }\n  .meter i { display: block; height: 100%; width: 0; transition: width .25s; }\n  .verdict { margin-top: 10px; padding: 10px; border-radius: 8px; background: #f1f5f9; font-weight: 600; }\n  table { width: 100%; border-collapse: collapse; font-size: 12.5px; }\n  th, td { text-align: left; vertical-align: top; padding: 6px; border-top: 1px solid #f1f5f9; }\n  th { font-size: 11px; text-transform: uppercase; letter-spacing: .04em; }\n  td:first-child { font-weight: 600; width: 26%; }\n  tr.hl td { background: #fefce8; }\n</style>\n</head>\n<body>\n  <h1>REST vs GraphQL for a mobile backend</h1>\n  <p class=\"lead\">See what loading one screen costs, then answer a few questions about your app to get a recommendation.</p>\n\n  <div class=\"card\" id=\"demo\">\n    <h2>Loading a profile screen (user + posts + followers)</h2>\n    <div class=\"lane\"><b class=\"rest\">REST</b>\n      <div class=\"track rest\"><span class=\"req r1\">GET /users/42</span><span class=\"req r2\">GET /users/42/posts</span><span class=\"req r3\">GET /users/42/followers</span></div>\n    </div>\n    <div class=\"lane\"><b class=\"gql\">GraphQL</b>\n      <div class=\"track gql\"><span class=\"req\">query { user { posts followers } }</span></div>\n    </div>\n    <button id=\"replay\">Replay</button>\n    <p class=\"cap\">Three sequential round trips versus one. On a cellular connection each round trip can cost 100–300 ms.</p>\n  </div>\n\n  <div class=\"card\">\n    <h2>Which fits your app?</h2>\n    <div id=\"questions\"></div>\n    <div class=\"score\"><span class=\"rest\">REST</span><div class=\"meter\"><i id=\"mRest\" style=\"background:var(--rest)\"></i></div><span id=\"sRest\">0</span></div>\n    <div class=\"score\"><span class=\"gql\">GraphQL</span><div class=\"meter\"><i id=\"mGql\" style=\"background:var(--gql)\"></i></div><span id=\"sGql\">0</span></div>\n    <div class=\"verdict\" id=\"verdict\"></div>\n  </div>\n\n  <div class=\"card\">\n    <h2>Side by side</h2>\n    <table>\n      <thead><tr><th></th><th class=\"rest\">REST</th><th class=\"gql\">GraphQL</th></tr></thead>\n      <tbody id=\"rows\"></tbody>\n    </table>\n    <p class=\"cap\">Rows tied to your answers are highlighted.</p>\n  </div>\n\n<script>\n(function () {\n  var questions = [\n    { text: 'Screens combine data from several resources (feeds, profiles, dashboards)', side: 'gql', points: 2, row: 1 },\n    { text: 'iOS, Android and web each need different fields', side: 'gql', points: 2, row: 1 },\n    { text: 'Many users are on slow or metered mobile networks', side: 'gql', points: 1, row: 1 },\n    { text: 'You need live updates (chat, presence, notifications)', side: 'gql', points: 1, row: 5 },\n    { text: 'The API is mostly simple CRUD on a few resources', side: 'rest', points: 2, row: 0 },\n    { text: 'You rely on HTTP or CDN caching for public content', side: 'rest', points: 2, row: 2 },\n    { text: 'Third parties will consume the API', side: 'rest', points: 1, row: 4 },\n    { text: 'The team is small and has not run GraphQL before', side: 'rest', points: 2, row: 6 }\n  ];\n  var rows = [\n    ['Shape', 'Many endpoints, one per resource', 'One endpoint, typed schema, client writes the query'],\n    ['Fetching a screen', 'Several round trips or a custom endpoint', 'One request with exactly the fields needed'],\n    ['Caching', 'HTTP and CDN caching just work', 'Harder; moves into the client library'],\n    ['Versioning', '/v1, /v2 or additive changes', 'Deprecate fields, no versions'],\n    ['Tooling', 'Optional OpenAPI; status codes map to dashboards', 'Introspection and generated types; errors need extra tooling'],\n    ['Real-time', 'Add WebSockets or SSE yourself', 'Subscriptions in the spec'],\n    ['Learning curve', 'Low', 'Higher: schema, resolvers, client cache']\n  ];\n  var $ = function (id) { return document.getElementById(id); };\n  var checked = questions.map(function () { return false; });\n\n  var qBox = $('questions');\n  questions.forEach(function (q, i) {\n    var label = document.createElement('label');\n    label.className = 'q';\n    var input = document.createElement('input');\n    input.type = 'checkbox';\n    input.setAttribute('data-i', String(i));\n    var span = document.createElement('span');\n    span.textContent = q.text;\n    label.appendChild(input);\n    label.appendChild(span);\n    qBox.appendChild(label);\n  });\n\n  var body = $('rows');\n  rows.forEach(function (r) {\n    var tr = document.createElement('tr');\n    r.forEach(function (text) {\n      var td = document.createElement('td');\n      td.textContent = text;\n      tr.appendChild(td);\n    });\n    body.appendChild(tr);\n  });\n\n  function render() {\n    var rest = 0, gql = 0, touched = {};\n    questions.forEach(function (q, i) {\n      if (!checked[i]) { return; }\n      if (q.side === 'rest') { rest += q.points; } else { gql += q.points; }\n      touched[q.row] = true;\n    });\n    $('sRest').textContent = String(rest);\n    $('sGql').textContent = String(gql);\n    $('mRest').style.width = (rest / 7 * 100) + '%';\n    $('mGql').style.width = (gql / 6 * 100) + '%';\n    var v;\n    if (rest === 0 && gql === 0) { v = 'Tick what applies to your app.'; }\n    else if (gql - rest >= 2) { v = 'Recommendation: GraphQL. Your screens and clients benefit from asking for exactly what they need.'; }\n    else if (rest - gql >= 2) { v = 'Recommendation: REST. Simpler to build, cache and operate for this kind of app.'; }\n    else { v = 'Close call: start with REST and add a GraphQL layer for the screens that aggregate data.'; }\n    $('verdict').textContent = v;\n    var trs = body.children;\n    for (var i = 0; i < trs.length; i++) { trs[i].className = touched[i] ? 'hl' : ''; }\n  }\n\n  qBox.addEventListener('change', function (e) {\n    var i = e.target.getAttribute('data-i');\n    if (i === null) { return; }\n    checked[parseInt(i, 10)] = e.target.checked;\n    render();\n  });\n\n  function play() {\n    var demo = $('demo');\n    demo.classList.remove('play');\n    // Force a reflow so the transition restarts.\n    void demo.offsetWidth;\n    demo.classList.add('play');\n  }\n  $('replay').addEventListener('click', play);\n\n  render();\n  setTimeout(play, 300);\n})();\n</script>\n</body>\n</html>\n",
    "validation": {
      "valid": true,
      "checks": [
        "is one complete HTML document",
        "makes no external requests (no remote src/href/url(), no fetch/XHR/WebSocket, no imports, no navigation)",
        "uses nothing that sandbox=\"allow-scripts\" blocks (storage, cookies, modals, popups, parent access, form submission)",
        "every inline script parses",
        "is interactive (has a script that listens for user input)"
      ],
      "errors": [],
      "warnings": []
    }
  },
