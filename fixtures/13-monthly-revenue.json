  "html": {
    "document": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Monthly revenue 2024</title>\n<style>\n  * { box-sizing: border-box; }\n  body { margin: 0; padding: 16px; font: 14px/1.5 system-ui, -apple-system, \"Segoe UI\", sans-serif; color: #111827; background: #f9fafb; }\n  h1 { font-size: 18px; margin: 0 0 10px; }\n  .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 12px; }\n  .stat { background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 8px 10px; }\n  .stat small { display: block; font-size: 11px; color: #6b7280; }\n  .stat b { font-size: 17px; }\n  .stat.best b { color: #047857; } .stat.worst b { color: #b91c1c; }\n  .card { background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 12px; margin-bottom: 12px; }\n  .bar { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-bottom: 8px; }\n  .seg { display: flex; border: 1px solid #d1d5db; border-radius: 6px; overflow: hidden; }\n  .seg button { border: 0; background: #fff; padding: 4px 10px; font: inherit; font-size: 12px; cursor: pointer; color: inherit; }\n  .seg button.on { background: #111827; color: #fff; }\n  label.tog { font-size: 12px; display: flex; gap: 4px; align-items: center; cursor: pointer; }\n  svg { width: 100%; height: auto; display: block; }\n  .axis { font-size: 9px; fill: #6b7280; }\n  .val { font-size: 9px; fill: #374151; text-anchor: middle; font-weight: 600; }\n  .b { fill: #93c5fd; cursor: pointer; transition: opacity .15s; }\n  .b.best { fill: #059669; } .b.worst { fill: #dc2626; }\n  .b.dim { opacity: .45; }\n  .b.sel { stroke: #111827; stroke-width: 1.5; }\n  .detail { min-height: 62px; }\n  .detail h2 { margin: 0 0 2px; font-size: 15px; }\n  .detail p { margin: 0; color: #4b5563; font-size: 13px; }\n  .up { color: #047857; font-weight: 600; } .down { color: #b91c1c; font-weight: 600; }\n  .legend { display: flex; gap: 12px; font-size: 11px; color: #6b7280; margin-top: 4px; flex-wrap: wrap; }\n  .legend i { display: inline-block; width: 9px; height: 9px; border-radius: 2px; margin-right: 3px; }\n</style>\n</head>\n<body>\n  <h1>Monthly revenue, 2024</h1>\n\n  <div class=\"stats\">\n    <div class=\"stat best\"><small>Best month</small><b>Dec · $80k</b></div>\n    <div class=\"stat worst\"><small>Worst month</small><b>Feb · $38k</b></div>\n    <div class=\"stat\"><small>Total</small><b>$683k</b></div>\n    <div class=\"stat\"><small>Monthly average</small><b>$56.9k</b></div>\n  </div>\n\n  <div class=\"card\">\n    <div class=\"bar\">\n      <div class=\"seg\" id=\"view\"><button data-view=\"month\" class=\"on\">Months</button><button data-view=\"quarter\">Quarters</button></div>\n      <label class=\"tog\"><input type=\"checkbox\" id=\"avg\" checked> Average line</label>\n    </div>\n    <svg id=\"chart\" viewBox=\"0 0 340 200\" role=\"img\" aria-label=\"Bar chart of revenue\">\n      <line x1=\"30\" y1=\"170\" x2=\"334\" y2=\"170\" stroke=\"#d1d5db\"/>\n      <g id=\"grid\"></g>\n      <g id=\"bars\"></g>\n      <line id=\"avgLine\" x1=\"30\" x2=\"334\" stroke=\"#111827\" stroke-dasharray=\"4 3\"/>\n      <text id=\"avgText\" class=\"axis\" x=\"334\" text-anchor=\"end\"></text>\n    </svg>\n    <div class=\"legend\"><span><i style=\"background:#059669\"></i>Best</span><span><i style=\"background:#dc2626\"></i>Worst</span><span><i style=\"background:#93c5fd\"></i>Other</span><span>Hover or tap a bar</span></div>\n  </div>\n\n  <div class=\"card detail\" id=\"detail\"></div>\n\n<script>\n(function () {\n  var months = [['Jan', 42], ['Feb', 38], ['Mar', 51], ['Apr', 47], ['May', 55], ['Jun', 61], ['Jul', 58], ['Aug', 49], ['Sep', 63], ['Oct', 67], ['Nov', 72], ['Dec', 80]];\n  var SVG = 'http://www.w3.org/2000/svg';\n  var $ = function (id) { return document.getElementById(id); };\n  var view = 'month';\n  var selected = 11;\n  var hover = -1;\n  var total = months.reduce(function (s, m) { return s + m[1]; }, 0);\n\n  function series() {\n    if (view === 'month') { return months.map(function (m) { return { label: m[0], value: m[1] }; }); }\n    var out = [];\n    for (var q = 0; q < 4; q++) {\n      out.push({ label: 'Q' + (q + 1), value: months[q * 3][1] + months[q * 3 + 1][1] + months[q * 3 + 2][1] });\n    }\n    return out;\n  }\n\n  function node(tag, attrs, text) {\n    var n = document.createElementNS(SVG, tag);\n    for (var k in attrs) { if (Object.prototype.hasOwnProperty.call(attrs, k)) { n.setAttribute(k, attrs[k]); } }\n    if (text !== undefined) { n.textContent = text; }\n    return n;\n  }\n\n  function render() {\n    var s = series();\n    var values = s.map(function (d) { return d.value; });\n    var max = Math.max.apply(null, values);\n    var min = Math.min.apply(null, values);\n    var mean = total / s.length;\n    var top = 16, bottom = 170, left = 30, right = 334;\n    var yMax = Math.ceil(max * 1.1 / 10) * 10;\n    var py = function (v) { return bottom - (bottom - top) * (v / yMax); };\n    var slot = (right - left) / s.length;\n    var active = hover !== -1 ? hover : selected;\n\n    var grid = $('grid');\n    while (grid.firstChild) { grid.removeChild(grid.firstChild); }\n    [0, yMax / 2, yMax].forEach(function (v) {\n      grid.appendChild(node('text', { 'class': 'axis', x: 26, y: py(v) + 3, 'text-anchor': 'end' }, '$' + Math.round(v) + 'k'));\n      if (v > 0) { grid.appendChild(node('line', { x1: left, x2: right, y1: py(v), y2: py(v), stroke: '#f3f4f6' })); }\n    });\n\n    var bars = $('bars');\n    while (bars.firstChild) { bars.removeChild(bars.firstChild); }\n    s.forEach(function (d, i) {\n      var cls = 'b' + (d.value === max ? ' best' : (d.value === min ? ' worst' : ''));\n      if (active !== -1 && i !== active) { cls += ' dim'; }\n      if (i === selected) { cls += ' sel'; }\n      var x = left + i * slot + slot * 0.14;\n      var w = slot * 0.72;\n      bars.appendChild(node('rect', { 'class': cls, 'data-i': i, x: x.toFixed(1), y: py(d.value).toFixed(1), width: w.toFixed(1), height: (bottom - py(d.value)).toFixed(1), rx: 2 }));\n      bars.appendChild(node('text', { 'class': 'val', x: (x + w / 2).toFixed(1), y: (py(d.value) - 3).toFixed(1) }, String(d.value)));\n      bars.appendChild(node('text', { 'class': 'axis', x: (x + w / 2).toFixed(1), y: 183, 'text-anchor': 'middle' }, d.label));\n    });\n\n    var showAvg = $('avg').checked;\n    $('avgLine').style.display = showAvg ? '' : 'none';\n    $('avgText').style.display = showAvg ? '' : 'none';\n    $('avgLine').setAttribute('y1', py(mean).toFixed(1));\n    $('avgLine').setAttribute('y2', py(mean).toFixed(1));\n    $('avgText').setAttribute('y', (py(mean) - 3).toFixed(1));\n    $('avgText').textContent = 'avg $' + mean.toFixed(1) + 'k';\n\n    var box = $('detail');\n    box.textContent = '';\n    var d = s[active];\n    var h = document.createElement('h2');\n    h.textContent = d.label + ': $' + d.value + 'k' + (d.value === max ? ' (best)' : (d.value === min ? ' (worst)' : ''));\n    box.appendChild(h);\n    var p1 = document.createElement('p');\n    if (active === 0) { p1.textContent = 'First ' + view + ' of the year.'; }\n    else {\n      var prev = s[active - 1];\n      var diff = d.value - prev.value;\n      var span = document.createElement('span');\n      span.className = diff >= 0 ? 'up' : 'down';\n      span.textContent = (diff >= 0 ? '+' : '−') + '$' + Math.abs(diff) + 'k (' + (diff >= 0 ? '+' : '−') + Math.abs(diff / prev.value * 100).toFixed(1) + '%)';\n      p1.appendChild(span);\n      p1.appendChild(document.createTextNode(' vs ' + prev.label));\n    }\n    box.appendChild(p1);\n    var p2 = document.createElement('p');\n    var vsAvg = d.value - mean;\n    p2.textContent = (d.value / total * 100).toFixed(1) + '% of the year · ' + (vsAvg >= 0 ? '$' + vsAvg.toFixed(1) + 'k above' : '$' + Math.abs(vsAvg).toFixed(1) + 'k below') + ' average';\n    box.appendChild(p2);\n  }\n\n  $('view').addEventListener('click', function (e) {\n    var v = e.target.getAttribute('data-view');\n    if (!v || v === view) { return; }\n    view = v;\n    selected = v === 'month' ? 11 : 3;\n    hover = -1;\n    var buttons = $('view').children;\n    for (var i = 0; i < buttons.length; i++) { buttons[i].className = buttons[i].getAttribute('data-view') === v ? 'on' : ''; }\n    render();\n  });\n  $('avg').addEventListener('change', render);\n  $('bars').addEventListener('click', function (e) {\n    var i = e.target.getAttribute('data-i');\n    if (i === null) { return; }\n    selected = parseInt(i, 10);\n    render();\n  });\n  $('bars').addEventListener('mouseover', function (e) {\n    var i = e.target.getAttribute('data-i');\n    if (i === null) { return; }\n    var n = parseInt(i, 10);\n    if (n !== hover) { hover = n; render(); }\n  });\n  $('chart').addEventListener('mouseleave', function () {\n    if (hover !== -1) { hover = -1; render(); }\n  });\n  render();\n})();\n</script>\n</body>\n</html>\n",
