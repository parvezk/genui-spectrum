  "html": {
    "document": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Scrum vs Kanban vs Waterfall</title>\n<style>\n  * { box-sizing: border-box; }\n  body { margin: 0; padding: 16px; font: 14px/1.5 system-ui, -apple-system, \"Segoe UI\", sans-serif; color: #242424; background: #f3f2f1; }\n  h1 { font-size: 18px; margin: 0 0 4px; }\n  h2 { font-size: 14px; margin: 0 0 8px; }\n  .lead { margin: 0 0 12px; color: #605e5c; }\n  .card { background: #fff; border: 1px solid #e1dfdd; border-radius: 10px; padding: 12px; margin-bottom: 12px; }\n  .q { margin-bottom: 10px; }\n  .q:last-child { margin-bottom: 0; }\n  .q p { margin: 0 0 4px; font-weight: 600; font-size: 13px; }\n  .seg { display: flex; border: 1px solid #c8c6c4; border-radius: 8px; overflow: hidden; }\n  .seg button { flex: 1; border: 0; border-left: 1px solid #c8c6c4; background: #fff; padding: 6px 4px; font: inherit; font-size: 12px; cursor: pointer; color: inherit; }\n  .seg button:first-child { border-left: 0; }\n  .seg button.on { background: #242424; color: #fff; }\n  .method { display: grid; grid-template-columns: 78px 1fr 30px; gap: 8px; align-items: center; margin-bottom: 6px; font-weight: 600; }\n  .meter { height: 14px; background: #f3f2f1; border-radius: 7px; overflow: hidden; }\n  .meter i { display: block; height: 100%; width: 0; border-radius: 7px; transition: width .3s; background: #8a8886; }\n  .method.win .meter i { background: #107c10; }\n  .method.win { color: #107c10; }\n  .verdict { margin-top: 10px; padding: 10px; border-radius: 8px; background: #dff6dd; }\n  .verdict b { display: block; }\n  .board { display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; font-size: 11px; }\n  .col { background: #f3f2f1; border-radius: 6px; padding: 4px; min-height: 86px; }\n  .col h3 { margin: 0 0 4px; font-size: 10px; text-transform: uppercase; letter-spacing: .04em; color: #605e5c; }\n  .tk { background: #fff; border: 1px solid #e1dfdd; border-radius: 4px; padding: 2px 4px; margin-bottom: 3px; }\n  .tk.bug { border-left: 3px solid #d13438; }\n  .hint { font-size: 12px; color: #605e5c; margin: 8px 0 0; }\n  table { width: 100%; border-collapse: collapse; font-size: 12px; }\n  th, td { text-align: left; vertical-align: top; padding: 5px; border-top: 1px solid #f3f2f1; }\n  th { color: #605e5c; font-weight: 600; }\n</style>\n</head>\n<body>\n  <h1>Scrum vs Kanban vs Waterfall</h1>\n  <p class=\"lead\">Preset for your team: six people, a live product, frequent urgent bug fixes. Change an answer to see how the recommendation moves.</p>\n\n  <div class=\"card\" id=\"questions\"></div>\n\n  <div class=\"card\">\n    <h2>Fit for this team</h2>\n    <div id=\"scores\"></div>\n    <div class=\"verdict\"><b id=\"vTitle\"></b><span id=\"vText\"></span></div>\n  </div>\n\n  <div class=\"card\">\n    <h2>How an urgent bug lands in <span id=\"boardName\"></span></h2>\n    <div class=\"board\" id=\"board\"></div>\n    <p class=\"hint\" id=\"boardHint\"></p>\n  </div>\n\n  <div class=\"card\">\n    <table>\n      <thead><tr><th></th><th>Scrum</th><th>Kanban</th><th>Waterfall</th></tr></thead>\n      <tbody>\n        <tr><td>Flow</td><td>Fixed sprints</td><td>Continuous</td><td>Sequential phases</td></tr>\n        <tr><td>Change priorities</td><td>Next sprint</td><td>Any time</td><td>Change request</td></tr>\n        <tr><td>Release</td><td>Each sprint</td><td>When done</td><td>Once, at the end</td></tr>\n        <tr><td>Metric</td><td>Velocity</td><td>Cycle time</td><td>Milestones</td></tr>\n      </tbody>\n    </table>\n  </div>\n\n<script>\n(function () {\n  // Points per answer, in the order [scrum, kanban, waterfall].\n  var questions = [\n    { text: 'How often does urgent work interrupt the plan?', pick: 2, options: [\n      ['Rarely', [2, 1, 2]], ['Weekly', [1, 2, 0]], ['Daily', [0, 3, 0]] ] },\n    { text: 'How stable are the requirements?', pick: 1, options: [\n      ['Fixed up front', [0, 0, 3]], ['Evolving', [2, 2, 0]], ['Changing constantly', [1, 3, 0]] ] },\n    { text: 'How do you release?', pick: 0, options: [\n      ['Continuously', [1, 3, 0]], ['Every 1–4 weeks', [3, 1, 0]], ['One big launch', [0, 0, 3]] ] },\n    { text: 'What is most of the work?', pick: 2, options: [\n      ['New features', [3, 1, 1]], ['A mix', [2, 2, 0]], ['Maintenance and bugs', [0, 3, 0]] ] }\n  ];\n  var names = ['Scrum', 'Kanban', 'Waterfall'];\n  var reasons = [\n    'Sprints give a steady rhythm for planned feature work. Reserve part of each sprint for the unexpected.',\n    'Continuous flow absorbs interruptions: add an expedite lane for urgent bugs and limit work in progress to about four items.',\n    'Stable scope and a single launch suit sequential phases. Make sure the requirements really are fixed.'\n  ];\n  var boards = [\n    { cols: [['Sprint backlog', ['Feature A', 'Feature B']], ['In progress', ['Feature C']], ['Review', ['Feature D']], ['Done', []]],\n      bugCol: 0, hint: 'The bug has to displace committed sprint work or wait for the next sprint. Either way the sprint goal is at risk.' },\n    { cols: [['Ready', ['Feature A', 'Feature B']], ['In progress (4)', ['Feature C']], ['Review (3)', ['Feature D']], ['Done', []]],\n      bugCol: 1, hint: 'The bug enters the expedite lane and is pulled straight into progress. Nothing else is re-planned.' },\n    { cols: [['Requirements', []], ['Design', []], ['Build', ['Feature A–D']], ['Test', []]],\n      bugCol: 0, hint: 'The bug becomes a change request that waits for the current phase, or the whole plan is re-baselined.' }\n  ];\n  var $ = function (id) { return document.getElementById(id); };\n\n  var qBox = $('questions');\n  questions.forEach(function (q, qi) {\n    var wrap = document.createElement('div'); wrap.className = 'q';\n    var p = document.createElement('p'); p.textContent = q.text;\n    var seg = document.createElement('div'); seg.className = 'seg';\n    q.options.forEach(function (opt, oi) {\n      var b = document.createElement('button');\n      b.type = 'button';\n      b.textContent = opt[0];\n      b.setAttribute('data-q', String(qi));\n      b.setAttribute('data-o', String(oi));\n      seg.appendChild(b);\n    });\n    wrap.appendChild(p); wrap.appendChild(seg);\n    qBox.appendChild(wrap);\n    q.seg = seg;\n  });\n\n  var rows = names.map(function (name) {\n    var row = document.createElement('div'); row.className = 'method';\n    var label = document.createElement('span'); label.textContent = name;\n    var meter = document.createElement('div'); meter.className = 'meter';\n    var fill = document.createElement('i'); meter.appendChild(fill);\n    var num = document.createElement('span');\n    row.appendChild(label); row.appendChild(meter); row.appendChild(num);\n    $('scores').appendChild(row);\n    return { row: row, fill: fill, num: num };\n  });\n\n  function render() {\n    var totals = [0, 0, 0];\n    questions.forEach(function (q) {\n      var pts = q.options[q.pick][1];\n      for (var i = 0; i < 3; i++) { totals[i] += pts[i]; }\n      var buttons = q.seg.children;\n      for (var b = 0; b < buttons.length; b++) {\n        buttons[b].className = b === q.pick ? 'on' : '';\n        buttons[b].setAttribute('aria-pressed', b === q.pick ? 'true' : 'false');\n      }\n    });\n    var best = 0;\n    for (var i = 1; i < 3; i++) { if (totals[i] > totals[best]) { best = i; } }\n    var tie = totals.filter(function (t) { return t === totals[best]; }).length > 1;\n    rows.forEach(function (r, i) {\n      r.fill.style.width = (totals[i] / 12 * 100) + '%';\n      r.num.textContent = String(totals[i]);\n      r.row.className = 'method' + (i === best && !tie ? ' win' : '');\n    });\n    $('vTitle').textContent = tie ? 'Too close to call' : 'Recommendation: ' + names[best];\n    $('vText').textContent = tie ? 'Two methods score the same. A hybrid such as Scrumban (sprint cadence, Kanban flow) is worth a look.' : reasons[best];\n\n    var board = boards[best];\n    $('boardName').textContent = names[best];\n    var box = $('board');\n    box.textContent = '';\n    board.cols.forEach(function (col, ci) {\n      var c = document.createElement('div'); c.className = 'col';\n      var h = document.createElement('h3'); h.textContent = col[0];\n      c.appendChild(h);\n      if (ci === board.bugCol) {\n        var bug = document.createElement('div'); bug.className = 'tk bug'; bug.textContent = 'Urgent bug';\n        c.appendChild(bug);\n      }\n      col[1].forEach(function (t) {\n        var k = document.createElement('div'); k.className = 'tk'; k.textContent = t;\n        c.appendChild(k);\n      });\n      box.appendChild(c);\n    });\n    $('boardHint').textContent = board.hint;\n  }\n\n  qBox.addEventListener('click', function (e) {\n    var q = e.target.getAttribute('data-q');\n    if (q === null) { return; }\n    questions[parseInt(q, 10)].pick = parseInt(e.target.getAttribute('data-o'), 10);\n    render();\n  });\n  render();\n})();\n</script>\n</body>\n</html>\n",
    "validation": {
