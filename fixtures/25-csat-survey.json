  "html": {
    "document": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>How did we do?</title>\n<style>\n  * { box-sizing: border-box; }\n  body { margin: 0; padding: 16px; font: 14px/1.5 system-ui, -apple-system, \"Segoe UI\", sans-serif; color: #2e1065; background: #faf5ff; }\n  h1 { font-size: 20px; margin: 0; }\n  .lead { margin: 2px 0 10px; color: #6b5b95; font-size: 13px; }\n  .progress { height: 6px; background: #e9d5ff; border-radius: 3px; overflow: hidden; margin-bottom: 14px; }\n  .progress i { display: block; height: 100%; width: 0; background: #7c3aed; transition: width .3s; }\n  .q { background: #fff; border: 1px solid #e9d5ff; border-radius: 14px; padding: 12px 14px; margin-bottom: 12px; }\n  .q h2 { font-size: 14px; margin: 0 0 8px; }\n  .q h2 span { color: #a78bfa; margin-right: 4px; }\n  .faces { display: flex; justify-content: space-between; }\n  .faces button { border: 2px solid transparent; background: none; border-radius: 12px; font-size: 28px; line-height: 1; padding: 6px 4px; cursor: pointer; filter: grayscale(1); opacity: .55; transition: transform .15s, opacity .15s, filter .15s; }\n  .faces button:hover { opacity: .9; transform: scale(1.1); }\n  .faces button.on { filter: none; opacity: 1; transform: scale(1.25); border-color: #e9d5ff; background: #faf5ff; }\n  .cap { display: flex; justify-content: space-between; font-size: 11px; color: #6b5b95; margin-top: 4px; }\n  .answer { text-align: center; font-weight: 600; min-height: 20px; margin-top: 2px; color: #7c3aed; }\n  .seg { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }\n  .seg button { border: 1px solid #d8b4fe; background: #fff; border-radius: 10px; padding: 8px 0; font: inherit; font-weight: 600; cursor: pointer; color: inherit; }\n  .seg button.on { background: #7c3aed; border-color: #7c3aed; color: #fff; }\n  .scale { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; }\n  .scale button { border: 1px solid #d8b4fe; background: #fff; border-radius: 10px; padding: 8px 0; font: inherit; font-weight: 600; cursor: pointer; color: inherit; }\n  .scale button.on { background: #7c3aed; border-color: #7c3aed; color: #fff; }\n  .nps { display: grid; grid-template-columns: repeat(11, 1fr); gap: 3px; }\n  .nps button { border: 1px solid #d8b4fe; background: #fff; border-radius: 6px; padding: 7px 0; font: inherit; font-size: 12px; font-weight: 600; cursor: pointer; color: inherit; }\n  .nps button.on.det { background: #dc2626; border-color: #dc2626; color: #fff; }\n  .nps button.on.pas { background: #d97706; border-color: #d97706; color: #fff; }\n  .nps button.on.pro { background: #16a34a; border-color: #16a34a; color: #fff; }\n  textarea { width: 100%; min-height: 70px; padding: 8px 10px; border: 1px solid #d8b4fe; border-radius: 10px; font: inherit; resize: vertical; color: inherit; }\n  .count { text-align: right; font-size: 11px; color: #6b5b95; }\n  .check { display: flex; gap: 8px; align-items: center; margin: 4px 0 12px; cursor: pointer; }\n  .send { width: 100%; border: 0; border-radius: 12px; padding: 12px; font: inherit; font-weight: 700; background: #7c3aed; color: #fff; cursor: pointer; }\n  .send:disabled { background: #d8b4fe; cursor: default; }\n  .hint { text-align: center; font-size: 12px; color: #6b5b95; margin: 6px 0 0; }\n  .thanks { text-align: center; padding: 30px 10px; }\n  .thanks div { font-size: 48px; }\n  .thanks h2 { margin: 6px 0; }\n  .thanks p { color: #6b5b95; margin: 0 0 12px; }\n  .thanks pre { text-align: left; background: #fff; border: 1px solid #e9d5ff; border-radius: 10px; padding: 10px; font-size: 12px; white-space: pre-wrap; }\n  .thanks button { border: 0; background: none; color: #7c3aed; text-decoration: underline; cursor: pointer; font: inherit; }\n  [hidden] { display: none !important; }\n</style>\n</head>\n<body>\n  <div id=\"formView\">\n    <h1>How did we do?</h1>\n    <p class=\"lead\">Five quick questions about your support chat.</p>\n    <div class=\"progress\"><i id=\"bar\"></i></div>\n\n    <div class=\"q\">\n      <h2><span>1</span>Overall, how satisfied are you with the support you received?</h2>\n      <div class=\"faces\" id=\"sat\"><button data-v=\"1\" aria-label=\"1, very dissatisfied\">😡</button><button data-v=\"2\" aria-label=\"2, dissatisfied\">🙁</button><button data-v=\"3\" aria-label=\"3, neutral\">😐</button><button data-v=\"4\" aria-label=\"4, satisfied\">🙂</button><button data-v=\"5\" aria-label=\"5, very satisfied\">😍</button></div>\n      <div class=\"answer\" id=\"satText\"></div>\n    </div>\n\n    <div class=\"q\">\n      <h2><span>2</span>Did we resolve your issue?</h2>\n      <div class=\"seg\" id=\"resolved\"><button data-v=\"yes\">Yes</button><button data-v=\"partly\">Partly</button><button data-v=\"no\">No</button></div>\n    </div>\n\n    <div class=\"q\">\n      <h2><span>3</span>How easy was it to get the help you needed?</h2>\n      <div class=\"scale\" id=\"effort\"><button data-v=\"1\">1</button><button data-v=\"2\">2</button><button data-v=\"3\">3</button><button data-v=\"4\">4</button><button data-v=\"5\">5</button></div>\n      <div class=\"cap\"><span>Very difficult</span><span>Very easy</span></div>\n    </div>\n\n    <div class=\"q\">\n      <h2><span>4</span>How likely are you to recommend us to a friend or colleague?</h2>\n      <div class=\"nps\" id=\"nps\"></div>\n      <div class=\"cap\"><span>Not at all likely</span><span>Extremely likely</span></div>\n    </div>\n\n    <div class=\"q\">\n      <h2><span>5</span><span id=\"commentLabel\" style=\"color:inherit\"></span></h2>\n      <textarea id=\"comment\" maxlength=\"500\" aria-labelledby=\"commentLabel\"></textarea>\n      <div class=\"count\" id=\"count\"></div>\n    </div>\n\n    <label class=\"check\"><input type=\"checkbox\" id=\"contact\"> You may contact me about my feedback</label>\n    <button type=\"button\" class=\"send\" id=\"send\">Send feedback</button>\n    <p class=\"hint\" id=\"hint\"></p>\n  </div>\n\n  <div class=\"thanks\" id=\"thanksView\" hidden>\n    <div id=\"thanksEmoji\"></div>\n    <h2 id=\"thanksTitle\"></h2>\n    <p id=\"thanksText\"></p>\n    <pre id=\"payload\"></pre>\n    <p>This page is sandboxed, so the answers above were not sent anywhere.</p>\n    <button type=\"button\" id=\"again\">Change my answers</button>\n  </div>\n\n<script>\n(function () {\n  var $ = function (id) { return document.getElementById(id); };\n  var a = { sat: null, resolved: null, effort: null, nps: null };\n  var satLabels = { 1: 'Very dissatisfied', 2: 'Dissatisfied', 3: 'Neutral', 4: 'Satisfied', 5: 'Very satisfied' };\n\n  for (var n = 0; n <= 10; n++) {\n    var b = document.createElement('button');\n    b.type = 'button';\n    b.textContent = String(n);\n    b.setAttribute('data-v', String(n));\n    b.className = n <= 6 ? 'det' : (n <= 8 ? 'pas' : 'pro');\n    $('nps').appendChild(b);\n  }\n\n  function mark(boxId, value) {\n    var kids = $(boxId).children;\n    for (var i = 0; i < kids.length; i++) {\n      var on = kids[i].getAttribute('data-v') === String(value);\n      kids[i].classList.toggle('on', on);\n      kids[i].setAttribute('aria-pressed', on ? 'true' : 'false');\n    }\n  }\n\n  function render() {\n    mark('sat', a.sat); mark('resolved', a.resolved); mark('effort', a.effort); mark('nps', a.nps);\n    $('satText').textContent = a.sat ? a.sat + ' of 5 · ' + satLabels[a.sat] : '';\n\n    var unhappy = (a.sat !== null && a.sat <= 2) || a.resolved === 'no';\n    var delighted = a.sat === 5 && a.resolved !== 'no';\n    $('commentLabel').textContent = unhappy ? 'Sorry about that. What went wrong?' : (delighted ? 'Great! What did we do well?' : 'Anything we could have done better? (optional)');\n    $('comment').placeholder = unhappy ? 'Tell us what happened so we can put it right' : 'Your thoughts';\n    $('count').textContent = $('comment').value.length + ' / 500';\n\n    var answered = 0;\n    if (a.sat !== null) { answered += 1; }\n    if (a.resolved !== null) { answered += 1; }\n    if (a.effort !== null) { answered += 1; }\n    if (a.nps !== null) { answered += 1; }\n    if ($('comment').value.trim()) { answered += 1; }\n    $('bar').style.width = (answered / 5 * 100) + '%';\n    $('send').disabled = a.sat === null;\n    $('hint').textContent = a.sat === null ? 'Answer question 1 to send. The rest are optional.' : answered + ' of 5 answered';\n  }\n\n  function pick(boxId, key, numeric) {\n    $(boxId).addEventListener('click', function (e) {\n      var v = e.target.getAttribute('data-v');\n      if (v === null) { return; }\n      var value = numeric ? parseInt(v, 10) : v;\n      a[key] = a[key] === value ? null : value;\n      render();\n    });\n  }\n  pick('sat', 'sat', true);\n  pick('resolved', 'resolved', false);\n  pick('effort', 'effort', true);\n  pick('nps', 'nps', true);\n  $('comment').addEventListener('input', render);\n\n  $('send').addEventListener('click', function () {\n    if (a.sat === null) { return; }\n    var happy = a.sat >= 4;\n    $('thanksEmoji').textContent = happy ? '🎉' : '🙏';\n    $('thanksTitle').textContent = happy ? 'Thank you!' : 'Thank you for telling us';\n    $('thanksText').textContent = happy ? 'We are glad the chat helped.' : 'We are sorry it was not better. ' + ($('contact').checked ? 'Someone will be in touch.' : 'We will review what happened.');\n    var result = {\n      satisfaction: a.sat,\n      resolved: a.resolved,\n      effort: a.effort,\n      recommend: a.nps,\n      comment: $('comment').value.trim(),\n      mayContact: $('contact').checked\n    };\n    $('payload').textContent = JSON.stringify(result, null, 2);\n    $('formView').hidden = true;\n    $('thanksView').hidden = false;\n  });\n  $('again').addEventListener('click', function () {\n    $('thanksView').hidden = true;\n    $('formView').hidden = false;\n  });\n  render();\n})();\n</script>\n</body>\n</html>\n",
    "validation": {
      "valid": true,
      "checks": [
        "is one complete HTML document",
        "makes no external requests (no remote src/href/url(), no fetch/XHR/WebSocket, no imports, no navigation)",
        "uses nothing that sandbox=\"allow-scripts\" blocks (storage, cookies, modals, popups, parent access, form submission)",
        "every inline script parses",
        "is interactive (has a script that listens for user input)"
      ],
      "errors": [],
      "warnings": []
    }
  },
