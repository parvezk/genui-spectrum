  "html": {
    "document": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Weekend city trip</title>\n<style>\n  * { box-sizing: border-box; }\n  body { margin: 0; padding: 16px; font: 14px/1.5 system-ui, -apple-system, \"Segoe UI\", sans-serif; color: #2d3142; background: linear-gradient(#eaf4ff, #fff 220px); }\n  h1 { font-size: 18px; margin: 0 0 4px; }\n  .lead { margin: 0 0 12px; color: #5c6178; }\n  .card { background: #fff; border: 1px solid #dfe3ee; border-radius: 12px; padding: 12px; margin-bottom: 12px; }\n  .weights { display: flex; justify-content: space-between; font-size: 12px; font-weight: 700; }\n  .weights .c { color: #2a6f4e; } .weights .w { color: #d9730d; }\n  input[type=range] { width: 100%; accent-color: #2d3142; }\n  .city { position: relative; background: #fff; border: 2px solid #dfe3ee; border-radius: 12px; padding: 12px; margin-bottom: 10px; transition: border-color .2s, transform .2s; }\n  .city.first { border-color: #2a6f4e; }\n  .city header { display: flex; justify-content: space-between; align-items: baseline; }\n  .city h2 { margin: 0; font-size: 16px; }\n  .city .place { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: #5c6178; }\n  .city.first .place { color: #2a6f4e; }\n  .facts { display: flex; gap: 14px; margin: 4px 0 8px; font-size: 13px; }\n  .facts b { font-size: 18px; }\n  .stack { display: flex; height: 16px; border-radius: 4px; overflow: hidden; background: #f1f3f8; }\n  .stack i { display: block; height: 100%; }\n  .f1 { background: #4c6ef5; } .f2 { background: #7950f2; } .f3 { background: #e64980; }\n  .key { display: flex; gap: 10px; font-size: 11px; color: #5c6178; margin-top: 4px; flex-wrap: wrap; }\n  .key i { display: inline-block; width: 8px; height: 8px; border-radius: 2px; margin-right: 3px; }\n  .score { display: grid; grid-template-columns: 44px 1fr 34px; gap: 6px; align-items: center; margin-top: 8px; font-size: 12px; font-weight: 700; }\n  .meter { height: 8px; background: #f1f3f8; border-radius: 4px; overflow: hidden; }\n  .meter i { display: block; height: 100%; background: #2d3142; transition: width .25s; }\n  .city.first .meter i { background: #2a6f4e; }\n  .verdict { background: #e6f4ec; border-color: #b7dcc6; font-weight: 600; }\n  .why { font-size: 12px; color: #5c6178; margin: 0; }\n</style>\n</head>\n<body>\n  <h1>A May weekend: Lisbon, Prague or Copenhagen?</h1>\n  <p class=\"lead\">Three nights, flights, hotel and food. You said cost matters most, then weather. Move the slider to change that balance.</p>\n\n  <div class=\"card\">\n    <div class=\"weights\"><span class=\"c\" id=\"wCost\"></span><span class=\"w\" id=\"wWeather\"></span></div>\n    <input id=\"weight\" type=\"range\" min=\"0\" max=\"100\" step=\"5\" value=\"70\" aria-label=\"How much cost matters compared with weather\">\n  </div>\n\n  <div class=\"card verdict\" id=\"verdict\"></div>\n  <div id=\"cities\"></div>\n  <p class=\"why\">Score = cost weight × how cheap (cheapest = 1, dearest = 0) + weather weight × how warm (warmest = 1, coolest = 0).</p>\n\n<script>\n(function () {\n  var NIGHTS = 3;\n  var cities = [\n    { name: 'Lisbon', flight: 180, hotel: 120, food: 45, high: 22 },\n    { name: 'Prague', flight: 140, hotel: 90, food: 35, high: 19 },\n    { name: 'Copenhagen', flight: 210, hotel: 190, food: 70, high: 16 }\n  ];\n  var $ = function (id) { return document.getElementById(id); };\n  var usd = function (n) { return '$' + Math.round(n).toLocaleString('en-US'); };\n\n  cities.forEach(function (c) {\n    c.hotelTotal = c.hotel * NIGHTS;\n    c.foodTotal = c.food * NIGHTS;\n    c.total = c.flight + c.hotelTotal + c.foodTotal;\n  });\n  var maxTotal = Math.max.apply(null, cities.map(function (c) { return c.total; }));\n  var minTotal = Math.min.apply(null, cities.map(function (c) { return c.total; }));\n  var maxHigh = Math.max.apply(null, cities.map(function (c) { return c.high; }));\n  var minHigh = Math.min.apply(null, cities.map(function (c) { return c.high; }));\n  cities.forEach(function (c) {\n    c.costScore = (maxTotal - c.total) / (maxTotal - minTotal);\n    c.weatherScore = (c.high - minHigh) / (maxHigh - minHigh);\n  });\n\n  var box = $('cities');\n  cities.forEach(function (c) {\n    var el = document.createElement('div'); el.className = 'city';\n    var head = document.createElement('header');\n    var h = document.createElement('h2'); h.textContent = c.name;\n    var place = document.createElement('span'); place.className = 'place';\n    head.appendChild(h); head.appendChild(place);\n\n    var facts = document.createElement('div'); facts.className = 'facts';\n    var cost = document.createElement('span');\n    var costB = document.createElement('b'); costB.textContent = usd(c.total);\n    cost.appendChild(costB); cost.appendChild(document.createTextNode(' total'));\n    var temp = document.createElement('span');\n    var tempB = document.createElement('b'); tempB.textContent = c.high + ' °C';\n    temp.appendChild(tempB); temp.appendChild(document.createTextNode(' avg high'));\n    facts.appendChild(cost); facts.appendChild(temp);\n\n    var stack = document.createElement('div'); stack.className = 'stack';\n    [['f1', c.flight], ['f2', c.hotelTotal], ['f3', c.foodTotal]].forEach(function (part) {\n      var seg = document.createElement('i'); seg.className = part[0];\n      seg.style.width = (part[1] / maxTotal * 100) + '%';\n      stack.appendChild(seg);\n    });\n    var key = document.createElement('div'); key.className = 'key';\n    [['f1', 'Flight ' + usd(c.flight)], ['f2', 'Hotel ' + usd(c.hotelTotal)], ['f3', 'Food ' + usd(c.foodTotal)]].forEach(function (part) {\n      var item = document.createElement('span');\n      var dot = document.createElement('i'); dot.className = part[0];\n      item.appendChild(dot); item.appendChild(document.createTextNode(part[1]));\n      key.appendChild(item);\n    });\n\n    var score = document.createElement('div'); score.className = 'score';\n    var sLabel = document.createElement('span'); sLabel.textContent = 'Score';\n    var meter = document.createElement('div'); meter.className = 'meter';\n    var fill = document.createElement('i'); meter.appendChild(fill);\n    var sNum = document.createElement('span');\n    score.appendChild(sLabel); score.appendChild(meter); score.appendChild(sNum);\n\n    [head, facts, stack, key, score].forEach(function (n) { el.appendChild(n); });\n    c.el = el; c.place = place; c.fill = fill; c.num = sNum;\n  });\n\n  function render() {\n    var w = parseInt($('weight').value, 10) / 100;\n    $('wCost').textContent = 'Cost ' + Math.round(w * 100) + '%';\n    $('wWeather').textContent = 'Weather ' + Math.round((1 - w) * 100) + '%';\n    cities.forEach(function (c) { c.score = w * c.costScore + (1 - w) * c.weatherScore; });\n    var ranked = cities.slice().sort(function (a, b) { return b.score - a.score; });\n    var labels = ['Best match', 'Runner-up', 'Third'];\n    ranked.forEach(function (c, i) {\n      c.place.textContent = labels[i];\n      c.el.className = 'city' + (i === 0 ? ' first' : '');\n      c.fill.style.width = (c.score * 100) + '%';\n      c.num.textContent = c.score.toFixed(2);\n      box.appendChild(c.el);\n    });\n    var a = ranked[0], b = ranked[1];\n    var text = 'Best match: ' + a.name + ' (' + usd(a.total) + ', ' + a.high + ' °C). ';\n    if (a.total < b.total) { text += 'It is ' + usd(b.total - a.total) + ' cheaper than ' + b.name + ', which is ' + (b.high - a.high) + ' °C warmer.'; }\n    else { text += 'It costs ' + usd(a.total - b.total) + ' more than ' + b.name + ' and is ' + (a.high - b.high) + ' °C warmer.'; }\n    $('verdict').textContent = text;\n  }\n\n  $('weight').addEventListener('input', render);\n  render();\n})();\n</script>\n</body>\n</html>\n",
    "validation": {
