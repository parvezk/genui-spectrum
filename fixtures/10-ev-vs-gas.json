  "html": {
    "document": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>EV vs gas: cost of ownership</title>\n<style>\n  * { box-sizing: border-box; }\n  :root { --ev: #059669; --gas: #dc2626; }\n  body { margin: 0; padding: 16px; font: 14px/1.5 system-ui, -apple-system, \"Segoe UI\", sans-serif; color: #1c1917; background: #fafaf9; }\n  h1 { font-size: 18px; margin: 0 0 4px; }\n  .lead { margin: 0 0 12px; color: #57534e; }\n  .card { background: #fff; border: 1px solid #e7e5e4; border-radius: 10px; padding: 12px; margin-bottom: 12px; }\n  .slider { display: grid; grid-template-columns: 1fr auto; gap: 0 8px; margin-bottom: 8px; }\n  .slider:last-child { margin-bottom: 0; }\n  .slider input { grid-column: 1 / -1; width: 100%; accent-color: #1c1917; }\n  .slider output { font-weight: 700; }\n  .totals { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 12px; }\n  .total { border-radius: 10px; padding: 10px; color: #fff; }\n  .total.ev { background: var(--ev); } .total.gas { background: var(--gas); }\n  .total small { display: block; opacity: .85; font-size: 11px; }\n  .total b { font-size: 20px; }\n  .total span { display: block; font-size: 11px; opacity: .9; }\n  .verdict { font-weight: 600; text-align: center; }\n  svg { width: 100%; height: auto; display: block; }\n  .axis { font-size: 9px; fill: #78716c; }\n  .legend { display: flex; gap: 14px; font-size: 12px; color: #57534e; margin-top: 6px; flex-wrap: wrap; }\n  .legend i { display: inline-block; width: 14px; height: 3px; vertical-align: middle; margin-right: 4px; border-radius: 2px; }\n  .small { font-size: 12px; color: #78716c; margin: 0; }\n</style>\n</head>\n<body>\n  <h1>EV vs gas: cost of ownership</h1>\n  <p class=\"lead\">$38,000 EV at $0.04 a mile and $400 a year, against a $30,000 gas car at $0.13 a mile and $900 a year. Drag to change mileage and how long you keep the car.</p>\n\n  <div class=\"card\">\n    <div class=\"slider\"><label for=\"miles\">Miles per year</label><output id=\"milesOut\"></output><input id=\"miles\" type=\"range\" min=\"4000\" max=\"25000\" step=\"500\" value=\"12000\"></div>\n    <div class=\"slider\"><label for=\"years\">Years of ownership</label><output id=\"yearsOut\"></output><input id=\"years\" type=\"range\" min=\"1\" max=\"12\" step=\"1\" value=\"5\"></div>\n  </div>\n\n  <div class=\"totals\">\n    <div class=\"total ev\"><small>EV total</small><b id=\"evTotal\"></b><span id=\"evRun\"></span></div>\n    <div class=\"total gas\"><small>Gas total</small><b id=\"gasTotal\"></b><span id=\"gasRun\"></span></div>\n  </div>\n\n  <div class=\"card verdict\" id=\"verdict\"></div>\n\n  <div class=\"card\">\n    <svg viewBox=\"0 0 340 190\" role=\"img\" aria-label=\"Cumulative cost of each car over twelve years\">\n      <line x1=\"46\" y1=\"10\" x2=\"46\" y2=\"160\" stroke=\"#d6d3d1\"/>\n      <line x1=\"46\" y1=\"160\" x2=\"332\" y2=\"160\" stroke=\"#d6d3d1\"/>\n      <text class=\"axis\" id=\"yTop\" x=\"42\" y=\"14\" text-anchor=\"end\"></text>\n      <text class=\"axis\" id=\"yBottom\" x=\"42\" y=\"163\" text-anchor=\"end\"></text>\n      <text class=\"axis\" x=\"46\" y=\"174\">Year 0</text>\n      <text class=\"axis\" x=\"332\" y=\"174\" text-anchor=\"end\">Year 12</text>\n      <rect id=\"window\" x=\"46\" y=\"10\" width=\"0\" height=\"150\" fill=\"#1c1917\" opacity=\".05\"/>\n      <path id=\"gasLine\" fill=\"none\" stroke=\"#dc2626\" stroke-width=\"2.5\"/>\n      <path id=\"evLine\" fill=\"none\" stroke=\"#059669\" stroke-width=\"2.5\"/>\n      <line id=\"beLine\" y1=\"10\" y2=\"160\" stroke=\"#1c1917\" stroke-dasharray=\"3 3\"/>\n      <text class=\"axis\" id=\"beLabel\" y=\"186\" text-anchor=\"middle\" style=\"font-weight:700; fill:#1c1917\"></text>\n    </svg>\n    <div class=\"legend\"><span><i style=\"background:var(--ev)\"></i>EV</span><span><i style=\"background:var(--gas)\"></i>Gas</span><span><i style=\"background:#1c1917\"></i>Break-even</span><span>Shaded: your ownership period</span></div>\n  </div>\n\n  <p class=\"small\">Not included: resale value, incentives, insurance, charger installation and financing.</p>\n\n<script>\n(function () {\n  var EV = { price: 38000, perMile: 0.04, maint: 400 };\n  var GAS = { price: 30000, perMile: 0.13, maint: 900 };\n  var MAX_YEARS = 12;\n  var $ = function (id) { return document.getElementById(id); };\n  var usd = function (n) { return '$' + Math.round(n).toLocaleString('en-US'); };\n\n  function render() {\n    var miles = parseInt($('miles').value, 10);\n    var years = parseInt($('years').value, 10);\n    $('milesOut').textContent = miles.toLocaleString('en-US');\n    $('yearsOut').textContent = years + (years === 1 ? ' year' : ' years');\n\n    var evRun = miles * EV.perMile + EV.maint;\n    var gasRun = miles * GAS.perMile + GAS.maint;\n    var evTotal = EV.price + years * evRun;\n    var gasTotal = GAS.price + years * gasRun;\n    var breakEven = (EV.price - GAS.price) / (gasRun - evRun);\n\n    $('evTotal').textContent = usd(evTotal);\n    $('gasTotal').textContent = usd(gasTotal);\n    $('evRun').textContent = usd(evRun) + ' a year to run';\n    $('gasRun').textContent = usd(gasRun) + ' a year to run';\n\n    var diff = gasTotal - evTotal;\n    var text;\n    if (Math.abs(diff) < 1) { text = 'Dead even after ' + years + ' years.'; }\n    else if (diff > 0) { text = 'EV is cheaper by ' + usd(diff) + ' after ' + years + (years === 1 ? ' year.' : ' years.'); }\n    else { text = 'Gas is cheaper by ' + usd(-diff) + ' after ' + years + (years === 1 ? ' year.' : ' years.'); }\n    text += ' Break-even at ' + breakEven.toFixed(1) + ' years (' + Math.round(breakEven * miles / 100) * 100 + ' miles).';\n    $('verdict').textContent = text;\n\n    var left = 46, right = 332, top = 10, bottom = 160;\n    var lo = 28000;\n    var hi = Math.max(EV.price + MAX_YEARS * evRun, GAS.price + MAX_YEARS * gasRun);\n    var px = function (y) { return left + (right - left) * (y / MAX_YEARS); };\n    var py = function (v) { return bottom - (bottom - top) * ((v - lo) / (hi - lo)); };\n    $('evLine').setAttribute('d', 'M' + px(0) + ' ' + py(EV.price).toFixed(1) + ' L' + px(MAX_YEARS) + ' ' + py(EV.price + MAX_YEARS * evRun).toFixed(1));\n    $('gasLine').setAttribute('d', 'M' + px(0) + ' ' + py(GAS.price).toFixed(1) + ' L' + px(MAX_YEARS) + ' ' + py(GAS.price + MAX_YEARS * gasRun).toFixed(1));\n    $('window').setAttribute('width', String(px(years) - left));\n    $('yTop').textContent = usd(hi);\n    $('yBottom').textContent = usd(lo);\n\n    var show = breakEven <= MAX_YEARS;\n    $('beLine').style.display = show ? '' : 'none';\n    $('beLabel').style.display = show ? '' : 'none';\n    if (show) {\n      var bx = px(breakEven);\n      $('beLine').setAttribute('x1', bx.toFixed(1));\n      $('beLine').setAttribute('x2', bx.toFixed(1));\n      $('beLabel').setAttribute('x', Math.min(Math.max(bx, 80), 300).toFixed(1));\n      $('beLabel').textContent = 'Break-even: ' + breakEven.toFixed(1) + ' years';\n    }\n  }\n\n  $('miles').addEventListener('input', render);\n  $('years').addEventListener('input', render);\n  render();\n})();\n</script>\n</body>\n</html>\n",
    "validation": {
      "valid": true,
      "checks": [
        "is one complete HTML document",
        "makes no external requests (no remote src/href/url(), no fetch/XHR/WebSocket, no imports, no navigation)",
        "uses nothing that sandbox=\"allow-scripts\" blocks (storage, cookies, modals, popups, parent access, form submission)",
        "every inline script parses",
        "is interactive (has a script that listens for user input)"
      ],
      "errors": [],
      "warnings": []
    }
  },
