{
  "toolCall": {
    "id": "call_binary_search_05",
    "name": "generateUserInterface",
    "arguments": {
      "description": "Show the four steps of binary search for 34 in the given sorted list as a read-only trace table (step, low, high, mid, value, decision), with one line on why it is O(log n). Then let the user ask for another target to be traced and choose a language for a code sample.",
      "data": {
        "list": [3, 8, 12, 17, 21, 26, 30, 34, 41, 47, 52],
        "target": 34,
        "trace": [
          { "step": 1, "low": 0, "high": 10, "mid": 5, "value": 26, "decision": "26 < 34: discard left half" },
          { "step": 2, "low": 6, "high": 10, "mid": 8, "value": 41, "decision": "41 > 34: discard right half" },
          { "step": 3, "low": 6, "high": 7, "mid": 6, "value": 30, "decision": "30 < 34: discard left half" },
          { "step": 4, "low": 7, "high": 7, "mid": 7, "value": 34, "decision": "Found at index 7" }
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "nextTarget": { "type": "integer", "minimum": 0, "maximum": 60 },
          "codeLanguage": { "type": "string", "enum": ["none", "python", "javascript", "java"] },
          "showRecursive": { "type": "boolean" }
        },
        "required": ["codeLanguage"]
      }
    }
  },
  "ui": {
    "schema": {
      "type": "object",
      "properties": {
        "trace": {
          "type": "array",
          "title": "Searching 3, 8, 12, 17, 21, 26, 30, 34, 41, 47, 52 for 34",
          "items": {
            "type": "object",
            "properties": {
              "step": { "type": "integer", "title": "Step" },
              "low": { "type": "integer", "title": "low" },
              "high": { "type": "integer", "title": "high" },
              "mid": { "type": "integer", "title": "mid" },
              "value": { "type": "integer", "title": "Value" },
              "decision": { "type": "string", "title": "Decision" }
            }
          }
        },
        "nextTarget": {
          "type": "integer",
          "title": "Trace another target (0–60, optional)",
          "minimum": 0,
          "maximum": 60
        },
        "codeLanguage": {
          "type": "string",
          "title": "Show the code in",
          "oneOf": [
            { "const": "none", "title": "No code, thanks" },
            { "const": "python", "title": "Python" },
            { "const": "javascript", "title": "JavaScript" },
            { "const": "java", "title": "Java" }
          ]
        },
        "showRecursive": { "type": "boolean", "title": "Also show the recursive version" }
      },
      "required": ["codeLanguage"]
    },
    "uiSchema": {
      "type": "VerticalLayout",
      "elements": [
        { "type": "Label", "text": "Binary search: 4 comparisons to find 34 among 11 values" },
        {
          "type": "Label",
          "text": "Each comparison halves what is left (11 → 5 → 2 → 1), so the worst case is floor(log₂ n) + 1 comparisons."
        },
        { "type": "Control", "scope": "#/properties/trace", "options": { "readonly": true } },
        {
          "type": "Group",
          "label": "Go further",
          "elements": [
            { "type": "Control", "scope": "#/properties/nextTarget" },
            { "type": "Control", "scope": "#/properties/codeLanguage" },
            {
              "type": "Control",
              "scope": "#/properties/showRecursive",
              "rule": {
                "effect": "HIDE",
                "condition": { "scope": "#/properties/codeLanguage", "schema": { "const": "none" } }
              }
            }
          ]
        }
      ]
    },
    "initialData": {
      "trace": [
        { "step": 1, "low": 0, "high": 10, "mid": 5, "value": 26, "decision": "26 < 34: discard left half" },
        { "step": 2, "low": 6, "high": 10, "mid": 8, "value": 41, "decision": "41 > 34: discard right half" },
        { "step": 3, "low": 6, "high": 7, "mid": 6, "value": 30, "decision": "30 < 34: discard left half" },
        { "step": 4, "low": 7, "high": 7, "mid": 7, "value": 34, "decision": "Found at index 7" }
      ],
      "codeLanguage": "python",
      "showRecursive": false
    }
  }
}
