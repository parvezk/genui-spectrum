{
  "toolCall": {
    "id": "call_csat_survey_25",
    "name": "generateUserInterface",
    "arguments": {
      "description": "Show a short post-chat satisfaction survey: overall satisfaction (1 to 5), whether the issue was resolved (yes, partly, no), how easy it was to get help (1 to 5), likelihood to recommend (0 to 10), an optional comment, and permission to follow up. If satisfaction is 1 or 2, ask what went wrong and make that answer required.",
      "data": {
        "channel": "support chat",
        "scale": { "satisfaction": [1, 5], "effort": [1, 5], "recommend": [0, 10] }
      },
      "output": {
        "type": "object",
        "properties": {
          "satisfaction": { "type": "integer", "minimum": 1, "maximum": 5 },
          "resolved": { "type": "string", "enum": ["yes", "partly", "no"] },
          "effort": { "type": "integer", "minimum": 1, "maximum": 5 },
          "recommend": { "type": "integer", "minimum": 0, "maximum": 10 },
          "whatWentWrong": { "type": "string", "minLength": 3, "maxLength": 500 },
          "comment": { "type": "string", "maxLength": 500 },
          "mayContact": { "type": "boolean" }
        },
        "required": ["satisfaction", "resolved"],
        "if": { "properties": { "satisfaction": { "maximum": 2 } }, "required": ["satisfaction"] },
        "then": { "required": ["whatWentWrong"] }
      }
    }
  },
  "ui": {
    "schema": {
      "type": "object",
      "properties": {
        "satisfaction": {
          "type": "integer",
          "title": "1. Overall, how satisfied are you with the support you received?",
          "oneOf": [
            { "const": 1, "title": "1 · Very dissatisfied" },
            { "const": 2, "title": "2 · Dissatisfied" },
            { "const": 3, "title": "3 · Neutral" },
            { "const": 4, "title": "4 · Satisfied" },
            { "const": 5, "title": "5 · Very satisfied" }
          ]
        },
        "whatWentWrong": { "type": "string", "title": "Sorry about that. What went wrong?", "minLength": 3, "maxLength": 500 },
        "resolved": {
          "type": "string",
          "title": "2. Did we resolve your issue?",
          "oneOf": [
            { "const": "yes", "title": "Yes" },
            { "const": "partly", "title": "Partly" },
            { "const": "no", "title": "No" }
          ]
        },
        "effort": {
          "type": "integer",
          "title": "3. How easy was it to get the help you needed? (1 = very difficult, 5 = very easy)",
          "minimum": 1,
          "maximum": 5,
          "default": 3
        },
        "recommend": {
          "type": "integer",
          "title": "4. How likely are you to recommend us? (0 = not at all, 10 = extremely)",
          "minimum": 0,
          "maximum": 10,
          "default": 8
        },
        "comment": { "type": "string", "title": "5. Anything else you would like to tell us? (optional)", "maxLength": 500 },
        "mayContact": { "type": "boolean", "title": "You may contact me about my feedback" }
      },
      "required": ["satisfaction", "resolved"],
      "if": { "properties": { "satisfaction": { "maximum": 2 } }, "required": ["satisfaction"] },
      "then": { "required": ["whatWentWrong"] }
    },
    "uiSchema": {
      "type": "VerticalLayout",
      "elements": [
        { "type": "Label", "text": "How did we do? Five quick questions about your support chat." },
        { "type": "Control", "scope": "#/properties/satisfaction", "options": { "format": "radio" } },
        {
          "type": "Control",
          "scope": "#/properties/whatWentWrong",
          "options": { "multi": true },
          "rule": {
            "effect": "SHOW",
            "condition": { "scope": "#/properties/satisfaction", "schema": { "maximum": 2 }, "failWhenUndefined": true }
          }
        },
        { "type": "Control", "scope": "#/properties/resolved", "options": { "format": "radio" } },
        { "type": "Control", "scope": "#/properties/effort", "options": { "slider": true } },
        { "type": "Control", "scope": "#/properties/recommend", "options": { "slider": true } },
        { "type": "Control", "scope": "#/properties/comment", "options": { "multi": true } },
        { "type": "Control", "scope": "#/properties/mayContact" }
      ]
    },
    "initialData": {
      "effort": 3,
      "recommend": 8,
      "mayContact": false
    }
  }
}
