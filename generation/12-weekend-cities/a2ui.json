          { "name": "Copenhagen", "high": 16, "rank": "Most expensive · coolest", "flight": 210, "hotelLabel": "Hotel, 3 × $190", "hotel": 570, "foodLabel": "Food, 3 × $70", "food": 210, "total": 990 }
        ]
      }
    }
  }
]
