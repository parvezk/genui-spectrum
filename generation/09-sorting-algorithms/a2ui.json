        { "id": "stable-note", "component": "Text", "variant": "caption", "text": "Stable means equal elements keep their original order, which matters when sorting records by one key after another." },

        { "id": "use-title", "component": "Text", "variant": "h4", "text": "When to use each" },
        {
          "id": "tabs",
          "component": "Tabs",
          "tabs": [
            { "title": "Bubble", "child": "bubble-col" },
            { "title": "Merge", "child": "merge-col" },
