          ]
        },
        { "id": "bubble-col", "component": "Column", "children": ["bubble-idea", "bubble-use", "bubble-avoid"] },
        { "id": "bubble-idea", "component": "Text", "text": "**How:** swap adjacent out-of-order pairs until a full pass makes no swaps." },
        { "id": "bubble-use", "component": "Text", "text": "**Use for:** teaching, or a dozen items that are already nearly sorted." },
        { "id": "bubble-avoid", "component": "Text", "text": "**Avoid for:** anything large. A million items means about 10¹² steps." },
        { "id": "merge-col", "component": "Column", "children": ["merge-idea", "merge-use", "merge-avoid"] },
        { "id": "merge-idea", "component": "Text", "text": "**How:** split in half, sort each half, merge the two sorted halves." },
        { "id": "merge-use", "component": "Text", "text": "**Use for:** guaranteed O(n log n), stable sorting, linked lists, and data too big for memory." },
        { "id": "merge-avoid", "component": "Text", "text": "**Avoid when:** memory is tight. It needs O(n) extra space." },
        { "id": "quick-col", "component": "Column", "children": ["quick-idea", "quick-use", "quick-avoid"] },
        { "id": "quick-idea", "component": "Text", "text": "**How:** pick a pivot, move smaller items left and larger right, recurse on each side." },
        { "id": "quick-use", "component": "Text", "text": "**Use for:** in-memory arrays. In place, cache-friendly and usually the fastest in practice." },
        { "id": "quick-avoid", "component": "Text", "text": "**Avoid when:** you need stability, or cannot randomise the pivot against the O(n²) worst case." },

        { "id": "library-card", "component": "Card", "child": "library-row" },
