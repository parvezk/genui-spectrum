[
  {
    "version": "v0.9.1",
    "createSurface": {
      "surfaceId": "flight-filters",
      "catalogId": "https://a2ui.org/specification/v0_9/catalogs/basic/catalog.json"
    }
  },
  {
    "version": "v0.9.1",
    "updateComponents": {
      "surfaceId": "flight-filters",
      "components": [
        { "id": "root", "component": "Column", "children": ["title", "route", "filters-card", "results-label", "flights"] },
        { "id": "title", "component": "Text", "variant": "h2", "text": "New York → Lisbon" },
        { "id": "route", "component": "Text", "variant": "caption", "text": "6 flights · filter, then pick one" },

        { "id": "filters-card", "component": "Card", "child": "filters-col" },
        { "id": "filters-col", "component": "Column", "children": ["price-slider", "price-readout", "stops-picker", "airline-picker", "apply-button"] },
        { "id": "price-slider", "component": "Slider", "label": "Maximum price", "min": 450, "max": 750, "value": { "path": "/filters/maxPrice" } },
        {
          "id": "price-readout",
          "component": "Text",
          "variant": "caption",
          "text": {
            "call": "formatString",
            "args": { "value": "Up to ${formatCurrency(value: ${/filters/maxPrice}, currency: 'USD', decimals: 0)}" },
            "returnType": "string"
          }
        },
        {
          "id": "stops-picker",
          "component": "ChoicePicker",
          "label": "Stops",
          "variant": "multipleSelection",
          "displayStyle": "chips",
          "options": [
            { "label": "Nonstop", "value": "nonstop" },
            { "label": "1 stop", "value": "one-stop" }
          ],
          "value": { "path": "/filters/stops" }
        },
        {
          "id": "airline-picker",
          "component": "ChoicePicker",
          "label": "Airlines",
          "variant": "multipleSelection",
          "displayStyle": "chips",
          "options": [
            { "label": "TAP", "value": "TAP" },
            { "label": "United", "value": "United" },
            { "label": "Delta", "value": "Delta" },
            { "label": "Iberia", "value": "Iberia" },
            { "label": "Air France", "value": "Air France" }
          ],
          "value": { "path": "/filters/airlines" }
        },
        {
          "id": "apply-button",
          "component": "Button",
          "child": "apply-label",
          "action": {
            "event": {
              "name": "apply_flight_filters",
              "context": {
                "maxPrice": { "path": "/filters/maxPrice" },
                "stops": { "path": "/filters/stops" },
                "airlines": { "path": "/filters/airlines" }
              }
            }
          }
        },
        { "id": "apply-label", "component": "Text", "text": "Apply filters" },

        { "id": "results-label", "component": "Text", "variant": "caption", "text": { "path": "/resultsLabel" } },
        { "id": "flights", "component": "List", "children": { "componentId": "flight-card", "path": "/flights" } },
        { "id": "flight-card", "component": "Card", "child": "flight-row" },
        { "id": "flight-row", "component": "Row", "align": "center", "children": ["flight-info", "flight-side"] },
        { "id": "flight-info", "component": "Column", "weight": 3, "children": ["flight-name", "flight-detail"] },
        {
          "id": "flight-name",
          "component": "Text",
          "variant": "h5",
          "text": { "call": "formatString", "args": { "value": "${airline} ${code}" }, "returnType": "string" }
        },
        {
          "id": "flight-detail",
          "component": "Text",
          "variant": "caption",
          "text": { "call": "formatString", "args": { "value": "Departs ${departs} · ${stops}" }, "returnType": "string" }
        },
        { "id": "flight-side", "component": "Column", "weight": 2, "align": "end", "children": ["flight-price", "flight-select"] },
        {
          "id": "flight-price",
          "component": "Text",
          "variant": "h4",
          "text": { "call": "formatCurrency", "args": { "value": { "path": "price" }, "currency": "USD", "decimals": 0 }, "returnType": "string" }
        },
        {
          "id": "flight-select",
          "component": "Button",
          "variant": "primary",
          "child": "flight-select-label",
          "action": {
            "event": {
              "name": "select_flight",
              "context": { "flight": { "path": "code" }, "airline": { "path": "airline" }, "price": { "path": "price" } }
            }
          }
        },
        { "id": "flight-select-label", "component": "Text", "text": "Select" }
      ]
    }
  },
  {
    "version": "v0.9.1",
    "updateDataModel": {
      "surfaceId": "flight-filters",
      "path": "/",
      "value": {
        "filters": {
          "maxPrice": 750,
          "stops": ["nonstop", "one-stop"],
          "airlines": ["TAP", "United", "Delta", "Iberia", "Air France"]
        },
        "resultsLabel": "Showing all 6 flights, cheapest first",
        "flights": [
          { "airline": "Iberia", "code": "IB6252", "stops": "1 stop", "departs": "21:40", "price": 480 },
          { "airline": "Delta", "code": "DL272", "stops": "1 stop", "departs": "16:05", "price": 520 },
          { "airline": "Air France", "code": "AF11", "stops": "1 stop", "departs": "19:00", "price": 560 },
          { "airline": "TAP", "code": "TP210", "stops": "Nonstop", "departs": "22:55", "price": 590 },
          { "airline": "TAP", "code": "TP202", "stops": "Nonstop", "departs": "18:30", "price": 640 },
          { "airline": "United", "code": "UA64", "stops": "Nonstop", "departs": "20:15", "price": 710 }
        ]
      }
    }
  }
]
