        { "id": "root", "component": "Column", "children": ["title", "summary", "board"] },
        { "id": "title", "component": "Text", "variant": "h2", "text": "Sprint board" },
        { "id": "summary", "component": "Text", "variant": "caption", "text": "8 tasks · 34 points · 8 points done (24%)" },

        { "id": "board", "component": "Row", "align": "start", "children": ["todo-col", "doing-col", "review-col", "done-col"] },

